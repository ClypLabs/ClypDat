<?xml version="1.0" encoding="UTF-8"?>
<!--
  ClypDat MSI product definition. Built by the release workflow
  (.github/workflows/release.yml), which passes -dClypDatVersion=<version> and
  -dClypDatSourceDir=<published win-x64-folder> to candle.exe, and separately
  runs heat.exe to harvest that same source directory into AppFiles.wxs
  (the ComponentGroup "AppFiles" referenced below) since it's hundreds of
  files (obs/libvlc runtimes) that shouldn't be hand-maintained here.

  UpgradeCode is fixed forever - never change it across releases, or
  upgrades will install side-by-side instead of replacing the old version.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*"
           Name="ClypDat"
           Language="1033"
           Version="$(var.ClypDatVersion)"
           Manufacturer="Stormanzanii"
           UpgradeCode="6F6E2261-C978-4F49-AF7A-ACD933CF33FD">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of ClypDat is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ClypDatIcon.ico" SourceFile="..\assets\clypdat-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ClypDatIcon.ico" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <UIRef Id="WixUI_InstallDir" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="ClypDat" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ClypDat" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="ClypDat"
                  Target="[INSTALLFOLDER]ClypDat.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall ClypDat"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ClypDat" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="ClypDat"
                  Target="[INSTALLFOLDER]ClypDat.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ClypDat" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainApplication" Title="ClypDat" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
