<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">
  <Styles.Resources>
    <!--
      Style Selector="ScrollBar" with a Template setter kept losing to
      FluentTheme's own ScrollBar ControlTheme (which the ScrollViewer's
      internal ScrollBar picks up via its Theme, not via type-selector
      matching, so a plain Style never actually won). Registering our own
      ControlTheme under the SAME implicit key FluentTheme uses
      ({x:Type ScrollBar}) replaces it outright instead of trying to out-
      specificity it - this is the supported way to fully re-skin a Fluent
      control. No track box, no up/down buttons - just the draggable thumb.
    -->
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="MinHeight" Value="10" />
      <Setter Property="Template">
        <ControlTemplate>
          <Track Name="PART_Track"
                 Minimum="{TemplateBinding Minimum}"
                 Maximum="{TemplateBinding Maximum}"
                 Value="{TemplateBinding Value, Mode=TwoWay}"
                 ViewportSize="{TemplateBinding ViewportSize}"
                 Orientation="{TemplateBinding Orientation}"
                 IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Name="thumb" Classes="scrollThumb" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:vertical">
        <Setter Property="Width" Value="10" />
      </Style>
      <Style Selector="^:horizontal">
        <Setter Property="Height" Value="10" />
      </Style>
    </ControlTheme>
  </Styles.Resources>
  <!--
    Shared control styles for the whole app. These must live at Application
    level (referenced from App.axaml), not inside MainWindow.axaml's own
    Window.Styles - a Window's local Styles only apply within that window's
    own visual tree, not to separately-created dialog Windows (the update
    dialog and the CS2 capture notice dialog were both silently falling
    back to bare FluentTheme defaults because of this before this file
    existed, which is why they looked visually inconsistent with the rest
    of the app.
  -->
  <!--
    Thumb's own default Fluent template ignores plain Background/CornerRadius
    Setters on the instance (its internal Border binds fixed theme resources,
    not TemplateBinding), which is why the corner radius and color kept
    getting lost - overriding Thumb's Template directly, scoped to this class
    only, is the only way to actually control its appearance. Color matches
    ClypDat's own dark background family rather than standing out - it's meant to
    be a subtle scroll indicator, not a UI accent.
  -->
  <Style Selector="ScrollViewer.settingsScroll ScrollBar:vertical">
    <Setter Property="Margin" Value="0,6,5,6" />
  </Style>
  <!--
    Bordered pane + internal scroll for settings lists that can grow large
    (detected games, excluded games, excluded apps) - keeps the page itself
    from turning into one giant scroll once there are 30+ rows.
  -->
  <Style Selector="Border.listPane">
    <Setter Property="Background" Value="#10171D" />
    <Setter Property="BorderBrush" Value="#232F3A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ScrollViewer.listScroll">
    <Setter Property="MaxHeight" Value="288" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="ScrollViewer.listScrollCompact">
    <Setter Property="MaxHeight" Value="216" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="ScrollViewer.listScroll ScrollBar:vertical, ScrollViewer.listScrollCompact ScrollBar:vertical">
    <Setter Property="Margin" Value="0,4,3,4" />
  </Style>
  <Style Selector="Thumb.scrollThumb">
    <Setter Property="Background" Value="#1E2A35" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="5" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Thumb.scrollThumb:pointerover">
    <Setter Property="Background" Value="#283744" />
  </Style>
  <Style Selector="Thumb.scrollThumb:pressed">
    <Setter Property="Background" Value="#324255" />
  </Style>

  <!-- Volume mute toggle (per-track lanes AND the master volume controls) -
       a plain Border (not Button) so it never inherits Fluent's press-scale
       animation, which made it visibly shrink/jump on click. Always shows a
       visible background box (not just on hover) so it reads as a clickable
       button on sight - a plain icon with no box, only reacting on hover,
       gave no visual hint it was interactive at all. Square (CornerRadius 6),
       same background/shape language as Button.transportButton/.playButton
       right next to it in both playbars, not a circle - reads as part of the
       same button row instead of a mismatched shape. -->
  <Style Selector="Border.muteToggle">
    <Setter Property="Background" Value="#24313C" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.muteToggle:pointerover">
    <Setter Property="Background" Value="#2E3F4E" />
  </Style>

  <Style Selector="Button.deleteButton">
    <Setter Property="Background" Value="#D85E61" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="20,4" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Segmented "choose a size" row on the Share dialog - a RadioButton for
       the exclusive-choice behaviour, retemplated to a filled pill instead
       of a dot-and-label so a row of them reads as one connected control. -->
  <Style Selector="RadioButton.sizePill">
    <Setter Property="Background" Value="#1D2A36" />
    <Setter Property="Foreground" Value="#93A6B8" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="11,10" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                             Foreground="{TemplateBinding Foreground}"
                             FontWeight="{TemplateBinding FontWeight}"
                             FontSize="{TemplateBinding FontSize}"
                             Padding="{TemplateBinding Padding}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.sizePill:checked">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="RadioButton.sizePill:pointerover:not(:checked)">
    <Setter Property="Background" Value="#26333F" />
  </Style>
  <Style Selector="Button:not(ToggleSwitch)">
    <Setter Property="Background" Value="#1D2A36" />
    <Setter Property="Foreground" Value="#D8E4F2" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <!-- Fluent paints pointer states inside its own square template. Keep every
         ordinary button's surface in this border so hover/pressed colours obey
         the button's CornerRadius as well. More-specific button templates below
         still override this where a control needs custom chrome. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:not(ToggleSwitch):pointerover">
    <Setter Property="Background" Value="#263544" />
  </Style>
  <Style Selector="Button:not(ToggleSwitch):disabled">
    <Setter Property="Opacity" Value="0.48" />
  </Style>
  <Style Selector="Button.transportButton">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="#24313C" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <Style Selector="Button.playButton">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="#2B3642" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!--
    Same root cause (and same fix) as ExportButton further down: Fluent's own
    Button ControlTemplate paints its pointerover state from a theme resource
    rather than from Background via TemplateBinding. Over the video these
    buttons lost their fill the moment the pointer touched them, leaving bare
    icons floating on the picture - the hover bar's "buttons go transparent
    and become hard to see on hover". A minimal template puts Background back
    in charge so the pointerover/pressed setters below actually land.
  -->
  <Style Selector="Button.transportButton, Button.playButton">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.transportButton:pointerover">
    <Setter Property="Background" Value="#334554" />
  </Style>
  <Style Selector="Button.transportButton:pressed">
    <Setter Property="Background" Value="#3E5265" />
  </Style>
  <Style Selector="Button.playButton:pointerover">
    <Setter Property="Background" Value="#3A4857" />
  </Style>
  <Style Selector="Button.playButton:pressed">
    <Setter Property="Background" Value="#45566A" />
  </Style>
  <!--
    Floating hover bar only (.flatControl is applied in code, see
    BuildPlaybackBarLayout) - the docked playbar and the fullscreen bar keep
    the filled-box look above. Over the picture those boxes read as a row of
    grey tiles; bare icons on the scrim read as controls on the video, which
    is what every player does here. Hover/press are a translucent white wash
    rather than a solid fill so the button still visibly responds without
    reintroducing the tile.
  -->
  <Style Selector="Button.transportButton.flatControl, Button.playButton.flatControl">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!--
    Play matches the other transport buttons here rather than being the larger
    tile it is in the docked/fullscreen bars. Without a filled box behind it
    the size difference no longer reads as emphasis, it just sets the bar's
    minimum height - and it was the only thing keeping the bar tall.
  -->
  <Style Selector="Button.playButton.flatControl">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
  </Style>
  <Style Selector="Button.transportButton.flatControl:pointerover, Button.playButton.flatControl:pointerover">
    <Setter Property="Background" Value="#26FFFFFF" />
  </Style>
  <Style Selector="Button.transportButton.flatControl:pressed, Button.playButton.flatControl:pressed">
    <Setter Property="Background" Value="#3DFFFFFF" />
  </Style>
  <Style Selector="Border.muteToggle.flatControl">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.muteToggle.flatControl:pointerover">
    <Setter Property="Background" Value="#26FFFFFF" />
  </Style>
  <Style Selector="Button.primaryButton">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!--
    Selector="Button.primaryButton:pointerover" alone kept losing to the
    generic "Button:not(ToggleSwitch):pointerover" rule above it (every
    primaryButton - Export, Import Selected, Check Now, etc. - showed that
    grey hover instead of the accent color). Matching the same :not(ToggleSwitch)
    shape as the generic rule (plus the extra class) makes this an
    unambiguous superset that reliably wins.
  -->
  <Style Selector="Button.primaryButton:not(ToggleSwitch):pointerover">
    <Setter Property="Background" Value="{StaticResource AccentBrushHover}" />
  </Style>

  <!--
    dangerButton is primaryButton in red, and deliberately does NOT override the
    control Template the way deleteButton does. Anything sharing a row with a
    primaryButton has to be geometrically identical to it, and a hand-rolled
    template is not: deleteButton's own Border/ContentPresenter measured a few
    pixels narrower than Fluent's, so the editor's Delete sat visibly inset next
    to Export. Same template, same metrics, only the colours differ.
    deleteButton stays as it is for the places already using it.
  -->
  <Style Selector="Button.dangerButton">
    <Setter Property="Background" Value="#D85E61" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <!-- Same :not(ToggleSwitch) shape as primaryButton's hover, for the same
       specificity reason documented directly above it. -->
  <Style Selector="Button.dangerButton:not(ToggleSwitch):pointerover">
    <Setter Property="Background" Value="#C64B50" />
  </Style>
  <Style Selector="Button.dangerButton:not(ToggleSwitch):pressed">
    <Setter Property="Background" Value="#AB3D43" />
  </Style>
  <!--
    Both rules above still lost for Export specifically. Root cause: Fluent's
    own Button ControlTemplate has its OWN internal pointerover visual state
    painting a template part from a theme resource, not from the Button's
    Background property via TemplateBinding - no external Style setting
    Background, at ANY specificity, can out-compete a template painting
    something that was never wired to Background in the first place. Giving
    the button its own minimal template (Border+ContentPresenter, Background
    via TemplateBinding) removes Fluent's template from the equation
    entirely, so the plain :pointerover Background setter below actually has
    something to reach. Same fix applied to Check Now and Update Now, which
    hit the identical issue.
  -->
  <Style Selector="Button#ExportButton, Button#CheckNowButton, Button#UpdateNowButton">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                             Padding="{TemplateBinding Padding}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{TemplateBinding FontSize}"
                             FontWeight="{TemplateBinding FontWeight}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button#ExportButton:pointerover, Button#CheckNowButton:pointerover, Button#UpdateNowButton:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentBrushHover}" />
  </Style>
  <Style Selector="Button.deleteButton:pointerover">
    <Setter Property="Background" Value="#C64B50" />
  </Style>
  <Style Selector="Button.deleteButton:pressed">
    <Setter Property="Background" Value="#AB3D43" />
  </Style>
  <!--
    linkButton/brandButton/gameFilterBadge all used Padding="0" +
    Background="Transparent" on :pointerover, meaning "no visible hover pill
    at all" was the intent - but Fluent's own Button ControlTemplate paints
    its OWN internal pointerover highlight from a theme resource, never wired
    to the Button's Background property (same root cause already diagnosed
    and fixed for Export/Check Now/Update Now above), so a small, badly-sized
    highlight showed regardless of what these styles set. Giving each its own
    minimal Border+ContentPresenter template removes Fluent's template from
    the equation, so a real, content-sized hover pill can be painted instead.
  -->
  <Style Selector="Button.linkButton">
    <!-- Not Colors.Transparent (#00FFFFFF - white at zero alpha) - a
         BrushTransition from that to an opaque dark color interpolates the
         RGB channels through white along the way, which reads as a visible
         white flash on hover-enter/exit. Same RGB as the hover color below,
         just zero alpha, so only alpha animates. -->
    <Setter Property="Background" Value="#001D2A36" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="#BDD4EE" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                             Padding="{TemplateBinding Padding}"
                             Foreground="{TemplateBinding Foreground}"
                             FontSize="{TemplateBinding FontSize}"
                             FontWeight="{TemplateBinding FontWeight}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.linkButton:pointerover">
    <Setter Property="Background" Value="#1D2A36" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.linkButton:pointerover PathIcon">
    <Setter Property="Foreground" Value="#D2DEEC" />
  </Style>
  <Style Selector="Button.brandButton">
    <Setter Property="Background" Value="#001D2A36" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                             Padding="{TemplateBinding Padding}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.brandButton:pointerover">
    <Setter Property="Background" Value="#1D2A36" />
  </Style>
  <Style Selector="Button.gameFilterBadge">
    <Setter Property="Background" Value="#001D2A36" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                             Padding="{TemplateBinding Padding}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.gameFilterBadge:pointerover">
    <Setter Property="Background" Value="#1D2A36" />
  </Style>
  <Style Selector="Button.gameFilterBadge:pointerover TextBlock">
    <Setter Property="Foreground" Value="#D2DEEC" />
  </Style>
  <Style Selector="Button.gameFilterBadge:pointerover PathIcon">
    <Setter Property="Foreground" Value="#D2DEEC" />
  </Style>
  <!-- Per-card date-header "select whole day" checkbox - hidden (zero width,
       transparent, non-hit-testable) until hovering the date row itself,
       then slides open. The date TextBlock is a later sibling in the same
       horizontal StackPanel, so it gets pushed right by ordinary layout
       flow as the checkbox's Width transitions from 0 - no RenderTransform
       needed. First position-animated hover effect in this codebase (every
       other Transitions usage here only animates Background color). -->
  <Style Selector="CheckBox.dayCheck">
    <!-- Collapsed default state lives here as Style setters, not as local
         XAML attributes on the element - a local attribute value always
         wins over a Style setter for the same property regardless of
         selector specificity, which would permanently block the
         :pointerover rule below from ever taking effect. -->
    <Setter Property="Width" Value="0" />
    <Setter Property="Opacity" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.15" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.clipDateRow:pointerover CheckBox.dayCheck">
    <!-- Wider than the checkbox glyph itself looks like it needs - Fluent's
         default CheckBox template reserves its own internal padding/margin
         around the glyph regardless of Width, so a tight Width here clips
         the checkbox against the text sitting right next to it. -->
    <Setter Property="Width" Value="26" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <!-- Stays revealed once checked, independent of hover - unchecking it
       (still requires hovering back over the row first, since it's hidden
       again once unchecked and the mouse has moved away) reverts to the
       hover-only reveal above. -->
  <Style Selector="CheckBox.dayCheck:checked">
    <Setter Property="Width" Value="26" />
    <Setter Property="Opacity" Value="1" />
    <Setter Property="IsHitTestVisible" Value="True" />
  </Style>
  <Style Selector="Button.autoClipGroupToggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.autoClipGroupToggle:pointerover Border">
    <Setter Property="BorderBrush" Value="#A9C9E5" />
  </Style>
  <Style Selector="MenuFlyoutPresenter">
    <!-- Fluent places its rows through this resource, not the presenter's
         Padding property. Removing its 4px vertical margin makes first and
         last hover states meet the rounded menu boundary. -->
    <Style.Resources>
      <Thickness x:Key="MenuFlyoutScrollerMargin">0</Thickness>
    </Style.Resources>
    <Setter Property="Background" Value="#141D24" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="MinWidth" Value="180" />
  </Style>
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="#141D24" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="MinWidth" Value="160" />
  </Style>
  <Style Selector="ContextMenu.clipContextMenu">
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <!-- Small-caps field labels inside the Replay Buffer flyout - reads as a
       settings panel rather than a stack of sentence-case captions. -->
  <Style Selector="TextBlock.flyoutLabel">
    <Setter Property="Foreground" Value="#7C8EA3" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
  </Style>

  <!-- Tooltips had no styling at all, so they rendered in Fluent's default
       chrome - pale, square-cornered and a size larger than anything around
       them, which read as borrowed from another app. Same surface/border/
       radius as the menus and flyouts below, just tighter and lighter since
       a tooltip is a passing label rather than a panel. -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#141D24" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="#D2DEEC" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="10,6" />
    <!-- Fluent's default is wide enough to leave short labels adrift in
         empty space; the rail's tooltips are mostly one or two words. -->
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <!-- Plain Flyout (not MenuFlyout) uses its own FlyoutPresenter and falls
       back to Fluent's default light-themed chrome unless styled to match -
       used by the Game Filters / Clip Type Filters checklist dropdowns. -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="#141D24" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinWidth" Value="160" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#B8C7D8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="11,7" />
  </Style>
  <Style Selector="MenuItem:pointerover">
    <Setter Property="Background" Value="#263544" />
    <Setter Property="Foreground" Value="#D8E4F2" />
  </Style>
  <Style Selector="Button.clipShareIconButton">
    <Setter Property="Background" Value="#2A3844" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- CornerRadius is repeated here deliberately. Setting Background straight
       onto the ContentPresenter overrides the themed hover setter, and the
       theme's rounding rides on that same setter rather than on a template
       binding - without this the button squared off the moment it was hovered
       while its resting state stayed rounded. -->
  <Style Selector="Button.clipShareIconButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#31485B" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#263544" />
  </Style>
  <!-- Change Game opens a separately hosted Flyout, which takes pointer
       capture from its trigger row. Keep the trigger's hover treatment while
       that child menu is open, matching a normal nested MenuItem. -->
  <Style Selector="MenuItem.changeGameMenuItem.changeGameMenuItemOpen">
    <Setter Property="Background" Value="#263544" />
    <Setter Property="Foreground" Value="#D8E4F2" />
  </Style>
  <Style Selector="MenuItem.changeGameMenuItem.changeGameMenuItemOpen /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="#263544" />
  </Style>
  <Style Selector="Button.replayButton">
    <Setter Property="Background" Value="#1D2A36" />
    <Setter Property="Foreground" Value="#9FB0C3" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.replayButton.recording">
    <Setter Property="Background" Value="#3A1E24" />
    <Setter Property="Foreground" Value="#FF8A8F" />
    <Setter Property="BorderBrush" Value="#D85E61" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.replayButton.recording:pointerover">
    <Setter Property="Background" Value="#472228" />
  </Style>
  <Style Selector="Button.dialogClose">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0,11,0,0" />
    <Setter Property="Foreground" Value="#8EA1B6" />
  </Style>
  <Style Selector="Button.dialogClose:pointerover">
    <Setter Property="Background" Value="#263544" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <!-- Compact controls are scoped to the Replay Buffer flyout. -->
  <Style Selector="StackPanel.replayFlyout TextBlock.flyoutLabel">
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="StackPanel.replayFlyout ComboBox.settingsInput">
    <Setter Property="MinHeight" Value="35" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="StackPanel.replayFlyout TextBox.settingsInput">
    <Setter Property="MinHeight" Value="35" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.replayFlyoutInput">
    <Setter Property="MinHeight" Value="35" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <!-- Small setting groups used by first-run setup. The low-contrast card
       separates choices without turning the walkthrough into a settings page. -->
  <Style Selector="Border.onboardingSettingCard">
    <Setter Property="Background" Value="#15212B" />
    <Setter Property="BorderBrush" Value="#2B4050" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="15" />
  </Style>
  <!-- Custom title-bar min/maximize/close buttons - replace Windows' own
       caption buttons (WindowDecorations="None" on
       MainWindow removes those), matching Fluent's ~46x32 caption button
       proportions. -->
  <!-- Floating "back to top" button over the Library grid - a rounded
       square matching the settingsCard/settingsInput corner language used
       everywhere else in the app, not a plain circle. -->
  <Style Selector="Button.scrollToTopButton">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="#EE141D24" />
    <Setter Property="BorderBrush" Value="#232F3A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- Fluent's default Button template owns pointerover/content-alignment
         behavior through its own internal template parts, which ignore
         plain instance Background/alignment setters no matter the selector
         specificity - same root cause already worked around for
         railIconButton/railGameButton. A flat custom template here means
         OUR Background/CornerRadius/content-alignment setters are what
         actually render, full stop. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.scrollToTopButton:not(ToggleSwitch):pointerover">
    <Setter Property="Background" Value="#EE1B2733" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Button.windowChromeButton">
    <!-- Zero-alpha hover color rather than Transparent, so the transition
         doesn't interpolate through white on unhover (see settingsNavButton).
         The close button overrides this with its own red-tinted idle below,
         since it transitions to red instead. -->
    <Setter Property="Background" Value="#001D2A36" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="46" />
    <!-- Stretch, not a fixed Height - the header bar is a fixed 48px row
         (RootLayout's RowDefinitions) taller than this button's own content,
         so a fixed height here just centered a smaller hover box inside it,
         leaving a visible gap above and below instead of the hover filling
         the whole bar edge-to-edge like real window chrome buttons do. -->
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <!-- Extends the hit-box 1px past the header row's own bounds, top and
         bottom, so hover reaches all the way to the window's outer edge with
         nothing left uncovered. -->
    <Setter Property="Margin" Value="0,-1,0,-1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <!-- Fluent's default Button template paints its own pointerover state on
         an internal template part from a theme resource, ignoring a plain
         instance Background setter no matter the selector specificity - same
         root cause worked around elsewhere in this file (scrollToTopButton
         directly above, railIconButton, etc). Without this override the
         Background/Transitions setters here are silently inert: hovering
         never shows red at all, and unhovering shows a red flash as Fluent's
         own pointerover state deactivates mid this button's own Background
         transition. A flat template makes OUR Background the only thing that
         actually renders. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.windowChromeButton PathIcon">
    <Setter Property="Foreground" Value="#8EA1B6" />
  </Style>
  <Style Selector="Button.windowChromeButton:pointerover">
    <Setter Property="Background" Value="#1D2A36" />
  </Style>
  <Style Selector="Button.windowChromeButton:pointerover PathIcon">
    <Setter Property="Foreground" Value="#F5F9FF" />
  </Style>
  <!-- Idle has to be the zero-alpha form of THIS button's own hover color,
       not the shared one - fading out to a transparent blue-grey would drift
       through grey on the way back from red. -->
  <Style Selector="Button.windowCloseButton">
    <Setter Property="Background" Value="#00E5484D" />
  </Style>
  <Style Selector="Button.windowCloseButton:pointerover">
    <Setter Property="Background" Value="#E5484D" />
  </Style>
  <Style Selector="Button.windowCloseButton:pointerover PathIcon">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <!--
    Clear ("X") button living inside a search box's InnerRightContent. Flat
    and unpainted so it reads as part of the field rather than a control
    sitting on top of one - Fluent's default Button chrome inside a TextBox
    looks like a second, nested input.
  -->
  <!-- Fixed square bounds rather than vertical padding: the hover fill is
       painted by the ContentPresenter, which stretches to the TextBox's whole
       inner height, so "Padding 8,0" left it a tall full-height slab that read
       as a rectangle behind the X no matter what corner radius it was given.
       24x24 with a matching 12 radius makes it a neat circle around the glyph. -->
  <Style Selector="Button.searchClear">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.searchClear /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.searchClear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A3B49" />
  </Style>

  <Style Selector="ComboBox.settingsInput, TextBox.settingsInput">
    <Setter Property="Background" Value="#1D2A36" />
    <Setter Property="Foreground" Value="#D8E4F2" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <!-- The app's search boxes borrow settingsInput's behaviour but not its
       proportions. A settings field is a 42px form control on a page of form
       controls; the same thing used as a search box reads as a form pasted over
       whatever it sits in - it nearly filled the library's 52px toolbar, and
       loomed over the settings nav list it heads. Shorter, pill-shaped, and
       filled a shade off its container rather than a shade off the page. -->
  <!-- Warning triangle for the amber caution notes. The exclamation is a
       subpath of the same geometry, so the default even-odd fill punches it
       out as a hole rather than needing a second element. -->
  <Style Selector="PathIcon.cautionIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Foreground" Value="#E5A00D" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,1,0,0" />
    <Setter Property="Data" Value="M12 2 L23 21 H1 Z M11 9 h2 v6 h-2 z M11 17 h2 v2 h-2 z" />
  </Style>

  <Style Selector="TextBox.appSearchBox">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Background" Value="#141D25" />
    <Setter Property="BorderBrush" Value="#243240" />
  </Style>
  <Style Selector="TextBox.appSearchBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#18232D" />
    <Setter Property="BorderBrush" Value="#2E4052" />
  </Style>
  <Style Selector="TextBox.appSearchBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#18232D" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <!--
    Fluent's own TextBox theme repaints Border#PART_BorderElement's
    Background/BorderBrush/BorderThickness on :pointerover and :focus from
    its own DynamicResources (an opaque near-black fill and a bright accent-
    blue ring) - those nested style setters target the template part
    directly, so they beat a plain instance-level Background/BorderBrush
    value the same way the Button styles above have to work around Fluent's
    template. Targeting the template part explicitly for every state here
    is what actually keeps the inline clip-title editor's own dark, muted
    look instead of flashing to Fluent's default look on hover/focus.
  -->
  <Style Selector="TextBox.inlineTitleEdit /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#0D151C" />
    <Setter Property="BorderBrush" Value="#22303A" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.inlineTitleEdit:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#0D151C" />
    <Setter Property="BorderBrush" Value="#324454" />
  </Style>
  <Style Selector="TextBox.inlineTitleEdit:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#0D151C" />
    <Setter Property="BorderBrush" Value="#4C6478" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <!--
    Same Fluent problem as inlineTitleEdit above, and for the same reason: the
    settingsInput setters are instance-level, so Fluent's own theme repaints
    PART_BorderElement on :pointerover and :focus with an opaque near-black
    fill and a bright accent-blue ring. That flash is what made these fields
    read as heavy and out of place against the muted settings cards - they
    only looked right while idle. Pinning the template part for every state
    keeps them on the card's palette throughout, with the focus ring following
    the OS accent colour like the rest of the app.
  -->
  <Style Selector="TextBox.settingsInput /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#1D2A36" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.settingsInput:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#22303D" />
    <Setter Property="BorderBrush" Value="#3A4C5C" />
  </Style>
  <Style Selector="TextBox.settingsInput:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#22303D" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.settingsInput /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="#5C6D7E" />
  </Style>

  <!-- A short numeric field sitting at the right-hand end of a settings row,
       where the full-size settingsInput reads as an input bar rather than a
       value. Centred because these hold two or three digits. -->
  <Style Selector="TextBox.settingsInput.compactNumber">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox.inlineTitleEdit /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="#5C6D7E" />
  </Style>
  <Style Selector="TextBox.inlineTitleEdit:focus /template/ TextBlock#PART_Watermark, TextBox.inlineTitleEdit:pointerover /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="#5C6D7E" />
  </Style>
  <!-- Replaces the old pencil-icon affordance - hovering the clip title
       itself now signals it's clickable to rename. -->
  <Style Selector="TextBlock.editableTitle:pointerover">
    <Setter Property="TextDecorations" Value="Underline" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Border.settingsCard">
    <Setter Property="Background" Value="#141D24" />
    <Setter Property="BorderBrush" Value="#232F3A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="ComboBox.settingsInput /template/ Border#PopupBorder">
    <Setter Property="Background" Value="#141D24" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ComboBox.settingsInput ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#B8C7D8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="ComboBox.settingsInput ComboBoxItem:pointerover">
    <Setter Property="Background" Value="#263544" />
    <Setter Property="Foreground" Value="#D8E4F2" />
  </Style>
  <Style Selector="ComboBox.settingsInput ComboBoxItem:selected">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="ListBox.pillGroup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.pillGroup ListBoxItem">
    <Setter Property="Background" Value="#1D2A36" />
    <Setter Property="Foreground" Value="#B8C7D8" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.pillGroup ListBoxItem:pointerover">
    <Setter Property="Background" Value="#263544" />
  </Style>
  <Style Selector="ListBox.pillGroup ListBoxItem:selected">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="ListBox.pillGroup ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentBrushHover}" />
  </Style>
  <Style Selector="ListBox.qualityPresetCards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <WrapPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.qualityPresetCards ListBoxItem">
    <Setter Property="Width" Value="250" />
    <Setter Property="MinHeight" Value="88" />
    <Setter Property="Margin" Value="0,0,10,8" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Background" Value="#141D24" />
    <Setter Property="Foreground" Value="#D2DEEC" />
    <Setter Property="BorderBrush" Value="#2C3B48" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="ListBox.qualityPresetCards ListBoxItem:pointerover">
    <Setter Property="Background" Value="#22303D" />
  </Style>
  <Style Selector="ListBox.qualityPresetCards ListBoxItem:selected">
    <Setter Property="Background" Value="#303840" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="ListBox.qualityPresetCards ListBoxItem:selected:pointerover">
    <Setter Property="Background" Value="#39434C" />
  </Style>
  <Style Selector="ListBox.qualityPresetCards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#303840" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="ListBox.qualityPresetCards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#39434C" />
  </Style>
  <Style Selector="Button.autoClipCardHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.autoClipCardHeader:pointerover">
    <Setter Property="Background" Value="#182029" />
  </Style>
  <!-- "All Kills" sub-header - previously fully transparent at rest (only
       colored on hover, same as the outer CS2 card header), which read as
       plain floating text rather than an actual control. Gets its own
       resting background so it looks like a distinct nested row. Combined
       class selector (not a separate Button.allKillsHeader rule) so it
       reliably wins over the plain autoClipCardHeader rule above for the
       same Background property. -->
  <Style Selector="Button.autoClipCardHeader.allKillsHeader">
    <Setter Property="Background" Value="#161F28" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Button.autoClipCardHeader.allKillsHeader:pointerover">
    <Setter Property="Background" Value="#1C2733" />
  </Style>
  <Style Selector="Button.settingsNavButton">
    <!-- Not Transparent (#00FFFFFF - white at zero alpha): the BrushTransition
         below interpolates RGB as well as alpha, so unhovering flashed white
         on the way back out. Zero-alpha version of the hover color, so only
         alpha animates. Same fix as linkButton above. -->
    <Setter Property="Background" Value="#00182029" />
    <Setter Property="Foreground" Value="#93A6B8" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0,7,7,0" />
    <Setter Property="Padding" Value="20,9,12,9" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.settingsNavButton TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.settingsNavButton:pointerover">
    <Setter Property="Background" Value="#182029" />
    <Setter Property="Foreground" Value="#D8E4F2" />
  </Style>
  <Style Selector="Button.settingsNavButton.active">
    <Setter Property="Background" Value="#1B2A3D" />
    <Setter Property="Foreground" Value="#EDF4FB" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.settingsNavButton.active:pointerover">
    <Setter Property="Background" Value="#1B2A3D" />
  </Style>
  <!-- Library sidebar's persistent icon rail (Sections/Games/bottom
       shortcuts). Hover/active read as a circular backdrop behind the icon
       (common dock/rail convention) rather than a squared-off tinted row,
       since the rail is icon-only and narrow - the button is square so
       CornerRadius at half its side renders a true circle.

       Left-aligned with an explicit 9px margin rather than centered: the
       rail is 64 wide and the button 44, so dead-center would be 10 - 9
       shifts the whole control (hover circle AND the icon inside it) 1px
       left as one unit. Nudging the icon's own Margin instead left it
       off-center inside its own hover circle. -->
  <Style Selector="Button.railIconButton">
    <!-- Zero-alpha hover color rather than Transparent, so the transition
         doesn't interpolate through white on unhover (see settingsNavButton). -->
    <Setter Property="Background" Value="#0026323D" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="9,0,0,4" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <!-- Fluent's internal pointer-over surface ignores Button.Background and
         can flash a bright theme color as hover ends. This direct template
         keeps every rail tile on its own animated Background value. -->
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.13" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>
  <!-- Game rows hold square artwork, so their hover/active backdrop is a
       rounded square too - a circular one around a square icon reads as a
       mismatch. Section rows keep the circle, which suits their glyphs. -->
  <Style Selector="Button.railGameButton">
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <!-- Wraps a folder's header tile AND its revealed member tiles as one
       visually connected group once expanded - collapsed, it's invisible
       (transparent border/fill), so it looks like it costs nothing when the
       folder is shut. Geometry (CornerRadius/Padding/BorderThickness) is
       identical collapsed or expanded, ONLY the colour toggles - the header
       tile's own on-screen position must never depend on IsExpanded, or
       clicking to open a folder visibly shoves its icon sideways as the
       border's inset suddenly appears around it. Left side has no border/
       padding at all (flush with loose rail icons, which sit at the same
       x as everything here via their own Margin) - the capsule opens only
       to the right, top, and bottom, bracket-style. -->
  <Style Selector="Border.railFolderGroup">
    <Setter Property="CornerRadius" Value="0,16,16,0" />
    <Setter Property="Padding" Value="0,6,4,6" />
    <Setter Property="BorderThickness" Value="0,1.5,1.5,1.5" />
    <!-- Not Colors.Transparent (#00FFFFFF - white at zero alpha): the
         BrushTransition below then interpolates through visible white when
         the folder opens instead of just fading the accent/dark fill in
         (see windowChromeButton for the same fix). Not a perfect colour
         match for AccentBrush (unknown until the user's Windows accent is
         read), but a dark zero-alpha neutral is far closer than white. -->
    <Setter Property="BorderBrush" Value="#00141D24" />
    <Setter Property="Background" Value="#00141D24" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.railFolderGroup.expanded">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="#141D24" />
  </Style>
  <!-- The storage button is the one rail button that isn't a bare 30px glyph:
       it holds the ring AND the used/limit caption, so it drops the fixed
       44px square for an auto height (still 44 wide, so it stays aligned with
       the rail) and a softer radius than the circle the others use. -->
  <Style Selector="Button.storageRailButton">
    <Setter Property="Height" Value="NaN" />
    <!-- Wider than the other rail buttons (and pulled left to stay centred in
         the 64px rail): those hold a 30px glyph, this holds two lines of text
         under the ring, and at 44px figures like "of 1000 GB" ran to the very
         edge of the button. -->
    <Setter Property="Width" Value="58" />
    <Setter Property="Margin" Value="3,0,0,4" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="0,7,0,6" />
  </Style>

  <Style Selector="Button.railIconButton PathIcon">
    <Setter Property="Foreground" Value="#8C98A7" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>
  <!-- :not(ToggleSwitch) is load-bearing, not decoration - a plain
       "Button.railIconButton:pointerover" reliably LOST to the generic
       "Button:not(ToggleSwitch):pointerover" rule above (same bug already
       hit and documented for Button.primaryButton:pointerover): a class
       selector doesn't automatically outrank a same-position :not() pseudo-
       class in Avalonia's specificity scoring the way it would in CSS.
       Matching that rule's shape as a strict superset (this class AND that
       negation) is what actually wins. Without this the rail just showed the
       generic grey #263544 hover on every game/section icon, which read as
       "still grey" no matter how the accent blend below was tuned. -->
  <Style Selector="Button.railIconButton:not(ToggleSwitch):pointerover">
    <!-- Accent-tinted, not a grey wash: hovering used to just lighten the
         rail, which read as the button greying out rather than responding.
         This is the same accent the selection tints use (so it follows the
         Windows colour), mixed much further down into the rail so hover and
         selected stay clearly different. -->
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.railIconButton:pointerover PathIcon">
    <Setter Property="Foreground" Value="#D8E4F2" />
  </Style>
  <!-- Folder tiles retain their brighter idle tint, distinct from loose
       game icons and from the darker hover highlight. -->
  <Style Selector="Button.railFolderHeader">
    <Setter Property="Background" Value="{StaticResource AccentFolderBrush}" />
  </Style>
  <!-- Expanded, the outline capsule (Border.railFolderGroup.expanded) already
       carries its own accent border/background around the whole group - the
       header tile's own permanent tint on top of that doubled up and looked
       muddy. Drop back to plain transparent while open. -->
  <Style Selector="Button.railFolderHeader.expanded">
    <!-- Not Colors.Transparent (#00FFFFFF - white at zero alpha) - matches
         the base railIconButton idle colour's own zero-alpha hex instead,
         same reasoning as windowChromeButton, so opening the folder doesn't
         flash white as this fades in over the permanent tint. -->
    <Setter Property="Background" Value="#0026323D" />
  </Style>
  <!-- Presses shrink slightly so a click registers physically even though
       nothing else about the button moves. -->
  <Style Selector="Button.railIconButton:pressed">
    <Setter Property="RenderTransform" Value="scale(0.92)" />
  </Style>
  <!-- Selection is accent-tinted rather than another shade of grey, so the
       current section stands out against a merely-hovered one. These follow
       the Windows accent colour (see App.axaml.cs ApplyAccentColor). -->
  <Style Selector="Button.railIconButton.active">
    <Setter Property="Background" Value="{StaticResource AccentSelectedBrush}" />
  </Style>
  <Style Selector="Button.railIconButton.active PathIcon">
    <Setter Property="Foreground" Value="{StaticResource AccentSelectedIconBrush}" />
  </Style>
  <Style Selector="Button.railIconButton.active:not(ToggleSwitch):pointerover">
    <Setter Property="Background" Value="{StaticResource AccentSelectedHoverBrush}" />
  </Style>
  <!-- Game filters and folders darken from their selected-color family when
       hovered. This comes after generic/active rail hover rules so it wins
       for both selected and unselected game tiles. -->
  <Style Selector="Button.railGameButton:not(ToggleSwitch):pointerover">
    <Setter Property="Background" Value="{StaticResource AccentGameHoverBrush}" />
  </Style>
  <Style Selector="Button.railIconButton Border.gameInitialBadge">
    <Setter Property="Background" Value="#26323D" />
  </Style>
  <Style Selector="Button.railIconButton:pointerover Border.gameInitialBadge">
    <Setter Property="Background" Value="{StaticResource AccentSelectedBrush}" />
  </Style>
  <Style Selector="Button.railIconButton.active Border.gameInitialBadge">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="Button.railGameButton:pointerover Border.gameInitialBadge">
    <Setter Property="Background" Value="{StaticResource AccentGameHoverBrush}" />
  </Style>
  <!-- Folder glyph badges never own hover feedback; the larger folder header
       handles it. Empty, collapsed folders retain their normal neutral glyph. -->
  <Style Selector="Button.railFolderHeader Border.gameInitialBadge">
    <Setter Property="Background" Value="#26323D" />
  </Style>
  <Style Selector="Button.railFolderHeader:pointerover Border.gameInitialBadge">
    <Setter Property="Background" Value="#26323D" />
  </Style>
  <!-- When open, the folder glyph replaces its closed mosaic. Its squircle
       stays bright while the larger folder header owns hover feedback. -->
  <Style Selector="Button.railFolderHeader.expanded Border.gameInitialBadge">
    <Setter Property="Background" Value="{StaticResource AccentFolderBrush}" />
  </Style>
  <Style Selector="Button.railFolderHeader.expanded:pointerover Border.gameInitialBadge">
    <Setter Property="Background" Value="{StaticResource AccentFolderBrush}" />
  </Style>
  <Style Selector="Button.railIconButton Border.gameInitialBadge TextBlock">
    <Setter Property="Foreground" Value="#B8C7D8" />
  </Style>
  <Style Selector="Button.railIconButton Border.gameInitialBadge PathIcon">
    <Setter Property="Foreground" Value="#B8C7D8" />
  </Style>

  <!-- Change Game's flyout is a plain StackPanel of these instead of
       MenuItems (see MainWindow.axaml.cs ClipContextSetGame_OnClick) - a
       real Menu's dismiss behaviour proved unreliable built ad hoc, so
       ordinary Buttons stand in, styled to read as menu rows rather than
       buttons. -->
  <Style Selector="Button.flyoutMenuItem">
    <!-- Not Colors.Transparent (#00FFFFFF - white at zero alpha): the
         generic Button style's own BrushTransition on Background then
         interpolates through visible white on hover instead of just fading
         the hover fill in (see windowChromeButton for the same fix). -->
    <Setter Property="Background" Value="#0026323D" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Foreground" Value="#D8E4F2" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.flyoutMenuItem:pointerover">
    <Setter Property="Background" Value="#26323D" />
  </Style>
  <Style Selector="Button.railIconButton.active Border.gameInitialBadge TextBlock">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.railIconButton.active Border.gameInitialBadge PathIcon">
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <!-- The editor keeps the library's 64px rail, so its footer controls use
       the same centred offset as every other rail button. -->
  <Style Selector="Button.railIconButton.editorRailFooter">
    <Setter Property="Margin" Value="9,0,0,4" />
  </Style>

  <!-- Editor rail swaps library filters for larger labelled tools. The label
       makes the mode readable at a glance while the 64px hit area stays easy
       to use on touchpads and high-DPI displays. -->
  <Style Selector="Button.editorRailButton">
    <Setter Property="Background" Value="#0026323D" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="62" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="#AAB8C8" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.13" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.editorRailButton PathIcon">
    <Setter Property="Foreground" Value="#AAB8C8" />
  </Style>
  <Style Selector="Button.editorRailButton:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.editorRailButton:pointerover PathIcon">
    <Setter Property="Foreground" Value="#EDF4FB" />
  </Style>
  <Style Selector="Button.editorRailButton.active">
    <Setter Property="Background" Value="{StaticResource AccentSelectedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource AccentSelectedIconBrush}" />
  </Style>
  <Style Selector="Button.editorRailButton.active PathIcon">
    <Setter Property="Foreground" Value="{StaticResource AccentSelectedIconBrush}" />
  </Style>
  <Style Selector="Button.editorRailButton.active:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentSelectedHoverBrush}" />
  </Style>
  <Style Selector="Button.editorToolsClose">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="#00101820" />
    <Setter Property="Foreground" Value="#B8C7D8" />
  </Style>
  <Style Selector="Button.editorToolsClose:pointerover">
    <Setter Property="Background" Value="#263C4C" />
    <Setter Property="Foreground" Value="#EDF4FB" />
  </Style>
  <!-- Shared by every volume slider - per-track lanes AND both master
       volume controls (regular editor + fullscreen) - so all three look and
       feel identical.

       Foreground/Background here aren't cosmetic no-ops - Fluent's Slider
       template binds PART_DecreaseButton (the filled/value portion of the
       rail) to the Slider's own Foreground, and PART_IncreaseButton (the
       unfilled remainder) to Background. Setting them is the supported way
       to recolor the rail without reimplementing Fluent's template.

       SliderTrackThemeHeight is the DynamicResource Fluent's rail Border
       reads its Height from - scoped to just this class via Style.Resources
       (not overridden app-wide) so the plain Sliders elsewhere keep Fluent's
       default thin rail. Bumped
       from Fluent's default (~4px) to make the whole slider a visibly larger,
       easier target to click, not just a thicker line.

       ControlCornerRadius is ALSO read by that same rail Border (Fluent's
       PART_DecreaseButton/PART_IncreaseButton each independently round
       their own segment by this amount, not one continuous track) - left at
       its app-wide default (~4px) it's nearly the ENTIRE height of our
       4.5px rail, so each segment rendered as a near-full pill and the two
       bulged into a warped/pinched shape right where they meet at the
       thumb instead of a clean straight bar. Scoped down proportionally to
       the rail height, same as the height override above. -->
  <Style Selector="Slider.volumeSlider">
    <Style.Resources>
      <sys:Double x:Key="SliderTrackThemeHeight">4.5</sys:Double>
      <CornerRadius x:Key="ControlCornerRadius">2.25</CornerRadius>
    </Style.Resources>
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Background" Value="#26313C" />
  </Style>
  <Style Selector="Slider.volumeSlider /template/ Thumb">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="#EEF4FF" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Slider.volumeSlider /template/ Thumb:pointerover">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrushHover}" />
    <Setter Property="RenderTransform" Value="scale(1.15)" />
  </Style>
  <Style Selector="Slider.volumeSlider /template/ Thumb:pressed">
    <Setter Property="Background" Value="#EAF0FF" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>

  <!-- Trim start/end handles: one thick pill running the full height of the
       video lane. Nothing inside it, nothing above it. Corner radius is
       exactly half the width, so the ends are true semicircles.

       Width must stay in step with UpdateTimelineChrome's barWidth, which is
       what centres the pill on the trim boundary. -->
  <Style Selector="Border.trimBar">
    <Setter Property="Width" Value="11" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="5.5" />
    <!-- Flat fill, a hairline of light along the edge instead of a dark
         outline, and a soft ambient shadow rather than a hard one. The
         previous top-to-bottom gradient plus near-black border was doing a
         glossy, beveled thing that reads as older than everything around it. -->
    <Setter Property="Background" Value="#1ACBB8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #59000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.trimHandle:pointerover > Border.trimBar">
    <Setter Property="Background" Value="#2EE3CE" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
  </Style>
</Styles>
