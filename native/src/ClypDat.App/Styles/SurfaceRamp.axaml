<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Generated surface ramp. Every neutral dark surface literal the app used
       to hard-code, keyed by its own System-theme hex so AppThemeService can
       recolour it without the source value ever being lost. Keeping each shade
       separate (rather than collapsing them onto the eight named tokens in
       Tokens.axaml) is what preserves the depth the UI was drawn with.

       Membership rule: a Background/BorderBrush/Fill/Stroke literal with hue in
       [180, 245], saturation <= 0.45 and lightness <= 0.55 - ClypDat's neutral
       blue-grey family. Text, accents and the semantic green/red/amber colours
       are deliberately excluded and stay fixed across themes. -->

  <!-- Brushes -->
  <SolidColorBrush x:Key="Surface_05080B" Color="#05080B" />
  <SolidColorBrush x:Key="Surface_0B0F14" Color="#0B0F14" />
  <SolidColorBrush x:Key="Surface_0C1319" Color="#0C1319" />
