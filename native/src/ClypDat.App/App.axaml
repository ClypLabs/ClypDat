<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClypDat.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ClypDat/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://ClypDat/Styles/SurfaceRamp.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Accent brushes live here rather than in Tokens.axaml only because they
           have no authored "source" value: AppThemeService derives every one of
           them from the live accent (Windows accent, or the preset's own when
           Settings > Themes has the Windows accent switched off). The values
           below are the startup fallback for the System preset. -->
      <SolidColorBrush x:Key="AccentBrush" Color="#5864E8" />
      <SolidColorBrush x:Key="AccentBrushHover" Color="#6D77F0" />
      <!-- Sidebar selection tints, derived from the accent above. -->
      <SolidColorBrush x:Key="AccentSelectedBrush" Color="#2A3350" />
      <SolidColorBrush x:Key="AccentSelectedHoverBrush" Color="#222A43" />
      <SolidColorBrush x:Key="AccentSelectedIconBrush" Color="#A8B4F5" />
      <SolidColorBrush x:Key="AccentGameHoverBrush" Color="#222A43" />
      <!-- Folder tiles use the former brighter rail tint while idle. -->
      <SolidColorBrush x:Key="AccentFolderBrush" Color="#2C3568" />
      <!-- Hovering a rail button uses a darker version of its selection tint,
           keeping selected state visually stronger than pointer-over state. -->
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#222A43" />

      <!-- FluentTheme reads its own accent from these. Overriding them here is
           what stops Fluent's stock blue showing through on the controls we have
           not re-templated (ListBoxItem selection, CheckBox ticks) when a
           non-blue theme is active. AppThemeService reassigns them on apply. -->
      <Color x:Key="SystemAccentColor">#5864E8</Color>
      <Color x:Key="SystemAccentColorLight1">#707BEB</Color>
      <Color x:Key="SystemAccentColorLight2">#8B93F0</Color>
      <Color x:Key="SystemAccentColorLight3">#A5ABF4</Color>
      <Color x:Key="SystemAccentColorDark1">#4A54BB</Color>
      <Color x:Key="SystemAccentColorDark2">#3B438F</Color>
      <Color x:Key="SystemAccentColorDark3">#2C3262</Color>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ClypDat/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
