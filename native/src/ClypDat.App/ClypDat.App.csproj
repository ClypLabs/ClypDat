<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\eng\AvaloniaPin.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ClypDat</AssemblyName>
    <RootNamespace>ClypDat.App</RootNamespace>
    <ApplicationIcon>..\..\..\assets\clypdat-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows-versioned TFM (overriding Directory.Build.props' plain net8.0, scoped
         to just this project) so Windows.Graphics.Capture's WinRT types are available
         to NativeReplayBuffer for true per-window capture, instead of DXGI Desktop
         Duplication's fixed-screen-region capture (which shows whatever's on screen
         during alt-tab, not the game specifically). -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Baked in here (not just passed as a publish flag) so every publish
         (CI's release workflow, the documented README command, or a plain
         "dotnet publish" with no extra flags for win-x64) produces the same
         self-contained output that bundles its own .NET runtime. Without
         this, a publish missing the self-contained flag silently falls back
         to framework-dependent, which then demands the user have the exact
         matching .NET 10 Desktop Runtime installed; "I already have .NET"
         doesn't mean that specific piece is present, and end users
         shouldn't need any of it either way. -->
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>1.3.2</Version>
    <ClypDatChannel Condition="'$(ClypDatChannel)' == ''">Stable</ClypDatChannel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Precompiles IL to native code for this RID at publish time so the
         published ClypDat.exe skips JIT-on-first-run for its own assemblies
         (Avalonia's XAML-heavy startup path is the main beneficiary) - only
         affects `dotnet publish` output, not the plain `dotnet build` used
         to verify compilation. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Lets SetSourceRevisionId below (which sets $(SourceRevisionId), not
         SourceLink) fold a "+<short-hash>" onto AssemblyInformationalVersion
         without touching <Version>/AssemblyVersion - the About screen reads
         the informational version to show which exact commit a locally
         published build came from; AppUpdateService's update check still
         reads the plain numeric AssemblyVersion, unaffected either way. -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <!-- Explicit, not just relying on the desktop-app default: Server GC
         allocates one heap PER CORE and favours throughput over footprint,
         which is backwards for an app whose whole complaint is memory usage.
         Concurrent (background) GC still runs alongside it so a collection
         doesn't stall the UI thread mid-frame. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ClypDatChannel)' == 'Dev'">
    <DefineConstants>$(DefineConstants);CLYPDAT_DEV</DefineConstants>
    <AssemblyName>ClypDat</AssemblyName>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <!-- The preview target is deliberately UI-only. It makes the Avalonia
       shell runnable on macOS while the capture backends remain Windows-only;
       publish.ps1 and the normal Windows build do not use this property. -->
  <PropertyGroup Condition="'$(ClypDatUiPreview)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationIcon></ApplicationIcon>
    <ApplicationManifest></ApplicationManifest>
    <SupportedOSPlatformVersion></SupportedOSPlatformVersion>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <PlatformTarget></PlatformTarget>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DefineConstants>$(DefineConstants);CLYPDAT_UI_PREVIEW</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(ClypDatUiPreview)' == 'true'">
    <Compile Remove="Services\CaptureInterop.cs" />
    <Compile Remove="Services\NativeReplayBuffer.cs" />
  </ItemGroup>

  <!-- System.GC.ConserveMemory (0-9): how hard the GC works to hand freed
       memory back to the OS rather than holding it in reserve for future
       allocations - the actual knob behind "why does Task Manager still show
       a lot of RAM after I stopped recording", since .NET's default (0)
       favours reuse and is content to let a process's working set sit high
       long after the allocations that grew it are gone. 5 is the balanced
       setting Microsoft recommends: real memory given back promptly without
       tuning for the aggressive end (9), which spends noticeably more CPU on
       compaction - not something to trade away on the same box that's also
       running NVENC and a game. See ClypDat.App.csproj's ServerGarbageCollection
       comment for the complementary half of this (don't multiply heaps by
       core count in the first place). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <!-- These packages are built from the ClypDat Avalonia fork. Keep every
         Avalonia package on the same forked version so NuGet cannot mix the
         fork with the official Avalonia packages. -->
    <PackageReference Include="Avalonia" Version="$(ClypDatAvaloniaPackageVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(ClypDatAvaloniaPackageVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(ClypDatAvaloniaPackageVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(ClypDatAvaloniaPackageVersion)" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- .Core (not the full Microsoft.Data.Sqlite) so it doesn't drag in
         SQLitePCLRaw.bundle_e_sqlite3's bundled native binary, which has an
         unpatched high-severity NuGet advisory (GHSA-2m69-gcr7-jv3q) with no
         fixed version available. winsqlite3 below points it at Windows'
         own SQLite (ships with Win10+, patched via Windows Update) instead. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="3.0.4" Condition="'$(ClypDatUiPreview)' != 'true'" />
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" Condition="'$(ClypDatUiPreview)' != 'true'" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" GeneratePathProperty="true" Condition="'$(ClypDatUiPreview)' != 'true'" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="FFmpeg.AutoGen" Version="8.1.0" />
    <!-- Pinned directly to the forked Avalonia version's required version.
         No direct usage. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClypDat.Core\ClypDat.Core.csproj" />
    <ProjectReference Include="..\ClypDat.Capture.Abstractions\ClypDat.Capture.Abstractions.csproj" />
    <Compile Include="..\ClypDat.DevChannel\DevChannelConstants.cs" Link="Services\DevChannel\DevChannelConstants.cs" />
    <Compile Include="..\ClypDat.DevChannel\DevBuildManifest.cs" Link="Services\DevChannel\DevBuildManifest.cs" />
    <Compile Include="..\ClypDat.DevChannel\DevPackageVerifier.cs" Link="Services\DevChannel\DevPackageVerifier.cs" />
    <Compile Include="..\ClypDat.DevChannel\DevInstallState.cs" Link="Services\DevChannel\DevInstallState.cs" />
    <Compile Include="..\ClypDat.DevChannel\DevChannelPaths.cs" Link="Services\DevChannel\DevChannelPaths.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\..\assets\clypdat-icon*.png" Link="Assets\%(Filename)%(Extension)" />
    <AvaloniaResource Include="..\..\..\assets\clypdat-icon.ico" Link="Assets\clypdat-icon.ico" />
    <AvaloniaResource Include="..\..\..\assets\cs2-cover.jpg" Link="Assets\cs2-cover.jpg" />
    <AvaloniaResource Include="..\..\..\assets\dota2-cover.jpg" Link="Assets\dota2-cover.jpg" />
    <AvaloniaResource Include="..\..\..\assets\league-cover.jpg" Link="Assets\league-cover.jpg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\game-catalog.json" Link="game-catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\game-icons.json" Link="game-icons.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- git rev-parse failing (no git on PATH, source distributed without
       .git) just leaves SourceRevisionId unset - InformationalVersion falls
       back to the plain "0.1.7" with no "+hash" suffix, so this degrades
       gracefully rather than breaking the build. -->
  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
      <Output TaskParameter="ExitCode" PropertyName="GitRevParseExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(GitRevParseExitCode)' == '0' And '$(GitCommitHash)' != ''">
      <SourceRevisionId>$(GitCommitHash)</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <Target Name="CopyLibVlcRuntimeToPublish" AfterTargets="Publish" Condition="'$(ClypDatUiPreview)' != 'true'">
    <ItemGroup>
      <LibVlcRuntimeFiles Include="$(PkgVideoLAN_LibVLC_Windows)\build\x64\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibVlcRuntimeFiles)"
          DestinationFiles="@(LibVlcRuntimeFiles->'$(PublishDir)libvlc\win-x64\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyFfmpegToPublish" AfterTargets="Publish" Condition="Exists('..\..\vendor\ffmpeg')">
    <ItemGroup>
      <FfmpegFiles Include="..\..\vendor\ffmpeg\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FfmpegFiles)"
          DestinationFiles="@(FfmpegFiles->'$(PublishDir)ffmpeg\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Same copy, but for a plain `dotnet build` run. Without this the build
       output has FFmpeg.AutoGen.dll (the managed binding) but none of the
       native avcodec/avformat/avutil DLLs it binds to, so
       FfmpegPathResolver finds no bundled folder, never sets
       ffmpeg.RootPath, and NativeReplayBuffer's very first
       avcodec_find_encoder_by_name throws NotSupportedException - the
       capture loop dies instantly and every clip attempt reports "Replay
       just started". Recording has to work when running a dev build, not
       only a published one. -->
  <Target Name="CopyFfmpegToOutput" AfterTargets="Build" Condition="Exists('..\..\vendor\ffmpeg')">
    <ItemGroup>
      <FfmpegOutputFiles Include="..\..\vendor\ffmpeg\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FfmpegOutputFiles)"
          DestinationFiles="@(FfmpegOutputFiles->'$(OutDir)ffmpeg\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- The RNNoise model the microphone noise suppression filter loads. It is
       a data file, not code: arnndn has no built-in model and refuses to
       create the filter without a path to one, so a build missing this folder
       simply reports noise suppression as unavailable rather than failing. -->
  <Target Name="CopyRnnoiseToPublish" AfterTargets="Publish" Condition="Exists('..\..\vendor\rnnoise')">
    <ItemGroup>
      <RnnoiseFiles Include="..\..\vendor\rnnoise\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(RnnoiseFiles)"
          DestinationFiles="@(RnnoiseFiles->'$(PublishDir)rnnoise\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyRnnoiseToOutput" AfterTargets="Build" Condition="Exists('..\..\vendor\rnnoise')">
    <ItemGroup>
      <RnnoiseOutputFiles Include="..\..\vendor\rnnoise\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(RnnoiseOutputFiles)"
          DestinationFiles="@(RnnoiseOutputFiles->'$(OutDir)rnnoise\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- LibVLC (LGPL-2.1) is bundled in every distributed
       build; their licenses require these notices/texts to ship alongside
       the binaries. See THIRD-PARTY-LICENSES.md at the repo root. -->
  <Target Name="CopyThirdPartyLicensesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ThirdPartyLicenseFiles Include="..\..\..\licenses\**\*" />
    </ItemGroup>
    <Copy SourceFiles="..\..\..\THIRD-PARTY-LICENSES.md"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ThirdPartyLicenseFiles)"
          DestinationFiles="@(ThirdPartyLicenseFiles->'$(PublishDir)licenses\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
