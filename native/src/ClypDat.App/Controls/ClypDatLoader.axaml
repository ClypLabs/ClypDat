<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClypDat.App.Controls.ClypDatLoader"
             x:CompileBindings="False"
             Foreground="#FFFFFF">
  <!-- Loading motion keeps its original counter-rotating hexagon mark. It is
       independent from normal in-app branding, which uses the transparent mark. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="304" Height="304">
      <Ellipse x:Name="Glow" Canvas.Left="22" Canvas.Top="22" Width="260" Height="260"
               Opacity="0.18">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="#40FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Panel x:Name="Ring" Canvas.Left="12" Canvas.Top="12" Width="280" Height="280">
        <Ellipse Width="280" Height="280"
                 Stroke="#000000" StrokeThickness="15"
                 StrokeDashArray="5.864,3.910" StrokeLineCap="Round"
                 Opacity="0.5" />
        <Ellipse Width="280" Height="280"
                 Stroke="{Binding $parent[UserControl].Foreground}" StrokeThickness="9"
                 StrokeDashArray="9.774,6.516" StrokeLineCap="Round"
                 Opacity="0.9" />
      </Panel>
      <Canvas x:Name="MarkOuter" Width="304" Height="304">
        <Path Data="M152,49 L242,101 V203 L152,255 L62,203 V101 Z"
              Stroke="#000000" StrokeThickness="33" StrokeJoin="Round" />
        <Path Data="M152,49 L242,101 V203 L152,255 L62,203 V101 Z"
              Stroke="{Binding $parent[UserControl].Foreground}" StrokeThickness="25" StrokeJoin="Round" />
      </Canvas>
      <Canvas x:Name="MarkInner" Width="304" Height="304">
        <Path Data="M152,102 L192,125 V179 L152,202 L112,179 V125 Z"
              Stroke="#000000" StrokeThickness="21" StrokeJoin="Round" />
        <Path Data="M152,102 L192,125 V179 L152,202 L112,179 V125 Z"
              Stroke="{Binding $parent[UserControl].Foreground}" StrokeThickness="15" StrokeJoin="Round" />
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>
