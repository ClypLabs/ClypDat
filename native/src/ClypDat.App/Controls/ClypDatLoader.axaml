<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClypDat.App.Controls.ClypDatLoader"
             x:CompileBindings="False"
             Foreground="#FFFFFF">
  <!-- Keep the selected logo still while the existing loading ring rotates.
       AppLogoLarge follows both the theme and the classic-logo preference. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="304" Height="304">
      <Ellipse x:Name="Glow" Canvas.Left="22" Canvas.Top="22" Width="260" Height="260"
               Opacity="0.18">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Offset="0" Color="#40FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Panel x:Name="Ring" Canvas.Left="12" Canvas.Top="12" Width="280" Height="280">
        <Ellipse Width="280" Height="280"
                 Stroke="#000000" StrokeThickness="15"
                 StrokeDashArray="5.864,3.910" StrokeLineCap="Round"
                 Opacity="0.5" />
        <Ellipse Width="280" Height="280"
                 Stroke="{Binding $parent[UserControl].Foreground}" StrokeThickness="9"
                 StrokeDashArray="9.774,6.516" StrokeLineCap="Round"
                 Opacity="0.9" />
      </Panel>
      <Image Canvas.Left="24" Canvas.Top="24" Width="256" Height="256"
             Source="{DynamicResource AppLogoLarge}" Stretch="Uniform"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
    </Canvas>
  </Viewbox>
</UserControl>
