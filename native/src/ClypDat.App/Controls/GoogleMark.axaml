<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClypDat.App.Controls.GoogleMark"
             x:CompileBindings="False">

  <!-- Google's "G" in its own four colours. Google's brand rules do not allow
       the mark to be recoloured, so unlike Discord and Xbox - each a single
       silhouette that can take a Foreground - this cannot be a PathIcon, and is
       four Paths in the logo's own 48x48 space inside a Viewbox instead.
       Same four paths the account page on clypdat.xyz draws. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="48" Height="48">
      <Path Fill="#FFC107" Data="M43.6 20.5H42V20H24v8h11.3A12 12 0 1 1 24 12c3.1 0 5.9 1.2 8 3.2l5.7-5.7A20 20 0 1 0 44 24c0-1.2-.1-2.3-.4-3.5Z" />
      <Path Fill="#FF3D00" Data="m6.3 14.7 6.6 4.8A12 12 0 0 1 24 12c3.1 0 5.9 1.2 8 3.2l5.7-5.7A20 20 0 0 0 6.3 14.7Z" />
      <Path Fill="#4CAF50" Data="M24 44c5.1 0 9.8-2 13.4-5.2l-6.2-5.2A12 12 0 0 1 12.9 28l-6.6 5.1A20 20 0 0 0 24 44Z" />
      <Path Fill="#1976D2" Data="M43.6 20.5H42V20H24v8h11.3a12 12 0 0 1-4.1 5.6l.1-.1 6.2 5.2C37 39.1 44 34 44 24c0-1.2-.1-2.3-.4-3.5Z" />
    </Canvas>
  </Viewbox>
</UserControl>
