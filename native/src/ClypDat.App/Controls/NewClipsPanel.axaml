<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClypDat.App.Controls.NewClipsPanel"
             x:CompileBindings="False">

  <!-- The "N clips saved" popup frame, shared by both places it is shown from:
       the in-window overlay on the library (MainWindow.axaml's NewClipsOverlay)
       and the top-level window used while the editor is open (NewClipsDialog,
       which needs its own OS window because LibVLC's native child window cannot
       be covered by a control in MainWindow's tree).

       It lives here because it used to live in BOTH of those, hand-built in C#
       in one and in XAML in the other. Four rounds of restyling then landed on
       the XAML copy only, so for weeks the editor popup rendered the older
       design - a look nobody had chosen since. One tree means a restyle cannot
       reach one presentation and miss the other.

       The cards inside are still built in code (BuildNewClipCard) and dropped
       into Cards; only the frame is here. -->
  <!-- One surface, one 24px gutter. The header and footer used to be their own
       tinted bands with their own insets (28 for the title, 8 for the cards,
       28 again for the buttons), so nothing in the popup shared a left edge.
       Title, thumbnails and both buttons now sit on the same two lines, and
       the only thing separating the three regions is space.

       CardsPanel's Margin is assigned per show by ShowNewClipsDialog, which
       also sizes the frame from it - the value here is only the design-time
       default and has to stay the same gutter. -->
  <Border x:Name="Card" MaxHeight="780" CornerRadius="14" Background="{StaticResource Surface_111920}"
          BorderBrush="{StaticResource Surface_232F3A}" BorderThickness="1"
          BoxShadow="0 24 64 -16 #C0000000" ClipToBounds="True">
    <DockPanel LastChildFill="True">
      <!-- Right inset is 16, not 24: the close button is a 32px hit target
           around a much smaller glyph, so its edge sits outside the gutter to
           put the glyph itself near it. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="24,20,16,16">
        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,12,0">
          <TextBlock x:Name="TitleText" Foreground="{StaticResource Text_EDF4FB}" FontSize="18" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SubtitleText" Foreground="{StaticResource Text_8C98A7}" FontSize="12"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="CloseButton" Grid.Column="1" Classes="dialogClose" FontSize="13"
                Width="32" Height="32" Padding="0" CornerRadius="8" VerticalAlignment="Top"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="CloseButton_OnClick">
          <TextBlock Text="✕" />
        </Button>
      </Grid>

      <!-- Sized to their labels and pushed to opposite gutters, rather than two
           half-width slabs: the destructive action stays reachable without
           carrying the same weight as the one most people want. -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="24,4,24,20">
        <Button x:Name="DeleteButton" Grid.Column="0" Classes="subtleDangerButton" Height="36" Padding="14,0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="DeleteButton_OnClick" />
        <Button x:Name="ViewAllButton" Grid.Column="2" Classes="primaryButton" Content="View All Clips" Height="36" Padding="18,0"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="ViewAllButton_OnClick" />
      </Grid>

      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
        <StackPanel x:Name="CardsPanel" Margin="24,4,24,0" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
