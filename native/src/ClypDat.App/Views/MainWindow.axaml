<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="using:LibVLCSharp.Avalonia"
        xmlns:vm="using:ClypDat.App.ViewModels"
        xmlns:controls="using:ClypDat.App.Controls"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:opconv="using:ClypDat.App.Converters"
        x:Class="ClypDat.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ClypDat"
        Width="1312"
        Height="852"
        MinWidth="1312"
        MinHeight="852"
        Background="#0D1116"
        Icon="/Assets/clypdat-icon.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        SizeChanged="Window_OnSizeChanged">
  <!-- Margin is kept in sync with Window.OffScreenMargin in code-behind.
       A maximized window is deliberately oversized by Windows by the
       invisible resize-border width, which normally sits under the system
       chrome - with ExtendClientAreaToDecorationsHint there IS no system
       chrome, so without this the top of the header and the left of the
       sidebar render past the screen edge. -->
  <Grid x:Name="RootLayout" RowDefinitions="48,*">
    <!-- Somewhere for focus to GO. This Avalonia version's IFocusManager has no
         ClearFocus, and focus has to land on something focusable, so anything
         wanting to hand the keyboard back (the search boxes on Enter or an
         outside click) parks it here. Zero-sized and hit-test-invisible, so it
         is only ever reachable deliberately. -->
    <Border x:Name="FocusSink" Focusable="True" Width="0" Height="0" IsHitTestVisible="False"
            HorizontalAlignment="Left" VerticalAlignment="Top" />
    <Border Grid.Row="0" Background="#171F27" BorderBrush="#1E2A33" BorderThickness="0,0,0,1" PointerPressed="HeaderBar_OnPointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="12,2,0,0" VerticalAlignment="Stretch">
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="brandButton" Padding="6" Click="LibraryHomeButton_OnClick" ToolTip.Tip="Library">
            <!-- 256px source downscaled to the actual 26px on-screen size
                 (bigger than the display size, not a change to it) still
                 looked soft - RenderOptions.BitmapInterpolationMode
                 defaults to a lower-quality mode for the downscale itself,
                 independent of how much source detail is available.
                 HighQuality actually uses that detail. -->
            <Image Source="/Assets/clypdat-icon-256.png" Width="26" Height="26" RenderOptions.BitmapInterpolationMode="HighQuality" />
          </Button>
          <Button x:Name="BackNavButton" Classes="linkButton" Click="BackNavButton_OnClick" ToolTip.Tip="Back" Padding="6" Margin="6,0,0,0">
            <PathIcon Data="M15.41,7.41L14,6l-6,6l6,6l1.41-1.41L10.83,12L15.41,7.41z" Width="16" Height="16" />
          </Button>
          <Button x:Name="ForwardNavButton" Classes="linkButton" Click="ForwardNavButton_OnClick" ToolTip.Tip="Forward" Padding="6">
            <PathIcon Data="M8.59,16.59L10,18l6-6l-6-6L8.59,7.41L13.17,12L8.59,16.59z" Width="16" Height="16" />
          </Button>
          <Button Classes="linkButton" Click="RefreshButton_OnClick" ToolTip.Tip="Refresh library" Padding="6" Margin="4,0,0,0" IsVisible="{Binding IsLibraryVisible}">
            <PathIcon Data="M17.65,6.35C16.2,4.9,14.21,4,12,4c-4.42,0-7.99,3.58-7.99,8s3.57,8,7.99,8c3.73,0,6.84-2.55,7.73-6h-2.08c-0.82,2.33-3.04,4-5.65,4c-3.31,0-6-2.69-6-6s2.69-6,6-6c1.66,0,3.14,0.69,4.22,1.78L13,11h7V4L17.65,6.35z"
                      Width="16" Height="16" />
          </Button>
        </StackPanel>

        <Grid Grid.Column="1"
              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,3*"
              Margin="18,0,0,0"
              VerticalAlignment="Center">
          <Button Grid.Column="0" Content="{Binding RecorderStatus}" Classes="replayButton" Classes.recording="{Binding IsReplayRecording}"
                  ToolTip.Tip="Replay buffer status - click to turn the buffer on or off, or change capture backend, replay length, resolution, frame rate, hotkey and microphone">
            <Button.Flyout>
              <!-- Anchored to the BUTTON's bottom edge, which sits ~6px above
                   the header's own, so the flyout opened overlapping the top
                   bar. The offset drops it to just under the header's bottom
                   border instead, same reasoning as the storage flyout's
                   horizontal one. -->
              <Flyout Placement="BottomEdgeAlignedLeft" VerticalOffset="7" FlyoutPresenterClasses="replayFlyoutPresenter">
                <StackPanel Classes="replayFlyout" Spacing="0">
                    <Border Classes="replayFlyoutHeader">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border Grid.Column="0" Classes="replayFlyoutHeaderAccent" VerticalAlignment="Stretch" />
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                          <TextBlock Text="Replay Buffer" Classes="replayFlyoutHeaderTitle" />
                          <TextBlock Text="{Binding ReplayBufferStateSummary}" Classes="replayFlyoutState" />
                          <TextBlock Text="{Binding ReplayStorageWarning}" Classes="replayFlyoutWarning" IsVisible="{Binding ReplayStorageWarningVisible}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding ReplayBufferEnabled}"
                                      OnContent="{x:Null}" OffContent="{x:Null}"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="Turn the replay buffer on or off" />
                      </Grid>
                    </Border>

                    <Border Classes="replayFlyoutCard">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="replayFlyoutCardTitle" Text="Capture" />
                        <StackPanel Spacing="4">
                          <TextBlock Classes="flyoutLabel" Text="Capture source" />
                          <ComboBox Classes="settingsInput" ItemsSource="{Binding ReplayCaptureSources}" SelectedItem="{Binding SelectedReplayCaptureSource}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="flyoutLabel" Text="Length" />
                            <ComboBox Classes="settingsInput" ItemsSource="{Binding ReplayDurationPresets}" SelectedItem="{Binding SelectedReplayDurationPreset}" HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="8" IsVisible="{Binding IsDesktopCapture}">
                          <StackPanel Spacing="4">
                            <TextBlock Classes="flyoutLabel" Text="Monitor" />
                            <ComboBox Classes="settingsInput" ItemsSource="{Binding DesktopMonitors}" SelectedItem="{Binding SelectedDesktopMonitor}" HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="Capture cursor" Foreground="#B8C7D8" VerticalAlignment="Center" ToolTip.Tip="Include the mouse cursor in desktop capture" />
                              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReplayDesktopCaptureCursor}" OnContent="{x:Null}" OffContent="{x:Null}" ToolTip.Tip="Include the mouse cursor in desktop capture" />
                            </Grid>
                            <Border Grid.Column="1" Width="1" Background="#304352" Margin="0,2" VerticalAlignment="Stretch" />
                            <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock Text="Switch to games" Foreground="#B8C7D8" VerticalAlignment="Center" ToolTip.Tip="Switch to Game Capture when a game is detected" />
                              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReplayAutoSwitchToGameCapture}" OnContent="{x:Null}" OffContent="{x:Null}" ToolTip.Tip="Switch to Game Capture when a game is detected" />
                            </Grid>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <Border Classes="replayFlyoutCard">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="replayFlyoutCardTitle" Text="Quality" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="flyoutLabel" Text="Resolution" />
                            <ComboBox Classes="settingsInput" ItemsSource="{Binding ReplayResolutions}" SelectedItem="{Binding SelectedReplayResolution}" HorizontalAlignment="Stretch">
                              <ComboBox.SelectionBoxItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Height, StringFormat={}{0}p}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=Resolution}" />
                                </DataTemplate>
                              </ComboBox.SelectionBoxItemTemplate>
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Height, StringFormat={}{0}p}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=Resolution}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="flyoutLabel" Text="Frame rate" />
                            <ComboBox Classes="settingsInput" ItemsSource="{Binding ReplayFrameRates}" SelectedItem="{Binding SelectedReplayFrameRate}" HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding StringFormat={}{0} fps}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=FrameRate}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="flyoutLabel" Text="Bitrate" />
                            <ComboBox Classes="settingsInput" ItemsSource="{Binding ReplayBitrateOptions}" SelectedItem="{Binding SelectedReplayBitrateOption}" HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=Bitrate}" /></DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                          <TextBlock Classes="replayBitrateRecommendation" Text="{Binding ReplayBitrateRecommendationText}" />
                          <Button Classes="linkButton replayBitrateRecommendationButton"
                                  Content="{Binding ReplayBitrateRecommendationActionText}"
                                  IsVisible="{Binding ReplayBitrateRecommendationNeedsApply}"
                                  Click="ApplyReplayBitrateRecommendationButton_OnClick" />
                        </StackPanel>
                        <Border Classes="replayFlyoutRestartNotice" IsVisible="{Binding ReplayQualityRestartRequired}">
                          <TextBlock Text="Restarting the buffer to apply the new quality..." Classes="replayFlyoutWarning" />
                        </Border>
                      </StackPanel>
                    </Border>

                    <Border Classes="replayFlyoutCard">
                      <StackPanel Spacing="8">
                        <TextBlock Classes="replayFlyoutCardTitle" Text="Audio &amp; Controls" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Classes="flyoutLabel" Text="Microphone" />
                            <ComboBox Classes="settingsInput" ItemsSource="{Binding MicrophoneDevices}" SelectedItem="{Binding SelectedMicrophoneDevice}" HorizontalAlignment="Stretch">
                              <ComboBox.ItemTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="flyoutLabel" Text="Save hotkey" />
                            <Button Classes="replayFlyoutInput hotkeyKeycap" Click="HotkeyCaptureButton_OnClick" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                              <TextBlock Text="{Binding HotkeyDisplay}" TextAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Button Classes="linkButton replayFlyoutSettingsLink" Click="OpenReplaySettingsButton_OnClick" HorizontalAlignment="Right" Padding="8,6" Margin="0,0,2,0">
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="Open Replay Buffer settings" />
                        <TextBlock Text="›" FontSize="16" VerticalAlignment="Center" Margin="0,-4,0,0" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button Grid.Column="1" Content="Clip" IsEnabled="{Binding IsReplayReady}" Click="ClipButton_OnClick" Margin="10,0,0,0" />
          <TextBlock Grid.Column="2" Text="{Binding HotkeyDisplay}" Foreground="#93A6B8" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" />
          <Border Grid.Column="3" Width="1" Height="20" Background="#2A3640" IsVisible="{Binding ShowLibraryStatus}" Margin="10,0,0,0" />
          <Button Grid.Column="4" Classes="linkButton" Click="ActiveGameButton_OnClick" IsVisible="{Binding ShowLibraryStatus}" Margin="10,0,0,0" ToolTip.Tip="Click for detection options">
            <TextBlock Text="{Binding ActiveGame}" Foreground="#BDD4EE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
          </Button>
          <Border Grid.Column="5" Width="1" Height="20" Background="#2A3640" IsVisible="{Binding HasSelection}" Margin="10,0,0,0" />
          <TextBlock Grid.Column="6"
                     Text="{Binding SelectionSummary}"
                     Foreground="#D7E2EF"
                     FontSize="14"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasSelection}"
                     Margin="10,0,0,0" />
          <Button Grid.Column="7"
                  Content="Delete"
                  Classes="deleteButton"
                  Click="DeleteSelectedButton_OnClick"
                  IsVisible="{Binding HasSelection}"
                  Height="36"
                  Padding="20,0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Margin="10,0,0,0" />
          <Border Grid.Column="8" Width="1" Height="20" Background="#2A3640" IsVisible="{Binding IsEditorVisible}" Margin="10,0,0,0" />
          <TextBlock Grid.Column="9" Text="{Binding SelectedCreated}" Foreground="#93A6B8" VerticalAlignment="Center" IsVisible="{Binding IsEditorVisible}" Margin="10,0,0,0" />
          <Border Grid.Column="10" Width="1" Height="20" Background="#2A3640" IsVisible="{Binding IsEditorVisible}" Margin="10,0,0,0" />
          <TextBlock Grid.Column="11" Text="{Binding SelectedQuality}" Foreground="#93A6B8" VerticalAlignment="Center" IsVisible="{Binding IsEditorVisible}" TextTrimming="CharacterEllipsis" MaxWidth="180" Margin="10,0,0,0" />
          <Border Grid.Column="12" Width="1" Height="20" Background="#2A3640" IsVisible="{Binding IsEditorVisible}" Margin="10,0,0,0" />
          <TextBlock Grid.Column="13" Text="{Binding SelectedSize}" Foreground="#93A6B8" VerticalAlignment="Center" IsVisible="{Binding IsEditorVisible}" TextTrimming="CharacterEllipsis" MaxWidth="110" Margin="10,0,0,0" />
          <Border Grid.Column="14" Width="1" Height="20" Background="#2A3640" IsVisible="{Binding HasSelectedCaptureBackend}" Margin="10,0,0,0" />
          <TextBlock Grid.Column="15"
                     Text="{Binding SelectedCaptureBackend}"
                     Foreground="#93A6B8"
                     VerticalAlignment="Center"
                     IsVisible="{Binding HasSelectedCaptureBackend}"
                     TextTrimming="CharacterEllipsis"
                     Margin="10,0,0,0" />
          <Border Grid.Column="16" Width="1" Height="20" Background="#2A3640" IsVisible="{Binding HasSelectedCaptureBackend}" Margin="10,0,0,0" />
          <Button Grid.Column="17" Classes="linkButton" Click="EditorPathButton_OnClick" IsVisible="{Binding IsEditorVisible}" Margin="10,0,0,0">
            <TextBlock Text="{Binding SelectedVideoPath}" TextTrimming="CharacterEllipsis" />
          </Button>
        </Grid>

        <Button Grid.Column="2" Classes="windowChromeButton" Click="AvailableUpdateButton_OnClick" ToolTip.Tip="Update available" IsVisible="{Binding ShowHeaderUpdateButton}">
          <PathIcon Data="M5,20H19V22H5V20M12,17L5,10H9V3H15V10H19L12,17Z" Width="18" Height="18" Foreground="#38D996" />
        </Button>

        <!-- The active-game chip that used to sit here is gone: the Library
             heading names the filter now, and the sidebar's All Games button
             clears it, so the chip was saying the same thing twice. -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
          <Button Classes="windowChromeButton" Click="MinimizeButton_OnClick" ToolTip.Tip="Minimize">
            <PathIcon Data="M19,13H5V11H19V13Z" Width="14" Height="14" />
          </Button>
          <Button x:Name="MaximizeRestoreButton" Classes="windowChromeButton" Click="MaximizeRestoreButton_OnClick" ToolTip.Tip="Maximize">
            <!-- Kept in sync with OnPropertyChanged's WindowState branch,
                 which swaps this for the restore glyph while maximized. -->
            <PathIcon Data="F0 M4,4H20V20H4V4z M6,6V18H18V6H6z" Width="14" Height="14" />
          </Button>
          <Button Classes="windowChromeButton windowCloseButton" Click="CloseWindowButton_OnClick" ToolTip.Tip="Close">
            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="13" Height="13" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Sidebar (column 0) plus whichever view is showing (column 1: library,
         settings or editor). The editor used to be its own row-1 grid alongside
         this one, with this whole grid - sidebar included - hidden while it was
         open, so opening a clip took the sidebar away with it. Sharing one grid
         keeps the sidebar mounted and unmovable across every view, and the three
         column-1 children just gate their own visibility instead. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <Border x:Name="EditorSidebarRail" Grid.Column="0" Width="{Binding EditorSidebarWidth}" Background="#0D1116" BorderBrush="#1E2A33" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Hidden">
            <StackPanel Margin="0,16,0,16" Spacing="2">
              <Button x:Name="AllClipsFilterButton" Classes="railIconButton" Classes.active="{Binding IsAllClipsActive}" Click="AllClipsFilterButton_OnClick" ToolTip.Tip="All Clips">
                <PathIcon Data="M4,4h4v4H4V4z M10,4h4v4h-4V4z M16,4h4v4h-4V4z M4,10h4v4H4v-4z M10,10h4v4h-4v-4z M16,10h4v4h-4v-4z M4,16h4v4H4v-4z M10,16h4v4h-4v-4z M16,16h4v4h-4v-4z" Width="18" Height="18" />
              </Button>
              <ItemsControl ItemsSource="{Binding ClipTypeFilterOptions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="railIconButton libraryFilterButton" Classes.active="{Binding IsChecked}" Click="LibraryClipTypeSectionButton_OnClick" ToolTip.Tip="{Binding Label}">
                      <PathIcon Data="{Binding Key, Converter={x:Static opconv:ClipTypeKeyToIconConverter.Instance}}" Width="18" Height="18" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="#1E2A33" Margin="16,10" />

              <!-- With Combine off, a game and a section can never both be
                   active at once - picking either already drops the other -
                   so this button (whose only job is clearing the game side
                   specifically) has nothing to do that the logo/home button
                   doesn't already cover, and just adds a second "clear"
                   affordance sitting next to a section-clearing "All Clips"
                   that behaves differently. Combine on, the two really are
                   independent again and this is how you clear one without
                   touching the other. -->
              <Button Classes="railIconButton" Classes.active="{Binding !IsGameFilterActive}" Click="LibraryGameSectionButton_OnClick" ToolTip.Tip="All Games" IsVisible="{Binding CombineSidebarFilters}">
                <PathIcon Data="M21.58,16.09l-1.09-7.66C20.21,6.46,18.52,5,16.53,5H7.47C5.48,5,3.79,6.46,3.51,8.43l-1.09,7.66C2.2,17.63,3.39,19,4.94,19h0c0.68,0,1.32-0.27,1.8-0.75L9,16h6l2.25,2.25c0.48,0.48,1.13,0.75,1.8,0.75h0C20.61,19,21.8,17.63,21.58,16.09z M11,11H9v2H8v-2H6v-1h2V8h1v2h2V11z M15.5,10c-0.55,0-1-0.45-1-1s0.45-1,1-1s1,0.45,1,1S16.05,10,15.5,10z M17.5,13c-0.55,0-1-0.45-1-1s0.45-1,1-1s1,0.45,1,1S18.05,13,17.5,13z"
                          Width="18" Height="18" />
              </Button>

              <!-- The whole game rail: a mix of loose game tiles and folder
                   tiles (GameRailEntries), drag-reorderable and drop-target-
                   able as one unit - see MainWindowViewModel's "Sidebar game
                   rail" region for what backs it. The drag itself isn't wired
                   here on the individual buttons at all - PointerPressed on a
                   Button never reached a same-element bubble handler (the
                   Button's own internal press handling swallows it first), so
                   it's three window-level Tunnel handlers registered in the
                   constructor instead, same fix already used here for
                   KeyDown/KeyUp. See the code-behind's own "Sidebar game
                   rail" region. -->
              <StackPanel x:Name="GameRailContainer" Spacing="2">
                <ItemsControl ItemsSource="{Binding GameRailEntries}">
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="vm:FilterOptionViewModel">
                      <Button Classes="railIconButton railGameButton"
                              Classes.active="{Binding IsChecked}"
                              Click="LibraryGameSectionButton_OnClick"
                              ToolTip.Tip="{Binding Label}">
                        <!-- Right-click to rename, or to move between folders -
                             games named after an executable ("RocketLeague")
                             or a Medal folder are common enough to want
                             fixing, and the rail is the only place games are
                             listed. -->
                        <Button.ContextMenu>
                          <ContextMenu Opening="GameContextMenu_OnOpening">
                            <MenuItem Header="Rename game..." Click="RenameGameMenuItem_OnClick" />
                            <MenuItem Header="Move to folder" Tag="MoveToFolder" />
                            <MenuItem Header="Remove from folder" Tag="RemoveFromFolder" Click="RemoveGameFromFolderMenuItem_OnClick" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Panel Width="30" Height="30">
                          <!-- Initial badge is the fallback for a game whose
                               executable icon hasn't been captured yet (it can
                               only be read while the game is running). -->
                          <Border Classes="gameInitialBadge" Width="30" Height="30" CornerRadius="8" IsVisible="{Binding ShowInitialBadge}">
                            <TextBlock Text="{Binding Key, Converter={x:Static opconv:FirstLetterConverter.Instance}}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Border Classes="gameInitialBadge" Width="30" Height="30" CornerRadius="8" IsVisible="{Binding ShowDesktopCaptureIcon}">
                            <PathIcon Data="M4,5H20V17H13L15,20H9L11,17H4V5M6,7V15H18V7H6Z" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <!-- Rounded square, not a circle: game icons are square
                               artwork, so a circular mask cut their corners off.
                               UniformToFill lets that square art sit edge to edge
                               in the tile. -->
                          <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                            <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                        </Panel>
                      </Button>
                    </DataTemplate>

                    <DataTemplate DataType="vm:GameRailFolderViewModel">
                      <!-- The outline only draws once expanded (the
                           "expanded" class), wrapping the header tile AND
                           the revealed member tiles below it as one visually
                           connected group - not just an expand/collapse with
                           nothing tying header to contents together. -->
                      <Border Classes="railFolderGroup" Classes.expanded="{Binding IsExpanded}">
                        <StackPanel Spacing="2">
                          <!-- Collapsed tile: a mosaic of up to the first 4
                               member icons, Discord-folder style - not a
                               generic folder glyph or a single game's icon.
                               One of four hand-laid-out arrangements below
                               applies depending on how many games are in it,
                               so a folder of 1-3 fills the tile cleanly
                               instead of leaving empty cells in a fixed 2x2
                               (which is what made a small folder's icons look
                               small and off-centre rather than just "fewer").
                               Clicking toggles the folder open rather than
                               filtering - grouping is organisational, not
                               itself a filter. -->
                          <Button Classes="railIconButton railGameButton railFolderHeader"
                                  Classes.expanded="{Binding IsExpanded}"
                                  Click="GameRailFolder_OnClick"
                                  ToolTip.Tip="{Binding Name}">
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="Rename folder..." Click="RenameFolderMenuItem_OnClick" />
                                <MenuItem Header="Ungroup folder" Click="UngroupFolderMenuItem_OnClick" />
                              </ContextMenu>
                            </Button.ContextMenu>
                            <Panel Width="30" Height="30">
                              <!-- Folder glyph: empty folder, or open (the
                                   mosaic below is redundant once the real
                                   icons are already showing underneath). -->
                              <Border Classes="gameInitialBadge" Width="30" Height="30" CornerRadius="8" IsVisible="{Binding ShowFolderGlyph}">
                                <PathIcon Data="M10,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>

                              <!-- Adaptive mosaic, gated as a whole on
                                   ShowMosaic (non-empty, not expanded) - a
                                   fixed 2x2 for every count left an unused
                                   cell sitting blank/grey whenever a folder
                                   held fewer than 4 games, which read as a
                                   broken placeholder rather than "the icons
                                   are just small". Every count lays its icons
                                   out on the SAME 2x2 cell geometry and just
                                   fills fewer of the cells, so an icon is the
                                   same size in every folder regardless of how
                                   many games are in it: 1 sits top-left alone,
                                   2 fill the top row, 3 are two-over-one, 4+
                                   fill all four (see HasSlot4Cell below) - the
                                   4th cell is the 4th game's own icon only at
                                   exactly 4, becoming a "+N" count past that
                                   (same convention Discord uses for a big
                                   folder). -->
                              <Panel IsVisible="{Binding ShowMosaic}">
                                <!-- Same cell size the other layouts use for a
                                     single icon, sitting in its own natural
                                     top-left slot - not stretched to fill the
                                     whole 30x30 tile (where a 2nd icon would
                                     otherwise go), matching the "never
                                     stretch past its own cell" rule the 3-
                                     game layout now follows too. -->
                                <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" ClipToBounds="True" Background="#26323D" IsVisible="{Binding IsSingleGame}">
                                  <Panel>
                                    <Image Source="{Binding Slot1Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot1Icon}" />
                                    <TextBlock Text="{Binding Slot1Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot1Icon}" />
                                  </Panel>
                                </Border>

                                <!-- Same 2x2 grid the 3- and 4-game layouts use,
                                     with only the top row filled - identical
                                     cell size, margins and corner radius, so a
                                     folder's icons stay exactly the same size
                                     whether it holds 2, 3 or 4 games. These
                                     cells were previously pinned to 30x30 (the
                                     whole tile's size) inside a 15px-wide
                                     column, so each icon blew straight past its
                                     own cell and the tile rendered as one giant
                                     clipped icon instead of two small ones. -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" IsVisible="{Binding IsTwoGames}">
                                  <Border Grid.Row="0" Grid.Column="0" Margin="0,0,1,1" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot1Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot1Icon}" />
                                      <TextBlock Text="{Binding Slot1Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot1Icon}" />
                                    </Panel>
                                  </Border>
                                  <Border Grid.Row="0" Grid.Column="1" Margin="1,0,0,1" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot2Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot2Icon}" />
                                      <TextBlock Text="{Binding Slot2Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot2Icon}" />
                                    </Panel>
                                  </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" IsVisible="{Binding IsThreeGames}">
                                  <Border Grid.Row="0" Grid.Column="0" Margin="0,0,1,1" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot1Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot1Icon}" />
                                      <TextBlock Text="{Binding Slot1Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot1Icon}" />
                                    </Panel>
                                  </Border>
                                  <Border Grid.Row="0" Grid.Column="1" Margin="1,0,0,1" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot2Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot2Icon}" />
                                      <TextBlock Text="{Binding Slot2Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot2Icon}" />
                                    </Panel>
                                  </Border>
                                  <!-- Same size as the two cells above it, not
                                       stretched to fill the row - sits at the
                                       bottom-left, under Slot1, same as the
                                       single-game layout's own top-left
                                       placement, not centred under the row. -->
                                  <Border Grid.Row="1" Grid.Column="0" Width="14" Height="14" Margin="0,1,0,0" HorizontalAlignment="Left" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot3Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot3Icon}" />
                                      <TextBlock Text="{Binding Slot3Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot3Icon}" />
                                    </Panel>
                                  </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" IsVisible="{Binding IsFourPlusGames}">
                                  <Border Grid.Row="0" Grid.Column="0" Margin="0,0,1,1" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot1Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot1Icon}" />
                                      <TextBlock Text="{Binding Slot1Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot1Icon}" />
                                    </Panel>
                                  </Border>
                                  <Border Grid.Row="0" Grid.Column="1" Margin="1,0,0,1" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot2Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot2Icon}" />
                                      <TextBlock Text="{Binding Slot2Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot2Icon}" />
                                    </Panel>
                                  </Border>
                                  <Border Grid.Row="1" Grid.Column="0" Margin="0,1,1,0" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot3Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot3Icon}" />
                                      <TextBlock Text="{Binding Slot3Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasSlot3Icon}" />
                                    </Panel>
                                  </Border>
                                  <Border Grid.Row="1" Grid.Column="1" Margin="1,1,0,0" CornerRadius="4" ClipToBounds="True" Background="#26323D">
                                    <Panel>
                                      <Image Source="{Binding Slot4Icon}" Stretch="UniformToFill" IsVisible="{Binding HasSlot4Icon}" />
                                      <TextBlock Text="{Binding Slot4Initial}" FontWeight="Bold" FontSize="9" Foreground="#B8C7D8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowSlot4Initial}" />
                                      <TextBlock Text="{Binding OverflowBadgeLabel}" FontWeight="Bold" FontSize="8" Foreground="#D8E4F2" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasOverflowBadge}" />
                                    </Panel>
                                  </Border>
                                </Grid>
                              </Panel>
                            </Panel>
                          </Button>

                          <ItemsControl ItemsSource="{Binding Games}" IsVisible="{Binding IsExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="railIconButton railGameButton"
                                      Classes.active="{Binding IsChecked}"
                                      Click="LibraryGameSectionButton_OnClick"
                                      ToolTip.Tip="{Binding Label}">
                                <Button.ContextMenu>
                                  <ContextMenu Opening="GameContextMenu_OnOpening">
                                    <MenuItem Header="Rename game..." Click="RenameGameMenuItem_OnClick" />
                                    <MenuItem Header="Move to folder" Tag="MoveToFolder" />
                                    <MenuItem Header="Remove from folder" Tag="RemoveFromFolder" Click="RemoveGameFromFolderMenuItem_OnClick" />
                                  </ContextMenu>
                                </Button.ContextMenu>
                                <Panel Width="30" Height="30">
                                  <Border Classes="gameInitialBadge" Width="30" Height="30" CornerRadius="8" IsVisible="{Binding !HasIcon}">
                                    <TextBlock Text="{Binding Key, Converter={x:Static opconv:FirstLetterConverter.Instance}}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>
                                  <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                                    <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  </Border>
                                </Panel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Implies more content below without a visible scrollbar track -
               a thin fade from transparent to the rail's own background,
               always present (harmless when nothing's actually clipped). -->
          <Border Grid.Row="0" Height="22" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#000D1116" Offset="0" />
                <GradientStop Color="#0D1116" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>

          <StackPanel Grid.Row="0" Margin="0,16,0,16" Spacing="6" IsVisible="False">
            <Button Classes="editorRailButton" Classes.active="{Binding IsEditorInfoSidebarActive}" Click="EditorInfoSidebarButton_OnClick" ToolTip.Tip="Info">
              <StackPanel Spacing="4">
                <PathIcon Data="M11,17H13V11H11V17M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4M11,9H13V7H11V9Z" Width="21" Height="21" />
                <TextBlock Text="Info" />
              </StackPanel>
            </Button>
            <Button Classes="editorRailButton" Classes.active="{Binding IsEditorEffectsSidebarActive}" Click="EditorEffectsSidebarButton_OnClick" ToolTip.Tip="Effects">
              <StackPanel Spacing="4">
                <PathIcon Data="M12,2L14.7,9.3L22,12L14.7,14.7L12,22L9.3,14.7L2,12L9.3,9.3L12,2Z" Width="21" Height="21" />
                <TextBlock Text="Effects" />
              </StackPanel>
            </Button>
            <Button Classes="editorRailButton" Classes.active="{Binding IsEditorExportSidebarActive}" Click="EditorExportSidebarButton_OnClick" ToolTip.Tip="Export">
              <StackPanel Spacing="4">
                <PathIcon Data="M5,20H19V18H5V20M19,9H15V3H9V9H5L12,16L19,9Z" Width="21" Height="21" />
                <TextBlock Text="Export" />
              </StackPanel>
            </Button>
            <Button Classes="editorRailButton" Click="EditorShareSidebarButton_OnClick" ToolTip.Tip="Share" IsEnabled="{Binding !IsExporting}">
              <StackPanel Spacing="4">
                <PathIcon Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8C19.66,8 21,6.66 21,5C21,3.34 19.66,2 18,2C16.34,2 15,3.34 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9C4.34,9 3,10.34 3,12C3,13.66 4.34,15 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.35C15.11,18.57 15.08,18.79 15.08,19C15.08,20.61 16.39,21.92 18,21.92C19.61,21.92 20.92,20.61 20.92,19C20.92,17.39 19.61,16.08 18,16.08Z" Width="21" Height="21" />
                <TextBlock Text="Share" />
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel Grid.Row="1" Margin="0,10,0,16" Spacing="8">
            <Button Classes="railIconButton storageRailButton" ToolTip.Tip="Storage" IsVisible="{Binding !IsEditorVisible}">
              <Button.Flyout>
                <!-- Offset because the flyout anchors to the BUTTON's right
                     edge, not the rail's: the button is 58 wide at a 3px left
                     margin, so it ends at 61 inside a 64px rail. 4 lands the
                     flyout just past the rail edge. Keep this in step with
                     storageRailButton's Width/Margin - it was 12 while the
                     button was the narrower 44, and widening the button
                     without it left the flyout floating out in the content. -->
                <Flyout Placement="RightEdgeAlignedBottom" HorizontalOffset="4">
                  <StackPanel Width="320" Spacing="12" Margin="4,2">
                    <TextBlock Text="HARD DRIVE SPACE" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                    <StackPanel IsVisible="{Binding HasDriveStats}" Spacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding LibraryDriveFreeOfTotalDisplay}" Foreground="#EDF4FB" FontWeight="Bold" FontSize="15" />
                        <TextBlock Grid.Column="1" Text="{Binding LibraryDriveUsedPercentDisplay}" Foreground="#93A6B8" FontSize="12" VerticalAlignment="Center" />
                      </Grid>
                      <Border Width="260" Height="8" CornerRadius="4" Background="#26313C" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="{Binding LibraryUsedFractionOfDrive, Converter={x:Static opconv:FractionToWidthConverter.Instance}, ConverterParameter=260}"
                                  Height="8" CornerRadius="4" Background="#2FD9A8" />
                          <Border Width="{Binding LibraryOtherUsedFractionOfDrive, Converter={x:Static opconv:FractionToWidthConverter.Instance}, ConverterParameter=260}"
                                  Height="8" Background="{StaticResource AccentBrush}" />
                        </StackPanel>
                      </Border>
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Width="10" Height="10" CornerRadius="2" Background="#2FD9A8" />
                          <TextBlock Text="{Binding LibraryClipsUsageDisplay}" Foreground="#B8C7D8" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                          <TextBlock Text="{Binding LibraryOtherUsageDisplay}" Foreground="#B8C7D8" FontSize="12" />
                        </StackPanel>
                      </StackPanel>
                      <TextBlock Text="{Binding LibraryPossibleClipsDisplay}" Foreground="#6B7C8C" FontSize="11.5" IsVisible="{Binding LibraryPossibleClipsDisplay, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <TextBlock Text="Drive stats unavailable for this library folder." Foreground="#6B7C8C" FontSize="12" IsVisible="{Binding !HasDriveStats}" />

                    <Border Height="1" Background="#1E2A33" />

                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="STORAGE LIMIT" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding LibraryStorageLimitSummary}" Foreground="#93A6B8" FontSize="11.5" VerticalAlignment="Center" />
                      </Grid>
                      <TextBlock Text="A target for the library's own size. Nothing is deleted automatically to stay under it."
                                 Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                      <ComboBox Classes="settingsInput"
                                ItemsSource="{Binding LibraryStorageLimitOptions}"
                                SelectedItem="{Binding SelectedLibraryStorageLimit}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <!-- The "Size in GB" watermark vanishes the moment the
                           box holds a number (typed, or restored from a saved
                           custom limit), leaving a bare figure with no unit.
                           The suffix is a permanent overlay instead: the
                           TextBox carries extra right padding to reserve room
                           for it, and it's hit-test invisible so clicking it
                           still lands in the box. -->
                      <Grid IsVisible="{Binding IsCustomLibraryStorageLimit}">
                        <TextBox Classes="settingsInput"
                                 Text="{Binding CustomLibraryStorageLimitGb}"
                                 Padding="14,10,42,10"
                                 PlaceholderText="Size" />
                        <TextBlock Text="GB"
                                   Foreground="#7C8EA3"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,14,0"
                                   IsHitTestVisible="False" />
                      </Grid>
                      <Border Height="6" CornerRadius="3" Background="#26313C" IsVisible="{Binding HasLibraryStorageLimit}">
                        <Border Width="{Binding LibraryStorageLimitUsedFraction, Converter={x:Static opconv:FractionToWidthConverter.Instance}, ConverterParameter=280}"
                                Height="6" CornerRadius="3"
                                Background="{Binding LibraryStorageRingBrush}"
                                HorizontalAlignment="Left" />
                      </Border>
                      <TextBlock Text="Library is over its storage limit."
                                 Foreground="#E5484D" FontSize="11" FontWeight="Bold"
                                 IsVisible="{Binding IsOverLibraryStorageLimit}" />
                    </StackPanel>

                    <Button Classes="linkButton" Content="Open library folder" Click="LibraryStorageButton_OnClick" HorizontalAlignment="Left" Padding="0" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
              <!-- Ring and its used/limit caption are one button's content,
                   not a button with loose text under it - the 30px ring alone
                   was a small target, and the figures right beneath it looked
                   clickable while doing nothing. The used/limit lines show
                   even with no limit set (the second reads "No Limit"), so
                   the current setting is legible without opening the flyout. -->
              <StackPanel Spacing="1">
                <!-- 2px below the ring on top of the stack's own 1px spacing:
                     the figures sat close enough to the circle to read as
                     touching it. Only the ring carries it, so the two text
                     lines stay tight to each other. -->
                <Panel Width="30" Height="30" HorizontalAlignment="Center" Margin="0,0,0,2">
                  <Ellipse Width="30" Height="30" Stroke="#3E4C5A" StrokeThickness="2.5" />
                  <Path Data="{Binding LibraryStorageRingFraction, Converter={x:Static opconv:FractionToArcPathConverter.Instance}}"
                        Stroke="{Binding LibraryStorageRingBrush}" StrokeThickness="2.5" StrokeLineCap="Round" />
                </Panel>
                <TextBlock Text="{Binding LibrarySizeDisplay}"
                           Foreground="#B8C7D8" FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding LibraryStorageLimitShortDisplay}"
                           Foreground="#6B7C8C" FontSize="9"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Classes="railIconButton" Classes.editorRailFooter="{Binding IsEditorVisible}" Click="FeedbackButton_OnClick" ToolTip.Tip="Send feedback">
              <PathIcon Data="M11,18h2v-2h-2V18z M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.41,0-8-3.59-8-8s3.59-8,8-8s8,3.59,8,8S16.41,20,12,20z M12,6c-2.21,0-4,1.79-4,4h2c0-1.1,0.9-2,2-2s2,0.9,2,2c0,2-3,1.75-3,5h2c0-2.25,3-2.5,3-5C16,7.79,14.21,6,12,6z"
                        Width="18" Height="18" />
            </Button>
            <Button Classes="railIconButton" Classes.editorRailFooter="{Binding IsEditorVisible}" Classes.active="{Binding IsSettingsVisible}" Click="OpenSettingsButton_OnClick" ToolTip.Tip="Settings">
              <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                        Width="18" Height="18" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <controls:RetainedPageHost Grid.Column="1" IsActive="{Binding IsLibraryVisible}">
      <Border Background="#101820">
        <DockPanel>
          <!-- Toolbar carrying the library heading and the search box. Sits
               OUTSIDE the margined content grid below so it spans the full
               column width and reads as an actual bar - its own fill plus a
               rule against the cards - rather than as two controls floating in
               the content's own padding, which is where both used to live. -->
          <Border DockPanel.Dock="Top"
                  Height="52"
                  Background="#0D141A"
                  BorderBrush="#1E2A33"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,240" Margin="20,0">
              <!-- Matches date headers: hover reveals select-all checkbox and
                   moves the Clips heading right. Selection stays scoped to
                   clips currently shown by Library filters. -->
              <Border Grid.Column="0"
                      Classes="clipDateRow"
                      Background="Transparent"
                      Padding="0,0,4,0"
                      HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Classes="dayCheck"
                            IsChecked="{Binding IsLibraryHeaderSelected}"
                            Click="LibraryHeaderCheckBox_OnClick"
                            ToolTip.Tip="Select visible clips"
                            VerticalAlignment="Center" />
                  <TextBlock Text="{Binding LibraryTitle}"
                             Foreground="#C4D0DF"
                             FontSize="15"
                             FontWeight="Bold"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <TextBox x:Name="LibrarySearchBox"
                       Grid.Column="2"
                       Classes="settingsInput appSearchBox"
                       Text="{Binding LibrarySearchText}"
                       PlaceholderText="Search Clips or Games"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center">
                <TextBox.InnerLeftContent>
                  <Canvas Width="16" Height="16" Margin="10,0,2,0" VerticalAlignment="Center">
                    <Ellipse Canvas.Left="0" Canvas.Top="0" Width="11" Height="11" Stroke="#6B7C8C" StrokeThickness="1.6" />
                    <Line StartPoint="9,9" EndPoint="15,15" Stroke="#6B7C8C" StrokeThickness="1.6" StrokeLineCap="Round" />
                  </Canvas>
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                  <Button Classes="searchClear" Click="ClearLibrarySearchButton_OnClick"
                          IsVisible="{Binding LibrarySearchText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                          ToolTip.Tip="Clear search">
                    <Canvas Width="12" Height="12">
                      <Line StartPoint="1,1" EndPoint="11,11" Stroke="#8DA0B4" StrokeThickness="1.6" StrokeLineCap="Round" />
                      <Line StartPoint="11,1" EndPoint="1,11" Stroke="#8DA0B4" StrokeThickness="1.6" StrokeLineCap="Round" />
                    </Canvas>
                  </Button>
                </TextBox.InnerRightContent>
              </TextBox>
            </Grid>
          </Border>

        <!-- Top and bottom margins both dropped (was 18 all around). A bottom
             inset stopped the library short of the window's actual bottom edge,
             leaving a bare strip of background below the last row instead of
             just letting a partial row clip against the real edge; a top inset
             did the same thing against the heading/search bar above, holding the
             cards away from it so they were cut off mid-thumbnail by empty
             background rather than by the bar itself. -->
        <Grid Margin="20,0,0,0">
        <DockPanel>

          <!-- "Building your library..." banner - HydrateLibraryClipsAsync
               probes one clip at a time (network drives especially can take
               a while), and without this the window looked idle/frozen the
               whole time instead of showing what it's doing. -->
          <Border DockPanel.Dock="Top"
                  Margin="0,14,0,0"
                  Padding="14,10"
                  CornerRadius="8"
                  Background="#182029"
                  BorderBrush="#2A3640"
                  BorderThickness="1"
                  IsVisible="{Binding IsHydratingLibrary}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding HydrationProgressText}" Foreground="#B8C7D8" FontSize="12" FontWeight="Bold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding HydrationEtaText}"
                           Foreground="#7C8EA3"
                           FontSize="11"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasHydrationEta}" />
              </Grid>
              <ProgressBar Minimum="0"
                           Maximum="1"
                           Value="{Binding HydrationProgressFraction}"
                           Height="4"
                           CornerRadius="2"
                           Background="#26313C"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>

          <!-- Shown when a card is clicked before HydrateLibraryClipsAsync has
               reached it yet - see OpenClipAsync. Self-clears after a few
               seconds (_clipNotReadyMessageTimer). -->
          <Border DockPanel.Dock="Top"
                  Margin="0,14,0,0"
                  Padding="14,10"
                  CornerRadius="8"
                  Background="#182029"
                  BorderBrush="#2A3640"
                  BorderThickness="1"
                  IsVisible="{Binding HasClipNotReadyMessage}">
            <TextBlock Text="{Binding ClipNotReadyMessage}" Foreground="#B8C7D8" FontSize="12" FontWeight="Bold" />
          </Border>


          <Grid>
          <Grid ColumnDefinitions="*,Auto">
          <!-- Date scrubber (right column, below) replaces the default
               scrollbar, so hide the ScrollViewer's own. -->
          <ScrollViewer Grid.Column="0" x:Name="LibraryScrollViewer" Margin="-4,0,-24,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="LibraryItemsControl"
                          ItemsSource="{Binding AllClips}"
                          Opacity="{Binding LibraryCardGridOpacity}"
                          IsHitTestVisible="{Binding IsInitialLibraryLoadComplete}"
                          VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:LibraryCardPanel ScaleWithWindow="{Binding ScaleClipsWithWindow}"
                                             ReservedHeight="{Binding LibraryReservedContentHeight}"
                                             MetricsChanged="LibraryCardPanel_OnMetricsChanged" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel HorizontalAlignment="Stretch"
                              Margin="4,2,20,4"
                              EffectiveViewportChanged="ClipCard_OnEffectiveViewportChanged">
                    <!-- Per-card date header, replacing the old shared
                         per-day group header - only rendered on the first
                         (topmost) clip of each date, not repeated on every
                         card sharing it. Sits OUTSIDE/above the card's own
                         bordered box (a sibling here, not nested inside it)
                         so it shows the page's own background behind it
                         instead of the card's #24303A - nesting it inside
                         the card previously made it look like a mismatched
                         "lip" stuck on top of the rounded card. Hovering
                         this row reveals a checkbox (styled entirely via
                         AppStyles.axaml's CheckBox.dayCheck rules, not local
                         attributes here - a local Width/Opacity/
                         IsHitTestVisible value on the element itself would
                         always beat the :pointerover style override) that
                         selects every clip sharing this date, not just this
                         card - the date text is pushed right by ordinary
                         StackPanel flow as the checkbox's own Width
                         transitions open, no RenderTransform needed. -->
                    <Border Classes="clipDateRow"
                            Background="Transparent"
                            Padding="0,0,4,0"
                            HorizontalAlignment="Left"
                            Opacity="{Binding DateHeaderOpacity}"
                            IsHitTestVisible="{Binding IsFirstOfDate}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox Classes="dayCheck"
                                  IsChecked="{Binding IsDaySelected}"
                                  Click="ClipDayCheckBox_OnClick"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding DateHeaderLabel}"
                                   Foreground="#B8C7D8"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <Border x:Name="LibraryClipCardSurface"
                            Background="#24303A"
                            CornerRadius="12"
                            BoxShadow="0 6 18 -6 #66000000"
                            PointerPressed="ClipCard_OnPointerPressed"
                            ContextRequested="ClipCard_OnContextRequested"
                            PointerEntered="ClipCard_OnPointerEntered"
                            PointerExited="ClipCard_OnPointerExited">
                      <Border CornerRadius="12" ClipToBounds="True">
                          <Grid RowDefinitions="Auto,Auto">
                            <Border Grid.RowSpan="2"
                                    BorderBrush="{Binding SelectionBorderBrush}"
                                    BorderThickness="{Binding SelectionBorderThickness}"
                                    CornerRadius="12"
                                    IsVisible="{Binding IsCheckVisible}"
                                    IsHitTestVisible="False"
                                    ZIndex="10" />
                            <Border Background="#16202A" Height="{Binding $parent[Window].DataContext.CardImageHeight}">
                              <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                                <controls:ClipPreviewPresenter Classes="clipPreviewOverlay" IsHitTestVisible="False" />
                                <Border Background="#661A2040" IsVisible="{Binding IsSelected}" IsHitTestVisible="False" />
                                <!-- Queued for, or undergoing, a parameter-set
                                     repair. The thumbnail underneath is the
                                     broken grey decode, so dim it and say what
                                     is happening rather than let it read as the
                                     clip's real content. -->
                                <Border Background="#CC0E151C"
                                        IsVisible="{Binding IsRepairOverlayVisible}"
                                        IsHitTestVisible="False"
                                        ZIndex="5">
                                  <!-- Content is null unless a repair concerns this
                                       clip, so the template - and the spinner's
                                       animation with it - is only ever realised on
                                       the handful of cards that need it. -->
                                  <ContentControl Content="{Binding RepairOverlayContent}">
                                    <ContentControl.ContentTemplate>
                                      <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                                          <!-- Same mark the startup loader uses. -->
                                          <controls:ClypDatLoader Width="34" Height="34" HorizontalAlignment="Center" />
                                          <TextBlock Text="{Binding}"
                                                     Foreground="#DCE7F3" FontSize="13" FontWeight="Bold"
                                                     HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                      </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                  </ContentControl>
                                </Border>
                                <TextBlock Text="{Binding SelectionOrder}"
                                           IsVisible="{Binding HasSelectionOrder}"
                                           Foreground="#FFFFFF"
                                           FontSize="48"
                                           FontWeight="Bold"
                                           Opacity="0.9"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                  <TextBlock.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="10" OffsetX="0" OffsetY="0" Opacity="0.6" />
                                  </TextBlock.Effect>
                                </TextBlock>
                                <!-- Checkbox appears only on hover and can be
                                     taller than the duration pill. Anchor the
                                     pill at this overlay's top edge so that
                                     layout change never moves it. -->
                                <Grid VerticalAlignment="Top" Margin="12" ColumnDefinitions="Auto,*,Auto">
                                  <CheckBox Grid.Column="0"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsSelected}"
                                            IsVisible="{Binding IsCheckVisible}"
                                            Click="ClipCheckBox_OnClick" />
                                  <Border Grid.Column="2"
                                          VerticalAlignment="Top"
                                          Padding="10,6"
                                          Background="#1A2530"
                                          CornerRadius="18">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                      <PathIcon Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"
                                                Width="12" Height="12"
                                                Foreground="#93A6B8"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasTrimEdit}" />
                                      <TextBlock Text="{Binding DurationLabel}" Foreground="#D8E2EE" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                  </Border>
                                </Grid>
                              </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="#1E2A35">
                                <Grid ColumnDefinitions="*,Auto" Margin="16,13,16,13">
                                <StackPanel Grid.Column="0" Spacing="6">
                                 <Border Classes="clipGameFilter"
                                         BorderThickness="1"
                                         CornerRadius="5"
                                         Padding="5,1"
                                         Margin="-6,-2"
                                         HorizontalAlignment="Left"
                                         Cursor="Hand"
                                         ToolTip.Tip="Filter by this game"
                                         PointerPressed="ClipGame_OnPointerPressed">
                                   <TextBlock Text="{Binding TileTopLabel}"
                                              Foreground="#8C98A7"
                                              FontSize="12"
                                              FontWeight="Bold"
                                              TextTrimming="CharacterEllipsis" />
                                 </Border>
                                <!-- No pencil icon - hovering the title itself
                                     is the affordance (underline, see
                                     TextBlock.editableTitle in AppStyles.axaml)
                                     and clicking it swaps it for an inline
                                     TextBox (BeginInlineTitleEdit). Wrapped in
                                     a Panel (not the title's own parent
                                     StackPanel directly) so the edit box can
                                     be added/removed without disturbing the
                                     rest of the card's layout. MaxWidth is
                                     bound to CardWidth minus just the card's
                                     own side padding now that there's no
                                     pencil footprint to also reserve for. -->
                                <Panel>
                                  <TextBlock Classes="editableTitle"
                                             Text="{Binding TileMainLabel}"
                                             Foreground="#EDF4FB"
                                             FontSize="15"
                                             FontWeight="Bold"
                                             MaxWidth="{Binding $parent[Window].DataContext.CardWidth, Converter={x:Static opconv:SubtractDoubleConverter.Instance}, ConverterParameter=104}"
                                             TextTrimming="CharacterEllipsis"
                                             Cursor="Hand"
                                             HorizontalAlignment="Left"
                                             ToolTip.Tip="Click to rename"
                                             PointerPressed="ClipTitle_OnPointerPressed" />
                                </Panel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <Path Data="M11.99,2C6.47,2,2,6.48,2,12s4.47,10,9.99,10C17.52,22,22,17.52,22,12S17.52,2,11.99,2z M12.5,7H11v6l5.25,3.15l0.75-1.23l-4.5-2.67V7z"
                                        Fill="#8C98A7" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding RelativeDateLabel}"
                                             Foreground="#8C98A7"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             VerticalAlignment="Center" />
                                  <TextBlock Text="{Binding CaptureBackendLabel}"
                                             Foreground="#5C6D7E"
                                             FontSize="11"
                                             IsVisible="{Binding HasCaptureBackendLabel}"
                                             TextTrimming="CharacterEllipsis"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                  <Button Classes="clipShareIconButton"
                                          IsEnabled="{Binding IsHydrated}"
                                          ToolTip.Tip="Share this clip"
                                          Click="ClipCardShare_OnClick">
                                    <PathIcon Data="M18,16.08C17.24,16.08 16.56,16.38 16.04,16.85L8.91,12.7C8.96,12.47 9,12.24 9,12C9,11.76 8.96,11.53 8.91,11.3L15.96,7.19C16.5,7.69 17.21,8 18,8A3,3 0 0,0 21,5A3,3 0 0,0 18,2A3,3 0 0,0 15,5C15,5.24 15.04,5.47 15.09,5.7L8.04,9.81C7.5,9.31 6.79,9 6,9A3,3 0 0,0 3,12A3,3 0 0,0 6,15C6.79,15 7.5,14.69 8.04,14.19L15.16,18.34C15.11,18.55 15.08,18.77 15.08,19C15.08,20.61 16.39,21.91 18,21.91C19.61,21.91 20.92,20.61 20.92,19A2.92,2.92 0 0,0 18,16.08Z"
                                              Width="17" Height="17" Foreground="#C8D9E9" />
                                  </Button>
                                </StackPanel>
                                </Grid>
                            </Border>
                          </Grid>
                          </Border>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
          <controls:LibraryLoadingTilesOverlay
              x:Name="LibraryLoadingTilesOverlay"
              Grid.Column="0"
              ZIndex="1"
              Margin="-4,0,-24,0"
              IsVisible="{Binding ShowLibraryLoadingTiles}"
              TotalTileCount="{Binding LibraryLoadingTileCount}"
              LoadedTileCount="{Binding LoadedVisibleLibraryTileCount}"
              ColumnCount="{Binding CardColumns}"
              TileWidth="{Binding CardWidth}"
              TileHeight="{Binding LibraryLoadingTileHeight}"
              TileTopInset="{Binding LibraryLoadingTileTopInset}"
              RowPitch="{Binding LibraryLoadingRowPitch}"
              IsHitTestVisible="False" />

          <!-- Floats over the library's bottom-right corner once scrolled
               far enough down (ShowScrollToTopButton, toggled off
               LibraryScrollViewer's own ScrollChanged). The scroll itself is
               eased in code-behind (AnimateLibraryScrollToTop) rather than
               an instant Offset snap - ScrollViewer.Offset isn't a
               Transitions-animatable property in Avalonia. -->
          <Button Grid.Column="0"
                  ZIndex="2"
                  Classes="scrollToTopButton"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,20,20"
                  Click="ScrollToTopButton_OnClick"
                  ToolTip.Tip="Scroll to top">
            <Button.IsVisible>
              <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                <Binding Path="ShowScrollToTopButton" />
                <Binding Path="IsLibraryVisible" />
              </MultiBinding>
            </Button.IsVisible>
            <Path Data="M6,15 L12,9 L18,15" Stroke="#D2DEEC" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,6,0,0" />
          </Button>

          <!-- Date scrubber: labels are positioned in code-behind
               (RebuildDateScrubber) from each first-of-date card's measured
               offset inside the scroll content, since a WrapPanel gives no
               way to derive that from the data alone. Clicking or dragging
               anywhere on the track seeks the library to that point. -->
          <!-- Normally just a slim scrollbar; the date timeline only appears
               while the thumb is being dragged. It's an overlay hanging off
               this control's left edge (negative margin, ClipToBounds off)
               rather than a reserved column, so hiding it costs the library
               no width. -->
          <Border Grid.Column="1"
                  x:Name="DateScrubberHost"
                  ZIndex="2"
                  Width="44"
                  Margin="-20,14,4,10"
                  Background="Transparent"
                  ClipToBounds="False"
                  RenderTransform="translateX(10px)"
                  IsVisible="{Binding IsInitialLibraryLoadComplete}"
                  PointerPressed="DateScrubber_OnPointerPressed"
                  PointerMoved="DateScrubber_OnPointerMoved"
                  PointerReleased="DateScrubber_OnPointerReleased"
                  PointerEntered="DateScrubber_OnPointerEntered"
                  PointerExited="DateScrubber_OnPointerExited">
            <Panel ClipToBounds="False">
              <!-- Tick layer sits below both scrollbar layers, so pills can
                   run beneath the rail without drawing through it. -->
              <Canvas x:Name="DateScrubberTicksCanvas"
                      ClipToBounds="False"
                      IsHitTestVisible="False" />

              <!-- Static rail the thumb rides in, so the track still reads
                   as a scrollbar when the library is short enough that the
                   thumb fills most of it. -->
              <Border x:Name="DateScrubberTrack"
                      Width="6"
                      CornerRadius="3"
                      Background="#405262"
                      Opacity="0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Stretch"
                      Margin="34,0,0,0"
                      IsHitTestVisible="False">
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
                    <BrushTransition Property="Background" Duration="0:0:0.13" />
                  </Transitions>
                </Border.Transitions>
              </Border>

              <Canvas x:Name="DateScrubberCanvas" ClipToBounds="False">
                <!-- Grows from its own centre on hover/drag (scaleX, so the
                     width change animates - Width itself can't transition). -->
                <Border x:Name="DateScrubberThumb"
                        Canvas.Left="34"
                        Width="6"
                        MinHeight="34"
                        CornerRadius="3"
                        Background="#91A9BB"
                        Opacity="0"
                        RenderTransformOrigin="50%,50%"
                        RenderTransform="scaleX(1)"
                        IsHitTestVisible="False">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.13" />
                      <BrushTransition Property="Background" Duration="0:0:0.13" />
                      <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.13" />
                    </Transitions>
                  </Border.Transitions>
                </Border>

                <!-- Rides alongside the thumb while dragging with the date
                     you're currently on, so the position you're seeking to is
                     readable without tracing across to the list. -->
                <Border x:Name="DateScrubberBubble"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="6"
                        Padding="10,3"
                        BoxShadow="0 6 18 -4 #B0000000"
                        Opacity="0"
                        IsHitTestVisible="False">
                  <Border.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                    </Transitions>
                  </Border.Transitions>
                  <TextBlock x:Name="DateScrubberBubbleText"
                             Foreground="#FFFFFF"
                             FontSize="12"
                             FontWeight="Bold" />
                </Border>
              </Canvas>
            </Panel>
          </Border>
          </Grid>

          </Grid>
        </DockPanel>
      </Grid>
        </DockPanel>
      </Border>
      </controls:RetainedPageHost>

    <Border Grid.Column="1" Background="#101820" IsVisible="{Binding IsSettingsVisible}">
      <Grid ColumnDefinitions="240,*,Auto">
        <Border Grid.Column="0" Background="#0D1116" BorderBrush="#1E2A33" BorderThickness="0,0,1,0">
          <StackPanel Margin="0,18,16,24" Spacing="2">
            <TextBox x:Name="SettingsSearchBox" Classes="settingsInput appSearchBox" Text="{Binding SettingsSearchText}" PlaceholderText="Search settings" Margin="14,0,0,14" VerticalContentAlignment="Center">
              <TextBox.InnerLeftContent>
                <Canvas Width="16" Height="16" Margin="10,0,2,0" VerticalAlignment="Center">
                  <Ellipse Canvas.Left="0" Canvas.Top="0" Width="11" Height="11" Stroke="#6B7C8C" StrokeThickness="1.6" />
                  <Line StartPoint="9,9" EndPoint="15,15" Stroke="#6B7C8C" StrokeThickness="1.6" StrokeLineCap="Round" />
                </Canvas>
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <Button Classes="searchClear" Click="ClearSettingsSearchButton_OnClick"
                        IsVisible="{Binding SettingsSearchText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="Clear search">
                  <Canvas Width="12" Height="12">
                    <Line StartPoint="1,1" EndPoint="11,11" Stroke="#8DA0B4" StrokeThickness="1.6" StrokeLineCap="Round" />
                    <Line StartPoint="11,1" EndPoint="1,11" Stroke="#8DA0B4" StrokeThickness="1.6" StrokeLineCap="Round" />
                  </Canvas>
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>
            <TextBlock Text="GENERAL" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" Margin="22,0,0,14" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter='General|Game Detection|Import Clips'}" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=General}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=General}" Tag="General" Content="General" Click="SettingsNavButton_OnClick" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Game Detection}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Game Detection}" Tag="Game Detection" Content="Game Detection" Click="SettingsNavButton_OnClick" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Import Clips}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Import Clips}" Tag="Import Clips" Content="Import Clips" Click="SettingsNavButton_OnClick" />

            <TextBlock Text="CAPTURE" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" Margin="22,20,0,14" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter='Replay Buffer|Overlays and Notifications|Auto-Clip|Audio|Game Audio Exclusions'}" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Replay Buffer}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Replay Buffer}" Tag="Replay Buffer" Content="Replay Buffer" Click="SettingsNavButton_OnClick" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Overlays and Notifications}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Overlays and Notifications}" Tag="Overlays and Notifications" Content="Overlays and Notifications" Click="SettingsNavButton_OnClick" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Auto-Clip}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Auto-Clip}" Tag="Auto-Clip" Content="Auto-Clipping" Click="SettingsNavButton_OnClick" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Audio}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Audio}" Tag="Audio" Content="Audio" Click="SettingsNavButton_OnClick" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Game Audio Exclusions}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Game Audio Exclusions}" Tag="Game Audio Exclusions" Content="Game Audio Exclusions" Click="SettingsNavButton_OnClick" />

            <TextBlock Text="ABOUT" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" Margin="22,20,0,14" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=About}" />
            <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=About}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=About}" Tag="About" Content="About" Click="SettingsNavButton_OnClick" />
          </StackPanel>
        </Border>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" Classes="settingsScroll">
          <StackPanel Margin="36,28,36,40" Spacing="22">

            <StackPanel Spacing="18" Tag="Replay Buffer">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Replay Buffer">
                  <Binding Path="SettingsSearchText" />
                  <Binding Path="SelectedSettingsSection" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="REPLAY BUFFER" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Control how ClypDat records in the background and which capture backend it uses." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Save hotkey|Hotkey}">
                <StackPanel Spacing="6">
                  <TextBlock Text="HOTKEY" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <TextBlock Text="Save Hotkey" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Button Content="{Binding HotkeyDisplay}" Click="HotkeyCaptureButton_OnClick" HorizontalAlignment="Left" MinWidth="200" />
                </StackPanel>
              </Border>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Replay length|Recording}">
                <StackPanel Spacing="18">
                  <TextBlock Text="RECORDING" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <StackPanel Spacing="6" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Replay length}">
                    <TextBlock Text="Replay Length" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <ListBox Classes="pillGroup" ItemsSource="{Binding ReplayDurationPresets}" SelectedItem="{Binding SelectedReplayDurationPreset}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Recording quality|Resolution|Frame rate|FPS|Bitrate|Codec|Encoder|Quality|Encoding}">
                <StackPanel Spacing="11">
                  <TextBlock Text="RECORDING QUALITY" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <StackPanel Spacing="4">
                    <TextBlock Text="Quality" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="Customize clip quality. Higher settings use more resources and storage." Foreground="#93A6B8" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>

                  <ListBox Classes="qualityPresetCards" ItemsSource="{Binding ReplayQualityPresets}" SelectedItem="{Binding SelectedReplayQualityPreset}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" />
                          <TextBlock Text="{Binding Description}" Foreground="#B8C7D8" FontSize="11" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Summary}" Foreground="#9CB0C4" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Grid ColumnDefinitions="170,96,96" ColumnSpacing="12" HorizontalAlignment="Left" IsVisible="{Binding IsCustomReplayQuality}">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Resolution" Foreground="#B8C7D8" FontSize="12" />
                      <ComboBox Classes="settingsInput" Width="170" ItemsSource="{Binding ReplayResolutions}" SelectedItem="{Binding SelectedReplayResolution}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=Resolution}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="FPS" Foreground="#B8C7D8" FontSize="12" />
                      <ComboBox Classes="settingsInput" Width="96" ItemsSource="{Binding ReplayFrameRates}" SelectedItem="{Binding SelectedReplayFrameRate}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=FrameRate}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                      <TextBlock Text="Bitrate" Foreground="#B8C7D8" FontSize="12" />
                      <ComboBox Classes="settingsInput" Width="96" ItemsSource="{Binding ReplayBitrateOptions}" SelectedItem="{Binding SelectedReplayBitrateOption}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=Bitrate}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustomReplayQuality}">
                    <TextBlock Classes="replayBitrateRecommendation" Text="{Binding ReplayBitrateRecommendationText}" />
                    <Button Classes="linkButton replayBitrateRecommendationButton"
                            Content="{Binding ReplayBitrateRecommendationActionText}"
                            IsVisible="{Binding ReplayBitrateRecommendationNeedsApply}"
                            Click="ApplyReplayBitrateRecommendationButton_OnClick" />
                  </StackPanel>

                  <Border Background="#0D151C" BorderBrush="#263544" BorderThickness="1" CornerRadius="8" Padding="14,11" IsVisible="{Binding ReplayQualityAboveDefault}">
                    <StackPanel Spacing="4">
                      <TextBlock FontSize="12" TextWrapping="Wrap">
                        <Run Text="Performance note: " Foreground="#FF8B8B" FontWeight="Bold" />
                        <Run Text="{Binding ReplayQualityWarningSummary}" Foreground="#B8C7D8" />
                      </TextBlock>
                      <TextBlock Text="• Check capture headroom during gameplay; higher quality increases encoder workload." Foreground="#93A6B8" FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ReplayQualityWarning}" Foreground="#93A6B8" FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Text="• Encoder overload is monitored, but your selected FPS is never lowered automatically." Foreground="#93A6B8" FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Text="• Stable output usually matters more than maximum resolution." Foreground="#93A6B8" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="150,150" ColumnSpacing="12" HorizontalAlignment="Left">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Video Encoder" Foreground="#B8C7D8" FontSize="12" />
                      <ComboBox Classes="settingsInput" Width="150" ItemsSource="{Binding ReplayEncoderModes}" SelectedItem="{Binding SelectedReplayEncoderMode}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Text="Codec" Foreground="#B8C7D8" FontSize="12" />
                      <ComboBox Classes="settingsInput" Width="150" ItemsSource="{Binding ReplayVideoCodecs}" SelectedItem="{Binding SelectedReplayVideoCodec}" IsEnabled="{Binding !IsReplayEncoderCpu}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding ReplayEncoderModeStatus}" Foreground="#93A6B8" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReplayVideoCodecStatus}" Foreground="#93A6B8" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="Automatic encoder profile: chooses the fastest stable configuration for the available NVIDIA, AMD, Intel, or CPU encoder." Foreground="#93A6B8" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ReplayFrameTimingMetrics}" Foreground="#93A6B8" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding ReplayFrameTimingMetrics, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>

                  <StackPanel Spacing="3" HorizontalAlignment="Left">
                    <TextBlock Text="Frame Timing" Foreground="#B8C7D8" FontSize="12" />
                    <ComboBox Classes="settingsInput" Width="150" ItemsSource="{Binding ReplayFrameTimingModes}" SelectedItem="{Binding SelectedReplayFrameTiming}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock MinWidth="150" Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      <ComboBox.SelectionBoxItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" /></DataTemplate></ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding ReplayFrameTimingDescription}" Foreground="#93A6B8" FontSize="10" TextWrapping="Wrap" MaxWidth="520" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Monitor Encoder Load" Foreground="#B8C7D8" FontWeight="Bold" FontSize="13" />
                      <TextBlock Text="Lower FPS after sustained encoder overload, then restore it after recovery." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ReplayAdaptiveFrameRateEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ReplayQualityRestartRequired}">
                    <TextBlock Text="Restart replay buffer to apply changed quality or encoder settings." Foreground="#E5A00D" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Full session recording|Destination folder|Session codec|Finalize in background|Storage limit|Custom limit|Full Session Recording}">
                <StackPanel Spacing="14">
                  <TextBlock Text="FULL SESSION RECORDING" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Full session recording}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Full Session Recording" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Also writes the entire session (video and audio) to ClypDat's VODs folder. ClypDat backend only for now." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding FullSessionRecordingEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding FullSessionRecordingEnabled}">
                    <StackPanel Spacing="2" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Destination folder}">
                      <TextBlock Text="Destination Folder" Foreground="#B8C7D8" FontWeight="Bold" FontSize="13" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="{Binding FullSessionRecordingFolderDisplay}" Foreground="#6B7C8C" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Height="1" Background="#1B242D" Margin="0,6" IsVisible="{Binding !IsSettingsSearchActive}" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Session codec}">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Session Codec" Foreground="#B8C7D8" FontWeight="Bold" FontSize="13" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                        <TextBlock Text="H.264 saves instantly. AV1 re-encodes on your GPU when the session ends - smaller files, longer finalize." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="settingsInput" Width="170" ItemsSource="{Binding FullSessionCodecs}" SelectedItem="{Binding SelectedFullSessionCodec}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="#1B242D" Margin="0,6" IsVisible="{Binding !IsSettingsSearchActive}" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Finalize in background}">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Finalize in Background" Foreground="#B8C7D8" FontWeight="Bold" FontSize="13" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                        <TextBlock Text="On: the session video appears the moment recording stops, and audio tracks attach quietly afterward (file is briefly video-only). Off: everything is processed before the file appears." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      </StackPanel>
                      <ToggleSwitch Grid.Column="1" IsChecked="{Binding FullSessionBackgroundFinalize}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="#1B242D" Margin="0,6" IsVisible="{Binding !IsSettingsSearchActive}" />
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Storage limit}">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Storage Limit" Foreground="#B8C7D8" FontWeight="Bold" FontSize="13" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                        <TextBlock Text="When session recordings exceed this, the oldest ones are deleted automatically after each save." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" Classes="settingsInput" Width="170" ItemsSource="{Binding FullSessionQuotaOptions}" SelectedItem="{Binding SelectedFullSessionQuota}" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                          <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Border IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Custom limit}">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsCustomFullSessionQuota}">
                      <TextBlock Text="Custom Limit" Foreground="#B8C7D8" FontSize="12" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                        <TextBox Grid.Column="1" Classes="settingsInput" Width="110" Text="{Binding CustomFullSessionQuotaGb}" PlaceholderText="500" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="GB" Foreground="#6B7C8C" FontSize="12" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <!-- A drawn triangle, not a glyph: the "?" this used to
                         start with was a warning character that did not survive
                         an encoding round-trip, and any character-based icon can
                         lose that bet again on a machine whose font lacks it. -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,4,0,0">
                      <PathIcon Classes="cautionIcon" />
                      <TextBlock Grid.Column="1"
                                 Text="Finalizing a long session (muxing the whole thing) can take real time and heavy CPU/disk use, more so at higher quality/fps or longer sessions - other apps (Discord, Spotify, etc.) may stutter or freeze until it finishes."
                                 Foreground="#E5A00D" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" Tag="Overlays and Notifications">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Overlays and Notifications">
                  <Binding Path="SettingsSearchText" />
                  <Binding Path="SelectedSettingsSection" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="OVERLAYS AND NOTIFICATIONS" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Turn the on-screen confirmation and sound on or off, and choose where and how loud it is when a clip saves." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Show clip saved overlay|Hide overlays from screen capture|Show new clips when a game closes|Show clipping started overlay|Show auto-clip detected overlay|Show auto-clip failed overlay|Overlay position|Overlays}">
                <StackPanel Spacing="18">
                  <TextBlock Text="OVERLAYS" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Show clip saved overlay}">
                      <TextBlock Text="Show Clip Saved Overlay" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableClipOverlay}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>

                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Hide notification overlays from screen capture}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Hide Notification Overlays from Screen Capture" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Clip notifications stay on your screen but are left out of clips and Discord screenshare. Editor controls and playback state remain visible. Needs Windows 10 build 19041 or newer." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ExcludeOverlaysFromCapture}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>

                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Show new clips after a session|new clips popup|game closes}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Show New Clips after a Session" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Lists everything the session captured, so you can open or delete it without going to the library. Appears when the game closes, and again if a Full Session VOD finishes later." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowNewClipsOnGameClose}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Show clipping started overlay}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Show Clipping Started Overlay" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Shown when a detected game's replay buffer actually starts recording." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableGameDetectedOverlay}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>

                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Show auto-clip detected overlay}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Show Auto-Clip Detected Overlay" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Shown the instant CS2/Dota/League auto-clipping spots a highlight-worthy moment, before the clip itself finishes saving." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoClipPendingOverlay}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>

                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Show auto-clip failed overlay}">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="Show Auto-Clip Failed Overlay" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Shown when an auto-clip save fails." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAutoClipFailedOverlay}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>

                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <StackPanel Spacing="6" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Overlay position}">
                    <TextBlock Text="Overlay Position" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <ListBox Classes="pillGroup" ItemsSource="{Binding ClipOverlayPositions}" SelectedItem="{Binding SelectedClipOverlayPosition}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="52" Height="34" Background="#0D1116" BorderBrush="#2C3B48" BorderThickness="1" CornerRadius="4">
                              <Border Width="16" Height="8" Margin="4" CornerRadius="2" Background="#5864E8"
                                      HorizontalAlignment="{Binding Converter={x:Static opconv:OverlayPositionToHorizontalAlignmentConverter.Instance}}"
                                      VerticalAlignment="{Binding Converter={x:Static opconv:OverlayPositionToVerticalAlignmentConverter.Instance}}" />
                            </Border>
                            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Play clip saved sound|Sound volume|Sound}">
                <StackPanel Spacing="18">
                  <TextBlock Text="SOUND" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Play clip saved sound}">
                    <TextBlock Text="Play Clip Saved Sound" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableClipOverlaySound}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>

                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <StackPanel Spacing="6" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Sound volume}">
                    <TextBlock Text="Sound Volume" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <ListBox Classes="pillGroup" ItemsSource="{Binding ClipOverlayVolumes}" SelectedItem="{Binding SelectedClipOverlayVolume}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="22" Tag="General">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="General">
                  <Binding Path="SettingsSearchText" />
                  <Binding Path="SelectedSettingsSection" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="GENERAL" Foreground="#5C6D7E" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="Startup behavior, layout, and clip filenames." Foreground="#93A6B8" FontSize="14" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Launch ClypDat on Windows boot|Start minimized on boot|Process priority|Automatically Focus ClypDat|Game exit|Startup'}">
                <StackPanel Spacing="18">
                  <TextBlock Text="STARTUP" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Launch ClypDat on Windows boot|Startup}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Launch ClypDat on Windows Boot" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Starts ClypDat automatically when you sign in to Windows." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnWindowsStartup}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding StartupRegistrationError}" Foreground="#E07070" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasStartupRegistrationError}" />
                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Automatically Focus ClypDat|Game exit}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Automatically Focus ClypDat" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Automatically show ClypDat when you exit your game." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutomaticallyFocusOnGameExit}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Start minimized on boot|Startup}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Start Minimized on Boot" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Opens straight to the tray instead of showing the main window." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimizedToTray}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />
                  <StackPanel Spacing="6" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Process priority}">
                    <TextBlock Text="Process Priority" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <TextBlock Text="Gives ClypDat's capture work more CPU scheduling priority when a demanding game is running. Changes apply immediately." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <ComboBox Classes="settingsInput" ItemsSource="{Binding ProcessPriorityOptions}" SelectedValue="{Binding SelectedProcessPriority}" SelectedValueBinding="{Binding Value}" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Show status panel|Show &quot;Playback Paused&quot; indicator|Scale clips with window size|Hoverbar|Video preview|Combine sidebar filters|Layout'}">
                <StackPanel Spacing="18">
                  <TextBlock Text="LAYOUT" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Show status panel|Layout}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Show Status Panel" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="The right-hand panel here in Settings showing replay buffer status, hotkey, and active game." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsStatusAreaVisible}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Show &quot;Playback Paused&quot; indicator|Layout'}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Show &quot;Playback Paused&quot; Indicator" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Shows a badge over the video in Editor during moments the game window wasn't in focus while recording." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowRecordingPausedIndicator}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Scale clips with window size|Layout}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Scale Clips with Window Size" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Library cards target a fixed size and more columns fit on a wider window (e.g. ~6 across at 1440p), instead of always 3 columns that just grow or shrink with the window." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ScaleClipsWithWindow}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Hoverbar|Layout}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Hoverbar" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Floats the Editor's playback controls over the bottom of the video, appearing while the pointer is in the Editor. Off keeps them docked under the video, always visible." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EditorHoverBarEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Video preview|hovering over a clip|Layout'}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Play a Video Preview when Hovering over a Clip" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Shows a muted full-quality preview after a short hover delay." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableClipHoverPreview}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Combine sidebar filters|Layout}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Combine Sidebar Filters" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Hold one game and one section at the same time, e.g. Fortnite plus Auto-Clips. Off, picking either one clears the other. Selecting several games at once is still done from the Game Filters dropdown." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding CombineSidebarFilters}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Clip Filenames}">
                <StackPanel Spacing="12">
                  <TextBlock Text="Clip Filenames" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <TextBlock Text="Choose how newly saved clips are named. Windows replaces unsupported filename characters such as colons with hyphens." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <ComboBox Classes="settingsInput" ItemsSource="{Binding ClipFileNameSchemes}" SelectedValue="{Binding SelectedClipFileNameScheme}" SelectedValueBinding="{Binding Value}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <StackPanel Spacing="6" IsVisible="{Binding IsCustomClipFileNameScheme}">
                    <TextBlock Foreground="#93A6B8" FontSize="12">Template: {title}, {game}, {datetime:format}</TextBlock>
                    <TextBox Classes="settingsInput" Text="{Binding CustomClipFileNameTemplate}" PlaceholderText="{}{datetime:yyyy-MM-dd HH-mm-ss} - {title}" />
                    <TextBlock Text="{Binding ClipFileNameTemplateError}" Foreground="#E07070" FontSize="12" IsVisible="{Binding HasClipFileNameTemplateError}" TextWrapping="Wrap" />
                    <TextBlock Text="Date/Time Format Help: Microsoft Learn" Tag="https://learn.microsoft.com/en-us/dotnet/standard/base-types/custom-date-and-time-format-strings" PointerPressed="LicenseLinkText_OnPointerPressed" Foreground="#75B8F0" FontSize="12" />
                  </StackPanel>
                  <TextBlock Text="Preview" Foreground="#93A6B8" FontSize="12" />
                  <Border Background="#1D2A36" BorderBrush="#2C3B48" BorderThickness="1" CornerRadius="7" Padding="14,10">
                    <TextBlock Text="{Binding ClipFileNamePreview}" Foreground="#D2DEEC" FontSize="13" TextWrapping="Wrap" />
                  </Border>
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="Apply the current scheme to every video in this library, including imports and Full Sessions stored here." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <Button Grid.Column="1" Content="Rename" Click="RenameAllClipsButton_OnClick" IsEnabled="{Binding CanRenameAllClips}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding RenameAllClipsStatus}" Foreground="#93A6B8" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding HasRenameAllClipsStatus}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" Tag="Game Detection">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Game Detection">
                  <Binding Path="SettingsSearchText" />
                  <Binding Path="SelectedSettingsSection" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="GAME DETECTION" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Add a game ClypDat doesn't recognize yet, and pick which capture backend any game should always use." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Add a running game|Or browse for an executable|Add Games}">
                <StackPanel Spacing="16">
                  <TextBlock Text="ADD GAMES" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <StackPanel Spacing="6" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Add a running game}">
                    <TextBlock Text="Add a Running Game" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                      <ComboBox Classes="settingsInput" ItemsSource="{Binding GameCandidateProcesses}" SelectedItem="{Binding SelectedGameProcess}" HorizontalAlignment="Stretch" />
                      <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" />
                      <Button Grid.Column="2" Content="Add" Click="AddGameFromProcessButton_OnClick" />
                    </Grid>
                  </StackPanel>

                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <StackPanel Spacing="6" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Or browse for an executable}">
                    <TextBlock Text="Or Browse for an Executable" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <Button Content="Browse for game.exe" Click="BrowseCustomGameButton_OnClick" HorizontalAlignment="Left" />
                  </StackPanel>

                  <Border Height="1" Background="#1B242D" />

                  <TextBox Classes="settingsInput" PlaceholderText="Search games" Text="{Binding GameSearchText}" />
                </StackPanel>
              </Border>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Game icons|Game Icons}">
                <StackPanel Spacing="10">
                  <TextBlock Text="GAME ICONS" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="Game Icons" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <TextBlock Text="Sidebar artwork is found automatically and then kept forever, so a wrong or missing icon stays that way. Refreshing throws the cached images away and looks every game up again." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button Content="Refresh Game Icons"
                            Click="RefreshGameIconsButton_OnClick"
                            IsEnabled="{Binding !IsRefreshingGameIcons}"
                            HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding GameIconRefreshStatus}"
                               Foreground="#93A6B8"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               IsVisible="{Binding GameIconRefreshStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="listPane">
                <ScrollViewer Classes="listScroll">
                  <ItemsControl ItemsSource="{Binding GameCaptureRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderThickness="0" Background="Transparent" Padding="12,6,12,10" VerticalAlignment="Top" IsVisible="{Binding IsVisible}">
                          <Grid RowDefinitions="*,Auto">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                              <StackPanel Spacing="1" Margin="{Binding TitleMargin}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" />
                                <!-- ExecutableName is the detection key (e.g.
                                     "steam-381210" for a Catalog-origin row), not
                                     a real filename - ProcessName is the actual
                                     exe. Rows saved before ProcessName existed
                                     have it empty until next detected - collapsed
                                     rather than shown blank so a name-only row's
                                     title centers vertically in the row (which is
                                     as tall as the Capture Backend combo box)
                                     instead of sitting pinned above empty space. -->
                                <TextBlock Text="{Binding ProcessName}" Foreground="#5C6D7E" FontSize="11" IsVisible="{Binding ProcessName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                              </StackPanel>
                              <Button Grid.Column="1" Content="Remove" Padding="14,7" VerticalAlignment="Center" Click="RemoveGameButton_OnClick"
                                      ToolTip.Tip="Removes it from this list and stops ClypDat detecting it as a game again" />
                            </Grid>
                            <Border Grid.Row="1" Height="1" Background="#1B242D" Margin="0,10,0,0" IsVisible="{Binding ShowDivider}" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <Border IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Excluded from detection}">
                <Border Classes="settingsCard" IsVisible="{Binding HasIgnoredGameExecutables}">
                  <StackPanel Spacing="10">
                    <TextBlock Text="EXCLUDED GAMES" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <StackPanel Spacing="2">
                    <TextBlock Text="Excluded from Detection" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Apps you told ClypDat not to treat as games (click the detected game in the header, or Remove a row below, to add one)." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <Border Classes="listPane">
                      <ScrollViewer Classes="listScroll">
                        <ItemsControl ItemsSource="{Binding IgnoredGameExecutableRows}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border BorderThickness="0" Background="Transparent" Padding="12,6,12,10" VerticalAlignment="Top">
                                <Grid RowDefinitions="*,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                  <StackPanel Spacing="1" Margin="{Binding TitleMargin}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="{Binding ProcessName}" Foreground="#5C6D7E" FontSize="11" IsVisible="{Binding ProcessName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                  </StackPanel>
                                  <Button Grid.Column="1" Content="Remove" Width="80" VerticalAlignment="Center" Click="RemoveIgnoredGameButton_OnClick" />
                                </Grid>
                                <Border Grid.Row="1" Height="1" Background="#1B242D" Margin="0,10,0,0" IsVisible="{Binding ShowDivider}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>
                </Border>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" Tag="Import Clips" IsVisible="{Binding IsImportSourcePickerVisible}">
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="IMPORT CLIPS" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Choose where your clips come from." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Classes="settingsCard" Padding="16">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Medal" Foreground="#D2DEEC" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Import clips recorded by Medal, including its titles and game metadata." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                    <Button Content="Open Medal Importer" Classes="primaryButton" Tag="Medal" Click="ChooseImportSourceButton_OnClick" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="settingsCard" Padding="16">
                  <StackPanel Spacing="10">
                    <TextBlock Text="SteelSeries Moments" Foreground="#D2DEEC" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Import Moments clips with metadata dates, titles, games, and auto-clip reasons." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                    <Button Content="Open SteelSeries Importer" Classes="primaryButton" Tag="SteelSeries" Click="ChooseImportSourceButton_OnClick" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>

            <StackPanel Spacing="18" Tag="Import Clips" IsVisible="{Binding IsMedalImportPageVisible}">
              <Button Content="← Import Sources" Classes="linkButton" Click="BackToImportSourcesButton_OnClick" HorizontalAlignment="Left" Padding="0" />
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="IMPORT FROM MEDAL" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Finds clips Medal has recorded locally and copies (or moves) them into your ClypDat library, keeping Medal's own clip titles." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>
              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Strip emoji from titles|Copy instead of move|Import Options}">
                <StackPanel Spacing="18">
                  <TextBlock Text="IMPORT OPTIONS" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Strip emoji from titles}">
                    <TextBlock Text="Strip Emoji from Titles" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MedalImportStripEmoji}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Copy instead of move}">
                    <StackPanel Spacing="2">
                    <TextBlock Text="Copy instead of Move" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="On: Medal keeps its own copy. Off: clips are removed from Medal once imported." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MedalImportCopyNotMove}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Scan for Medal clips|Scan}">
                <StackPanel Spacing="16">
                  <TextBlock Text="SCAN" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Scan for Medal Clips" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="{Binding MedalScanStatusText}" Foreground="#93A6B8" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Scan for Medal Clips" Classes="primaryButton" Click="ScanMedalButton_OnClick" IsEnabled="{Binding !MedalImportInProgress}" VerticalAlignment="Center" />
                  </Grid>

                  <StackPanel IsVisible="{Binding MedalImportInProgress}" Spacing="6">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding MedalImportProgressPercent}" Height="8" />
                    <TextBlock Text="{Binding MedalImportStatusText}" Foreground="#6B7C8C" FontSize="12" />
                  </StackPanel>
                  <TextBlock Text="{Binding MedalImportStatusText}" Foreground="#6B7C8C" FontSize="12" IsVisible="{Binding ShowMedalImportStatusText}" />

                  <StackPanel Spacing="14" IsVisible="{Binding MedalScanned}">
                    <Border Height="1" Background="#1B242D" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,0,0,0">
                      <CheckBox IsThreeState="True" IsChecked="{Binding MedalImportSelectionState, Mode=OneWay}"
                                IsEnabled="{Binding CanToggleMedalImportSelection}" Click="ToggleMedalImportSelection_OnClick"
                                ToolTip.Tip="Select or deselect all importable Medal clips" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Import Selected" Click="ImportMedalButton_OnClick" HorizontalAlignment="Left" Classes="primaryButton"
                              IsEnabled="{Binding !MedalImportInProgress}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding MedalImportRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#0F171E" BorderBrush="#1E2A33" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanImport}" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayTitle}" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI,Segoe UI Emoji" />
                                <TextBlock Foreground="#6B7C8C" FontSize="11">
                                  <Run Text="{Binding GameFolderName}" /><Run Text=" � " /><Run Text="{Binding CreatedAtLocal}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ValidationMessage}" Foreground="#D85E61" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasValidationMessage}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" Tag="Import Clips" IsVisible="{Binding IsSteelSeriesImportPageVisible}">
              <Button Content="← Import Sources" Classes="linkButton" Click="BackToImportSourcesButton_OnClick" HorizontalAlignment="Left" Padding="0" />
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="IMPORT FROM STEELSERIES MOMENTS" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Finds SteelSeries Moments clips locally and copies (or moves) them into your ClypDat library, keeping meaningful Moments titles and capture dates." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>
              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Copy instead of move}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Copy instead of Move" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <TextBlock Text="On: SteelSeries keeps its own copy. Off: clips are removed from Moments once imported." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding SteelSeriesImportCopyNotMove}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Scan for SteelSeries clips|Scan}">
                <StackPanel Spacing="16">
                  <TextBlock Text="SCAN" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Scan for SteelSeries Clips" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="{Binding SteelSeriesScanStatusText}" Foreground="#93A6B8" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Scan for SteelSeries Clips" Classes="primaryButton" Click="ScanSteelSeriesButton_OnClick" IsEnabled="{Binding !SteelSeriesImportInProgress}" VerticalAlignment="Center" />
                  </Grid>
                  <StackPanel IsVisible="{Binding SteelSeriesImportInProgress}" Spacing="6">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SteelSeriesImportProgressPercent}" Height="8" />
                    <TextBlock Text="{Binding SteelSeriesImportStatusText}" Foreground="#6B7C8C" FontSize="12" />
                  </StackPanel>
                  <TextBlock Text="{Binding SteelSeriesImportStatusText}" Foreground="#6B7C8C" FontSize="12" IsVisible="{Binding ShowSteelSeriesImportStatusText}" />
                  <StackPanel Spacing="14" IsVisible="{Binding SteelSeriesScanned}">
                    <Border Height="1" Background="#1B242D" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="12,0,0,0">
                      <CheckBox IsThreeState="True" IsChecked="{Binding SteelSeriesImportSelectionState, Mode=OneWay}" IsEnabled="{Binding CanToggleSteelSeriesImportSelection}" Click="ToggleSteelSeriesImportSelection_OnClick" ToolTip.Tip="Select or deselect all SteelSeries clips" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="Import Selected" Click="ImportSteelSeriesButton_OnClick" HorizontalAlignment="Left" Classes="primaryButton" IsEnabled="{Binding !SteelSeriesImportInProgress}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding SteelSeriesImportRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#0F171E" BorderBrush="#1E2A33" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                              <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanImport}" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayTitle}" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" FontFamily="Segoe UI,Segoe UI Emoji" />
                                <TextBlock Foreground="#6B7C8C" FontSize="11"><Run Text="{Binding GameName}" /><Run Text=" • " /><Run Text="{Binding CreatedAtLocal}" /></TextBlock>
                                <TextBlock Text="{Binding ValidationMessage}" Foreground="#D85E61" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasValidationMessage}" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" Tag="Auto-Clip">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Auto-Clip">
                  <Binding Path="SettingsSearchText" />
                  <Binding Path="SelectedSettingsSection" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="AUTO-CLIPPING" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Have ClypDat save the important moments from supported games using their local event feeds." Foreground="#93A6B8" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,4,0,0">
                  <PathIcon Classes="cautionIcon" />
                  <TextBlock Grid.Column="1" Text="Experimental - still being worked on and can miss events, mislabel clips, or misbehave."
                             Foreground="#E5A00D" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Auto Capture Events}">
                <StackPanel Spacing="14">
                  <TextBlock Text="AUTO CAPTURE" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Auto Capture Events" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Turn this off to pause every game without losing your event choices." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoClippingEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <TextBox Classes="settingsInput" Text="{Binding AutoClipSearchText}" PlaceholderText="Search auto-clipping games or events" />
              <ItemsControl ItemsSource="{Binding AutoClipGames}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="84,*,Auto" ColumnSpacing="16" Margin="0,0,0,18" IsVisible="{Binding IsSearchMatch}">
                      <Border Width="84" Height="120" CornerRadius="8" ClipToBounds="True" Background="#1F3341" VerticalAlignment="Top">
                        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="{Binding Name}" Foreground="#D2DEEC" FontWeight="Bold" FontSize="16" opconv:SettingsHighlight.Query="{Binding SearchQuery}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                      <Button Content="Set Up Dota 2" Click="SetupDotaAutoClipButton_OnClick" IsVisible="{Binding IsSetupRequired}" HorizontalAlignment="Left" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsCs2}">
                          <StackPanel Spacing="2">
                            <TextBlock Text="Deathmatch Clipping" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="CS2 auto-clips save in Competitive matches. Enable this to also save Deathmatch clips." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding DeathmatchClipping}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Groups}">
                          <ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="6"><Button Classes="autoClipGroupToggle" Click="AutoClipGroupToggleButton_OnClick"><Grid ColumnDefinitions="20,*" ColumnSpacing="7"><Grid Width="20" Height="20"><Border BorderBrush="#758494" BorderThickness="1" CornerRadius="4" Background="Transparent" /><Border IsVisible="{Binding IsAllEnabled}" BorderBrush="{DynamicResource CheckBoxCheckBackgroundFillChecked}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource CheckBoxCheckBackgroundFillChecked}" /><Border IsVisible="{Binding IsIndeterminate}" BorderBrush="{DynamicResource CheckBoxCheckBackgroundFillChecked}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource CheckBoxCheckBackgroundFillChecked}" /><TextBlock Text="?" IsVisible="{Binding IsAllEnabled}" Foreground="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="-" IsVisible="{Binding IsIndeterminate}" Foreground="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" /></Grid><TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#D2DEEC" FontWeight="SemiBold" VerticalAlignment="Center" /></Grid></Button><ItemsControl ItemsSource="{Binding Events}" Margin="26,0,0,0"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding UngroupedEvents}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="ON" Foreground="#9EAFBE" FontSize="11" VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding IsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Border Grid.ColumnSpan="3" Height="1" Background="#26313A" VerticalAlignment="Bottom" Margin="0,18,0,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Background="#10171D" BorderBrush="#1E2A33" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="8"><TextBlock Text="COMING SOON" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" /><TextBlock Text="More game integrations are planned. These are not enabled until ClypDat can reliably detect their events." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" /><ItemsControl ItemsSource="{Binding ComingSoonAutoClipGames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#18222B" CornerRadius="5" Padding="8,4" Margin="0,0,6,6"><TextBlock Text="{Binding}" Foreground="#8B9AAA" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" Tag="Audio">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Audio">
                  <Binding Path="SettingsSearchText" />
                  <Binding Path="SelectedSettingsSection" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="RECORDING AUDIO" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="Choose the Windows mixer apps to capture. Every enabled app is saved as its own editable track." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Recording Audio|Audio Processes|Microphone}">
                <StackPanel Spacing="18">
                  <StackPanel Spacing="10" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Recording Audio|Audio Processes}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Recording Audio" Foreground="#EDF4FB" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="Audio Processes" Foreground="#8193A5" FontSize="11" FontWeight="Bold" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" VerticalAlignment="Center" />
                    </Grid>
                    <Border Classes="audioProcessList">
                      <StackPanel Spacing="0">
                        <Border Classes="audioProcessRow enabledRow">
                          <Grid ColumnDefinitions="40,32,*,Auto" ColumnSpacing="14" MinHeight="54">
                            <ToggleSwitch Grid.Column="0" Width="40" IsChecked="True" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="32" Height="32" Background="#202C3A" CornerRadius="9" VerticalAlignment="Center">
                              <PathIcon Data="M4,19H20V21H4V19M6,3H18V17H6V3M8,5V15H16V5H8Z" Width="18" Height="18" Foreground="#78B8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Game Audio" Foreground="#EDF4FB" FontWeight="SemiBold" /><TextBlock Text="Dedicated capture track" Foreground="#6B7C8C" FontSize="11" /></StackPanel>
                            <Grid Grid.Column="3" ColumnDefinitions="200,10,50" VerticalAlignment="Center">
                              <Slider Width="200" Height="52" Classes="volumeSlider appVolumeSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Foreground="{Binding GameAudioVolumePercent, Converter={x:Static opconv:AudioVolumeBrushConverter.Instance}}" Value="{Binding GameAudioVolumePercent}" />
                              <TextBlock Grid.Column="2" Text="{Binding GameAudioVolumePercent, StringFormat={}{0:0}%}" TextAlignment="Right" Foreground="#DCE8F5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                          </Grid>
                        </Border>
                        <Border Classes="audioProcessRow enabledRow">
                          <Grid ColumnDefinitions="40,32,*,Auto" ColumnSpacing="14" MinHeight="54">
                            <ToggleSwitch Grid.Column="0" Width="40" IsChecked="True" IsEnabled="False" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Width="32" Height="32" Background="#202C3A" CornerRadius="9" VerticalAlignment="Center">
                              <PathIcon Data="M12,14C13.66,14 15,12.66 15,11V5C15,3.34 13.66,2 12,2C10.34,2 9,3.34 9,5V11C9,12.66 10.34,14 12,14M17.3,11C17.3,14 14.76,16.1 12,16.1C9.24,16.1 6.7,14 6.7,11H5C5,14.41 7.72,17.23 11,17.72V21H13V17.72C16.28,17.23 19,14.41 19,11H17.3Z" Width="18" Height="18" Foreground="#78B8FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"><TextBlock Text="Microphone" Foreground="#EDF4FB" FontWeight="SemiBold" /><TextBlock Text="Dedicated capture track" Foreground="#6B7C8C" FontSize="11" /></StackPanel>
                            <Grid Grid.Column="3" ColumnDefinitions="200,10,50" VerticalAlignment="Center">
                              <Slider Width="200" Height="52" Classes="volumeSlider appVolumeSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Foreground="{Binding MicrophoneVolumePercent, Converter={x:Static opconv:AudioVolumeBrushConverter.Instance}}" Value="{Binding MicrophoneVolumePercent}" />
                              <TextBlock Grid.Column="2" Text="{Binding MicrophoneVolumePercent, StringFormat={}{0:0}%}" TextAlignment="Right" Foreground="#DCE8F5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                          </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ActiveAudioProcesses}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="audioProcessRow" Classes.enabledRow="{Binding IsEnabled}">
                                <Grid ColumnDefinitions="40,32,*,Auto" ColumnSpacing="14" MinHeight="54">
                                  <ToggleSwitch Grid.Column="0" Width="40" IsChecked="{Binding IsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                                  <Border Grid.Column="1" Width="32" Height="32" Background="#202C3A" CornerRadius="9" VerticalAlignment="Center">
                                    <Grid>
                                      <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BFD5EE" FontWeight="Bold" />
                                      <Image Source="{Binding Icon}" Stretch="Uniform" />
                                    </Grid>
                                  </Border>
                                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="#EDF4FB" FontWeight="SemiBold" /><TextBlock Text="Separate app track" Foreground="#6B7C8C" FontSize="11" /></StackPanel>
                                  <Grid Grid.Column="3" ColumnDefinitions="200,10,50" VerticalAlignment="Center" IsEnabled="{Binding IsEnabled}">
                                    <Slider Width="200" Height="52" Classes="volumeSlider appVolumeSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Foreground="{Binding VolumePercent, Converter={x:Static opconv:AudioVolumeBrushConverter.Instance}}" Value="{Binding VolumePercent}" />
                                    <TextBlock Grid.Column="2" Text="{Binding VolumePercent, StringFormat={}{0:0}%}" TextAlignment="Right" HorizontalAlignment="Stretch" Foreground="#DCE8F5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                  </Grid>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Applications currently in Windows Volume Mixer appear here. Enabled apps stay listed and are always separate tracks; volume supports 0–150% and starts at 100%." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>

                  <TextBlock Text="AUDIO SOURCES" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" IsVisible="False" />
                  <StackPanel Spacing="6" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Chat Audio App" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Multiple Apps" Foreground="#8C98A7" FontSize="12" VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding MultiChatAppEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding !MultiChatAppEnabled}">
                      <TextBlock Text="Pick the app whose audio should be tagged Chat Audio in clips." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <ComboBox Classes="settingsInput" ItemsSource="{Binding OpenProcesses}" SelectedItem="{Binding SelectedChatProcess}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding MultiChatAppEnabled}">
                      <TextBlock Text="Each app added here gets its own Chat Audio track in saved clips." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <ComboBox Classes="settingsInput" ItemsSource="{Binding OpenProcesses}" SelectedItem="{Binding SelectedChatProcess}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" />
                        <Button Grid.Column="2" Content="Add" Click="AddSelectedChatProcessButton_OnClick" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding ChatAudioApps}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="settingsCard" Padding="14,10" Margin="0,8,0,0">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding}" Foreground="#D8E4F2" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Remove" Click="RemoveChatAudioAppButton_OnClick" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>

                  <Border Height="1" Background="#1B242D" IsVisible="{Binding !IsSettingsSearchActive}" />

                  <StackPanel Spacing="6" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Microphone}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="Microphone" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Multiple Mics" Foreground="#8C98A7" FontSize="12" VerticalAlignment="Center" />
                        <ToggleSwitch IsChecked="{Binding MultiMicrophoneEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding !MultiMicrophoneEnabled}">
                      <ComboBox Classes="settingsInput" ItemsSource="{Binding MicrophoneDevices}" SelectedItem="{Binding SelectedMicrophoneDevice}" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding MultiMicrophoneEnabled}">
                      <TextBlock Text="Each microphone added here gets its own track in saved clips." Foreground="#6B7C8C" FontSize="11" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <ComboBox Classes="settingsInput" ItemsSource="{Binding MicrophoneDevices}" SelectedItem="{Binding SelectedMicrophoneDevice}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="Add" Click="AddSelectedMicrophoneButton_OnClick" />
                      </Grid>
                      <ItemsControl ItemsSource="{Binding SelectedMicrophones}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Classes="settingsCard" Padding="14,10" Margin="0,8,0,0">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" Foreground="#D8E4F2" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Remove" Click="RemoveMicrophoneButton_OnClick" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" Tag="Game Audio Exclusions">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Game Audio Exclusions">
                  <Binding Path="SettingsSearchText" />
                  <Binding Path="SelectedSettingsSection" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="GAME AUDIO EXCLUSIONS" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Apps here are removed from Game Audio. Chat Audio captures the selected app above." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="settingsCard">
                <StackPanel Spacing="14">
                  <TextBlock Text="EXCLUDED APPS" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <ComboBox Classes="settingsInput" ItemsSource="{Binding OpenProcesses}" SelectedItem="{Binding SelectedProcessExclusion}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" />
                    <Button Grid.Column="2" Content="Add" Click="AddSelectedProcessButton_OnClick" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox Name="ExcludedProcessTextBox" Classes="settingsInput" PlaceholderText="discord.exe" />
                    <Button Grid.Column="1" Content="Add Manual" Click="AddExcludedProcessButton_OnClick" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="listPane">
                <ScrollViewer Classes="listScrollCompact">
                  <ItemsControl ItemsSource="{Binding ExcludedProcesses}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderThickness="0,0,0,1" BorderBrush="#1B242D" Background="Transparent" Padding="12,6,12,10" VerticalAlignment="Top">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding}" Foreground="#D8E4F2" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Remove" VerticalAlignment="Center" Click="RemoveExcludedProcessButton_OnClick" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
            </StackPanel>

            <StackPanel Spacing="18" Tag="About">
              <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="About">
                  <Binding Path="SettingsSearchText" />
                  <Binding Path="SelectedSettingsSection" />
                </MultiBinding>
              </StackPanel.IsVisible>
              <Border Height="1" Background="#1B242D" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
              <StackPanel Spacing="4">
                <TextBlock Text="ABOUT" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                <TextBlock Text="Version, updates, source, and open source licenses." Foreground="#93A6B8" TextWrapping="Wrap" />
              </StackPanel>
              <Border Height="1" Background="#1B242D" />

              <Border Background="#141D24" BorderBrush="#232F3A" BorderThickness="1" CornerRadius="10" Padding="20">
                <StackPanel Orientation="Horizontal" Spacing="16">
                  <Border Width="52" Height="52" CornerRadius="12" Background="#1D2A36">
                    <Image Source="/Assets/clypdat-icon-24.png" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="ClypDat" Foreground="#EDF4FB" FontWeight="Bold" FontSize="20" />
                    <TextBlock Text="A clip recorder and editor, made to be fast and to stay out of your way." Foreground="#8EA1B6" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                      <TextBlock Text="{Binding AppVersionDisplay}" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="·" Foreground="#3E4C5A" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="Made by ClypLabs" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="·" Foreground="#3E4C5A" FontSize="12" FontWeight="Bold" IsVisible="{Binding HasAppCommit}" />
                      <TextBlock Text="{Binding AppCommitDisplay}"
                                 ToolTip.Tip="View this build's commit on GitHub"
                                 Foreground="#75B8F0"
                                 FontSize="12"
                                 FontWeight="Bold"
                                 TextDecorations="Underline"
                                 Cursor="Hand"
                                 IsVisible="{Binding HasAppCommit}"
                                 Tag="{Binding AppCommitUrl}"
                                 PointerPressed="LicenseLinkText_OnPointerPressed" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Background="#141D24" BorderBrush="#232F3A" BorderThickness="1" CornerRadius="10" Padding="18" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Check for updates|Install updates while loading|Updates}">
                <StackPanel Spacing="16">
                  <TextBlock Text="UPDATES" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                  <TextBlock Text="Check for Updates" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="ClypDat also checks automatically on launch." Foreground="#6B7C8C" FontSize="12" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <Button Name="CheckNowButton" Grid.Column="1" Content="Check Now" Classes="primaryButton" Click="CheckUpdatesButton_OnClick" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Install Updates While Loading" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="The startup loader installs an available update before ClypDat opens. Off asks after launch instead." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding InstallUpdatesOnLaunch}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="#141D24" BorderBrush="#232F3A" BorderThickness="1" CornerRadius="10" Padding="18" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=View on GitHub|Source and Licenses}">
                <StackPanel Spacing="16">
                  <TextBlock Text="SOURCE AND LICENSES" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="View on GitHub" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Source code, releases, and issue tracker." Foreground="#6B7C8C" FontSize="12" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open GitHub" Click="OpenGitHubButton_OnClick" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="#141D24" BorderBrush="#232F3A" BorderThickness="1" CornerRadius="10" Padding="18" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Log folder|Diagnostics}">
                <StackPanel Spacing="16">
                  <TextBlock Text="DIAGNOSTICS" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <StackPanel Spacing="2">
                  <TextBlock Text="Log Folder" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Open ClypDat's log files for troubleshooting a crash or capture issue." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Export Bundle" Click="ExportCaptureDiagnosticsButton_OnClick" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Open Logs" Click="OpenLogsButton_OnClick" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="#141D24" BorderBrush="#232F3A" BorderThickness="1" CornerRadius="10" Padding="18" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Setup walkthrough|Get Started}">
                <StackPanel Spacing="16">
                  <TextBlock Text="GET STARTED" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                  <TextBlock Text="Setup Walkthrough" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                      <TextBlock Text="Replay the first-time setup guide for library, capture, hotkey, and audio settings." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Show Walkthrough" Click="ShowWalkthroughButton_OnClick" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Background="#141D24" BorderBrush="#232F3A" BorderThickness="1" CornerRadius="10" Padding="18">
                <StackPanel Spacing="10">
                  <TextBlock Text="LICENSES" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />

                  <ItemsControl ItemsSource="{Binding ThirdPartyLicenseEntries}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <WrapPanel>
                          <TextBlock Text="This software uses libraries from the " Foreground="#8EA1B6" FontSize="13" />
                          <TextBlock Text="{Binding ProjectName}" Foreground="#BDD4EE" TextDecorations="Underline" FontSize="13" Cursor="Hand" Tag="{Binding ProjectUrl}" PointerPressed="LicenseLinkText_OnPointerPressed" />
                          <TextBlock Text=" project under the " Foreground="#8EA1B6" FontSize="13" />
                          <TextBlock Text="{Binding LicenseName}" Foreground="#BDD4EE" TextDecorations="Underline" FontSize="13" Cursor="Hand" Tag="{Binding LicenseUrl}" PointerPressed="LicenseLinkText_OnPointerPressed" />
                          <TextBlock Text="." Foreground="#8EA1B6" FontSize="13" />
                        </WrapPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Border Height="1" Background="#1B242D" Margin="0,4,0,0" />
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                  <TextBlock Text="Full License Text" Foreground="#D2DEEC" FontWeight="Bold" FontSize="15" />
                      <TextBlock Text="Complete notices and source links for every bundled component." Foreground="#6B7C8C" FontSize="12" TextWrapping="Wrap" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="View Licenses" Click="OpenLicensesButton_OnClick" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2" Width="280" Background="#0D1116" BorderBrush="#1E2A33" BorderThickness="1,0,0,0" IsVisible="{Binding IsStatusAreaVisible}">
          <ScrollViewer>
            <StackPanel Margin="22,28,22,20">
              <TextBlock Text="STATUS" Foreground="#5C6D7E" FontSize="12" FontWeight="Bold" Margin="0,0,0,4" />
              <Border Height="1" Background="#1B242D" Margin="0,10,0,14" />

              <StackPanel Spacing="2" Margin="0,0,0,16">
              <TextBlock Text="Replay Buffer" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding RecorderStatus}" Foreground="#D2DEEC" FontWeight="Bold" FontSize="16" />
              </StackPanel>

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Save hotkey" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding HotkeyDisplay}" Foreground="#D2DEEC" FontWeight="Bold" FontSize="16" />
              </StackPanel>

              <Border Height="1" Background="#1B242D" Margin="0,0,0,16" />

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Replay length" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding SelectedReplayDurationPreset.Label}" Foreground="#D2DEEC" FontWeight="Bold" FontSize="16" />
              </StackPanel>

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Text="Resolution / FPS" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                <TextBlock Foreground="#D2DEEC" FontWeight="Bold" FontSize="16">
                  <Run Text="{Binding SelectedReplayResolution.Label}" /><Run Text=" @ " /><Run Text="{Binding SelectedReplayFrameRate}" /><Run Text="fps" />
                </TextBlock>
              </StackPanel>

              <Border Height="1" Background="#1B242D" Margin="0,0,0,16" />

              <StackPanel Spacing="2">
                <TextBlock Text="Library folder" Foreground="#5C6D7E" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding LibraryLocationText}" Foreground="#93A6B8" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>
      <Grid Grid.Column="1" ColumnDefinitions="*,340" RowDefinitions="*,Auto" IsVisible="{Binding IsEditorVisible}">
      <Grid Grid.ColumnSpan="2" Grid.RowSpan="2" RowDefinitions="*,Auto" ColumnDefinitions="*,340">
        <Grid Grid.Column="0" Background="#0E141A">
          <Border Background="#05080B">
            <!-- Pan slider lives in its own column, not overlapping
                 EditorVideoHost - VideoView is a native child window that
                 always paints over Avalonia-rendered siblings regardless of
                 z-order ("airspace", see the fullscreen overlay's comment
                 block further down), so a Slider stacked on top of it would
                 be invisible/unclickable whenever video is actually showing. -->
            <Grid ColumnDefinitions="*,Auto">
              <!-- ClipToBounds: scroll-zoom scales EditorVideoView past its own
                   cell via RenderTransform - without this the zoomed picture
                   would visibly bleed out over the pan-slider/track panel
                   instead of just filling this pane. -->
              <Grid x:Name="EditorVideoHost" Grid.Column="0" ClipToBounds="True" PointerWheelChanged="VideoHost_OnPointerWheelChanged">
                <controls:ClickableVideoView x:Name="EditorVideoView"
                                IsVisible="{Binding IsEditorVideoAreaVisible}"
                                RenderTransformOrigin="0.5,0.5">
                  <!-- Same EditorVideoView instance gets reparented into
                       FullscreenVideoHost on entering fullscreen (see
                       FullscreenButton_OnClick) - the transform is a property
                       of this element, so it travels with it either way; only
                       MainWindow.axaml.cs's UpdateVideoTransform needs to know
                       which host is current (for the pan-range math). -->
                  <controls:ClickableVideoView.RenderTransform>
                    <!-- Retrieved by index in UpdateVideoTransform (code-behind) -
                         x:Name on a Transform nested this deep doesn't generate a
                         field the way a named Control does. -->
                    <TransformGroup>
                      <ScaleTransform ScaleX="1" ScaleY="1" />
                      <TranslateTransform Y="0" />
                    </TransformGroup>
                  </controls:ClickableVideoView.RenderTransform>
                </controls:ClickableVideoView>
                <!-- VideoView is hidden while LibVLC decodes its first frame,
                     allowing this Avalonia image to show instead of native
                     video's black surface. SelectedThumbnail is swapped
                     synchronously when a new clip is opened. -->
                <Image Source="{Binding SelectedThumbnail}"
                       Stretch="Uniform"
                       IsHitTestVisible="False">
                  <Image.IsVisible>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                      <Binding Path="IsEditorVideoLoading" />
                      <Binding Path="HasSelectedThumbnail" />
                    </MultiBinding>
                  </Image.IsVisible>
                </Image>
                <TextBlock Text="Loading"
                           Foreground="#93A6B8"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                      <Binding Path="IsEditorVideoLoading" />
                      <Binding Path="HasSelectedThumbnail" Converter="{x:Static conv:BoolConverters.Not}" />
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
              </Grid>
              <!-- Vertical pan, only meaningful once zoomed - see VideoPanY's
                   comment (MainWindowViewModel) for how this maps to an actual
                   pixel offset. -->
              <Slider Grid.Column="1"
                      Orientation="Vertical"
                      Minimum="-1" Maximum="1"
                      Value="{Binding VideoPanY, Mode=TwoWay}"
                      Width="36"
                      Margin="4,24"
                      IsVisible="{Binding IsVideoZoomed}" />
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="editorTimelinePanel">
          <Grid RowDefinitions="Auto,Auto,*" Margin="14,12,14,10">
            <Border Classes="editorTimelineHeader" Height="58" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="TIMELINE" Classes="editorTimelineEyebrow" />
                  <TextBlock Text="{Binding SelectedVideoName}" Classes="editorTimelineTitle" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border Grid.Column="1" Classes="editorTimelineTime" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="PLAYHEAD" Classes="editorTimelineEyebrow" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TimelineStatusLabel}" Foreground="#EDF4FB" FontFamily="Consolas" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <!-- The docked control row, and the default: exactly the bar that sat
                 here before the hover bar replaced it. Auto row rather than a
                 fixed 44 so it collapses to nothing (not an empty gap) when the
                 Hoverbar setting moves these controls over the video instead. -->
            <Grid Grid.Row="1" Height="44" Margin="0,-4,0,4" IsVisible="{Binding !EditorHoverBarEnabled}">
              <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8" Margin="4,0,0,0">
                <Border Classes="muteToggle"
                        Width="26"
                        Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        PointerPressed="MasterVolumeMuteToggle_OnPointerPressed"
                        Cursor="Hand"
                        ToolTip.Tip="Mute/unmute">
                  <PathIcon Width="15"
                            Height="15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{Binding IsMasterMuted, Converter={x:Static opconv:BoolToMuteBrushConverter.Instance}}"
                            Data="{Binding EffectiveMasterVolumePercent, Converter={x:Static opconv:VolumeLevelToIconConverter.Instance}}" />
                </Border>
                <Slider Classes="volumeSlider"
                        Minimum="0" Maximum="150"
                        TickFrequency="1" IsSnapToTickEnabled="True"
                        Width="90"
                        VerticalAlignment="Center"
                        Value="{Binding MasterVolumePercent, Mode=TwoWay}"
                        Opacity="{Binding IsMasterMuted, Converter={x:Static opconv:BoolToOpacityConverter.Instance}}" />
                <TextBlock Text="{Binding MasterVolumePercent, StringFormat={}{0:0}%}"
                           Foreground="#93A6B8"
                           FontSize="11"
                           Width="30"
                           Margin="0,2,0,0"
                           VerticalAlignment="Center" />
                <Button Classes="linkButton"
                        Content="Reset"
                        FontSize="10"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsMasterVolumeNonDefault}"
                        Click="MasterVolumeReset_OnClick"
                        ToolTip.Tip="Reset to 100%" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
                <Button Classes="transportButton" Click="RestartButton_OnClick" ToolTip.Tip="Restart">
                  <PathIcon Width="16" Height="16" Foreground="#C8D6E6" Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
                </Button>
                <Button Classes="transportButton" Click="StepBackButton_OnClick" ToolTip.Tip="Step back">
                  <PathIcon Width="16" Height="16" Foreground="#C8D6E6" Data="M16 5v14L5 12Z" />
                </Button>
                <Button Classes="playButton" Click="PlayPauseButton_OnClick" ToolTip.Tip="Play/Pause">
                  <Grid>
                    <PathIcon Width="16" Height="16" Foreground="#DDE8F6" Data="M8 5v14l11-7z" IsVisible="{Binding !IsPlaying}" />
                    <PathIcon Width="16" Height="16" Foreground="#DDE8F6" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" IsVisible="{Binding IsPlaying}" />
                  </Grid>
                </Button>
                <Button Classes="transportButton" Click="StepForwardButton_OnClick" ToolTip.Tip="Step forward">
                  <PathIcon Width="16" Height="16" Foreground="#C8D6E6" Data="M8 5v14l11-7z" />
                </Button>
                <Button Classes="transportButton" Click="EndButton_OnClick" ToolTip.Tip="End">
                  <PathIcon Width="16" Height="16" Foreground="#C8D6E6" Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
                </Button>
                <Button Classes="transportButton" Click="FullscreenButton_OnClick" ToolTip.Tip="Fullscreen">
                  <PathIcon Width="14" Height="14" Foreground="#C8D6E6" Data="M7,14H5v5h5v-2H7V14z M5,10h2V7h3V5H5V10z M17,17h-3v2h5v-5h-2V17z M14,5v2h3v3h2V5H14z" />
                </Button>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2" ColumnDefinitions="188,*" ColumnSpacing="16">
              <!-- Fixed at 34 so trim metadata and timeline ruler share a row.
                   TimelineRulerControl anchors labels at the top and ticks at
                   the bottom, leaving enough room for both without offsetting
                   track labels from their corresponding lanes. -->
              <Grid RowDefinitions="34,*">
                <!-- Keep trim metadata flat so it reads as lane context rather
                     than competing with the timeline ruler as another control. -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="10,0,0,7" Spacing="3" Classes="editorTrimReadout">
                  <TextBlock Text="TRIM RANGE" Classes="editorTimelineEyebrow" />
                  <TextBlock Text="{Binding TrimRangeLabel}" Foreground="#D8E7F5" FontSize="13" FontWeight="SemiBold" FontFamily="Consolas" />
                </StackPanel>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding TimelineTracks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Height="{Binding LaneHeight}" Classes="editorTrackCard"
                              Margin="{Binding LaneMargin}"
                              ClipToBounds="False">
                        <Grid Margin="{Binding LaneContentMargin}" RowDefinitions="Auto,*" ColumnDefinitions="20,10,*">
                          <!-- ZIndex so the Reset button below keeps its own
                               clicks. The Slider in row 1 is taller than the
                               row it draws in and is declared after this one,
                               so without this it hit-tests on top of the button
                               and pressing Reset grabs the slider instead. -->
                          <Grid Grid.ColumnSpan="3"
                                Grid.RowSpan="{Binding LabelRowSpan}"
                                VerticalAlignment="Center"
                                ColumnDefinitions="*,Auto"
                                ZIndex="2">
                            <TextBlock Text="{Binding Label}"
                                       Foreground="#E6EEF7"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="{Binding LabelMargin}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Only shown once a track has actually been moved off
                                 its 100% default (IsVolumeNonDefault) - a reset
                                 affordance next to every track's label all the
                                 time would just be noise for the common case
                                 (untouched, still at 100%). -->
                            <Button Grid.Column="1"
                                    Classes="linkButton"
                                    Content="Reset"
                                    FontSize="10"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding IsVolumeNonDefault}"
                                    Click="TrackVolumeReset_OnClick"
                                    ToolTip.Tip="Reset to 100%" />
                          </Grid>
                          <Border Grid.Row="1"
                                  Classes="muteToggle"
                                  Width="22"
                                  Height="22"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="0,5,0,0"
                                  IsVisible="{Binding IsAudio}"
                                  PointerPressed="TrackMuteToggle_OnPointerPressed"
                                  Cursor="Hand"
                                  ToolTip.Tip="Mute/unmute this track">
                            <PathIcon Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding IsMuted, Converter={x:Static opconv:BoolToMuteBrushConverter.Instance}}"
                                      Data="{Binding EffectiveVolumePercent, Converter={x:Static opconv:VolumeLevelToIconConverter.Instance}}" />
                          </Border>
                          <!-- No forced Height any more, and that is what fixes
                               the thumb being sliced off along the bottom. The
                               Slider was pinned to 26 while its template wants
                               more than that for a 16px thumb sitting on the
                               track; the surplus thumb hung outside the
                               control's own bounds and got clipped there.
                               Natural height also lands the rail where
                               VerticalAlignment="Center" claims it is, instead
                               of low inside a squeezed box - which is what the
                               growing pile of negative margins here was
                               chasing. ClipToBounds is belt and braces: nothing
                               in this cell should ever cut the thumb again. -->
                                  <Slider Grid.Row="1"
                                  Grid.Column="2"
                                  Classes="volumeSlider editorTrackVolumeSlider"
                                  Foreground="{Binding VolumeAccentBrush}"
                                  Minimum="0"
                                  Maximum="150"
                                  TickFrequency="1"
                                  IsSnapToTickEnabled="True"
                                  Padding="0"
                                  ClipToBounds="False"
                                  VerticalAlignment="Center"
                                  Margin="{Binding VolumeSliderMargin}"
                                  Value="{Binding VolumePercent, Mode=TwoWay}"
                                  IsEnabled="{Binding CanAdjustVolume}"
                                  IsVisible="{Binding IsAudio}"
                                  Opacity="{Binding IsMuted, Converter={x:Static opconv:BoolToOpacityConverter.Instance}}"
                                  PointerPressed="TrackVolume_OnPointerPressed"
                                  PointerMoved="TrackVolume_OnPointerMoved"
                                  PointerReleased="TrackVolume_OnPointerReleased"
                                  PropertyChanged="TrackVolume_OnPropertyChanged" />
                          <Border Grid.Row="1"
                                  Grid.Column="2"
                                  Background="#E8EEF8"
                                  CornerRadius="4"
                                  Padding="5,2"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="{Binding VolumeBadgeMargin}"
                                  ZIndex="10"
                                  IsHitTestVisible="False"
                                  IsVisible="{Binding ShowVolumePercent}">
                            <TextBlock Text="{Binding VolumeLabel}" Foreground="#18202A" FontSize="10" FontWeight="Bold" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>

              <Grid Grid.Column="1" RowDefinitions="34,*">
                <!-- Cursor="Hand" on both - the ruler already forwards to the
                     exact same click/drag handlers as the surface below it
                     (UpdateTimelineFromPointer maps via GetPosition(TimelineSurface),
                     so it works correctly regardless of which one the pointer
                     event actually came from), it just had no visual hint that
                     the timestamp row was clickable/draggable too. -->
                <controls:TimelineRulerControl x:Name="TimelineRuler"
                                               Duration="{Binding Duration}"
                                               Cursor="Hand"
                                               PointerPressed="TimelineSurface_OnPointerPressed"
                                               PointerMoved="TimelineSurface_OnPointerMoved"
                                               PointerReleased="TimelineSurface_OnPointerReleased" />
                <Grid x:Name="TimelineSurface"
                      Grid.Row="1"
                      Cursor="Hand"
                      Background="Transparent"
                      SizeChanged="TimelineSurface_OnSizeChanged"
                      PointerPressed="TimelineSurface_OnPointerPressed"
                      PointerMoved="TimelineSurface_OnPointerMoved"
                      PointerReleased="TimelineSurface_OnPointerReleased"
                      PointerCaptureLost="TimelineSurface_OnPointerCaptureLost">
                  <ItemsControl ItemsSource="{Binding TimelineTracks}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                      <StackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <controls:TimelineLaneControl Height="{Binding LaneHeight}"
                                                      VerticalAlignment="Top"
                                                      Margin="{Binding LaneMargin}"
                                                      LaneBrush="{Binding Color}"
                                                      IsVideo="{Binding IsVideo}"
                                                      Peaks="{Binding WaveformPeaks}"
                                                      Filmstrip="{Binding Filmstrip}"
                                                      TrimStartPercent="{Binding $parent[Window].DataContext.TrimStartPercentValue}"
                                                      TrimEndPercent="{Binding $parent[Window].DataContext.TrimEndPercentValue}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Canvas x:Name="TimelineOverlay" IsHitTestVisible="False">
                    <!-- Per-lane dimming for the excluded-from-trim portion is
                         TimelineLaneControl's own DrawTrimShade - that alone
                         marks the trim range now, no separate box on top of it. -->
                    <!-- Subtle glow, not a halo: a soft white bloom close to the
                         line so the playhead reads as lit rather than drawn on,
                         without washing out the frames it sits over. -->
                    <Border x:Name="TimelinePlayhead"
                            Width="3"
                            Background="#F2F6FB"
                            BoxShadow="0 0 7 0 #7DF2F6FB" />
                    <Polygon x:Name="PlayheadCap"
                             Points="0,0 16,0 8,10"
                             Fill="#F2F6FB" />
                  </Canvas>

                  <!-- Trim start/end handles - thin full-height lines with a
                       small flag-style triangle cap at the top, matching the
                       playhead's own look (and GG's), instead of a thick
                       rounded block confined to just the video lane. -->
                  <Canvas x:Name="TimelineHandleLayer">
                    <!-- The grabbable Border is deliberately much wider than the
                         4px line drawn inside it, and transparent either side of
                         it. A 4px target is fussy anywhere, but at the end of an
                         untrimmed clip the end handle sits flush against the
                         timeline's right edge - which is also where the window's
                         own resize border is, so reaching for it resized the
                         window instead. The padding extends the grab area inward,
                         away from that edge, without moving the line itself.
                         PositionTimelineChrome offsets by the padding so the
                         visible line still lands exactly on the boundary. -->
                    <Border x:Name="TrimStartHandle"
                            Classes="trimHandle"
                            Width="28"
                            Background="Transparent"
                            Cursor="SizeWestEast"
                            PointerPressed="TrimStartHandle_OnPointerPressed"
                            PointerMoved="TimelineSurface_OnPointerMoved"
                            PointerReleased="TimelineSurface_OnPointerReleased"
                            ToolTip.Tip="Drag to set trim start">
                      <!-- The rail IS the handle - a pill spanning the video
                           lane, with grip lines at its middle. There is no
                           separate cap on top of it any more: a marker above
                           the timeline is the playhead's job, and having one
                           here too meant three near-identical markers competing
                           for the same meaning. -->
                      <Border Classes="trimBar" />
                    </Border>
                    <Border x:Name="TrimEndHandle"
                            Classes="trimHandle"
                            Width="28"
                            Background="Transparent"
                            Cursor="SizeWestEast"
                            PointerPressed="TrimEndHandle_OnPointerPressed"
                            PointerMoved="TimelineSurface_OnPointerMoved"
                            PointerReleased="TimelineSurface_OnPointerReleased"
                            ToolTip.Tip="Drag to set trim end">
                      <Border Classes="trimBar" />
                    </Border>
                  </Canvas>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- The timeline spans both rows so it can sit below clip details. This
           invisible child supplies Auto's measure for row 1, preventing the
           clip-details column from expanding over the timeline. -->
      <Border Grid.Row="1" Height="{Binding EditorTimelineHeight}" IsHitTestVisible="False" Opacity="0" />

      <!-- Permanent editor inspector. This deliberately lives in MainWindow's
           visual tree rather than an owned native window: it cannot be hidden,
           drift during resize, or sit above/below LibVLC unpredictably. -->
      <Border Grid.Column="1" Grid.Row="0" Classes="editorInspector">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Height="104" Classes="editorInspectorHeader">
            <Grid Margin="24,14,20,14" RowDefinitions="Auto,Auto" RowSpacing="8" VerticalAlignment="Center">
              <StackPanel Spacing="4">
                <TextBlock Text="CLIP DETAILS" Classes="editorTimelineEyebrow" />
                <TextBlock Text="{Binding EditorTitle}" Classes="editorInspectorTitle" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Row="1" Text="{Binding SelectedQuality}" Classes="editorInspectorQuality" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18" Spacing="14">
              <!-- Focusable so Enter in either box below has somewhere to put
                   focus: committing has no visible effect otherwise, and the
                   still-highlighted caret reads as "not saved yet". -->
              <Border x:Name="EditorDetailsCard" Focusable="True" Classes="editorInspectorCard">
                <StackPanel Spacing="8">
                  <TextBlock Text="DETAILS" Foreground="#9EC6F0" FontSize="11" FontWeight="Bold" />
                  <TextBlock Text="Title" Foreground="#8EA1B6" FontSize="12" />
                  <TextBox Text="{Binding EditorTitle, Mode=TwoWay}" Foreground="#EDF4FB" FontSize="14" FontWeight="SemiBold"
                           Background="#0D151C" BorderBrush="#263743" KeyDown="EditorTitle_OnKeyDown" />
                  <TextBlock Text="Description" Foreground="#8EA1B6" FontSize="12" Margin="0,2,0,0" />
                  <!-- KeyDown is wired in code-behind as a TUNNEL handler, not
                       here: AcceptsReturn makes TextBox's own class handler
                       consume Enter to insert a newline, and a class handler
                       runs before an instance handler on the same element - so
                       a KeyDown="..." attribute here never fired at all. -->
                  <TextBox x:Name="EditorDescriptionBox"
                           Text="{Binding EditorDescription, Mode=TwoWay}" MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap"
                           PlaceholderText="Add a description" Background="#0D151C" BorderBrush="#263743" Foreground="#D6E2F0" />
                </StackPanel>
              </Border>

              <Border Classes="editorInspectorCard">
                <StackPanel Spacing="9">
                  <TextBlock Text="Export codec" Foreground="#8EA1B6" FontSize="12" />
                  <ComboBox Classes="settingsInput" ItemsSource="{Binding ExportCodecs}" SelectedItem="{Binding SelectedExportCodec}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" Classes="editorInspectorActions">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Content="Save Trim" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsEnabled="{Binding !IsExporting}" ToolTip.Tip="Replace the original clip with just the trimmed range"
                        Click="SaveTrimButton_OnClick" />
                <Button Grid.Column="1" Content="{Binding ExportButtonText}" Classes="primaryButton" Height="38"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="{Binding !IsExporting}"
                        Click="ExportButton_OnClick" />
              </Grid>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Content="Share" Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsEnabled="{Binding !IsExporting}"
                        ToolTip.Tip="Re-encode to a size cap and drag the result straight into another app"
                        Click="ShareButton_OnClick" />
                <Button Grid.Column="1" Classes="dangerButton" Content="Delete" Height="38"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        IsEnabled="{Binding !IsExporting}"
                        ToolTip.Tip="Delete this clip and close the editor"
                        Click="EditorDeleteButton_OnClick" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      </Grid>
    </Grid>

    <!-- #AA000000, NOT #000000AA - Avalonia hex is #AARRGGBB, alpha FIRST (same
         as every other translucent brush in this app: #CC0B1116, #26FFFFFF,
         #F5141D24). Written the wrong way round this parsed as alpha 00 with AA
         landing in the BLUE channel, i.e. fully transparent, so the scrim behind
         this dialog was never actually drawn. -->
    <Border x:Name="OnboardingOverlay" Grid.RowSpan="2" Background="#AA000000" IsVisible="{Binding IsOnboardingVisible}"
            PointerPressed="OnboardingOverlay_OnPointerPressed">
      <Border Width="600" MaxHeight="680" CornerRadius="12" Background="#111920" BorderBrush="#232F3A" BorderThickness="1"
              ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel Margin="1">
          <Border DockPanel.Dock="Top" Background="#0C1319" CornerRadius="11,11,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="52">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,0,0" VerticalAlignment="Center">
              <Image Source="/Assets/clypdat-icon-24.png" Width="16" Height="16" />
              <StackPanel Spacing="1">
                <TextBlock Text="Welcome to ClypDat" Foreground="#EDF4FB" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="Quick setup — you can change everything later" Foreground="#718396" FontSize="10.5" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Classes="dialogClose" FontSize="22" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Width="48" Height="50" Click="OnboardingSkipButton_OnClick">
              <TextBlock Text="×" Margin="0,-4,0,0" />
            </Button>
          </Grid>
          </Border>

          <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,20" Spacing="14">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding OnboardingStepNumber, StringFormat='Step {0} of 4'}" Foreground="#A9C9E5" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Border Width="8" Height="8" CornerRadius="4" Background="{Binding OnboardingStep, Converter={x:Static opconv:OnboardingDotBrushConverter.Instance}, ConverterParameter=Replay Buffer}" />
              <Border Width="8" Height="8" CornerRadius="4" Background="{Binding OnboardingStep, Converter={x:Static opconv:OnboardingDotBrushConverter.Instance}, ConverterParameter=Startup}" />
              <Border Width="8" Height="8" CornerRadius="4" Background="{Binding OnboardingStep, Converter={x:Static opconv:OnboardingDotBrushConverter.Instance}, ConverterParameter=Audio}" />
              <Border Width="8" Height="8" CornerRadius="4" Background="{Binding OnboardingStep, Converter={x:Static opconv:OnboardingDotBrushConverter.Instance}, ConverterParameter=Game Audio Exclusions}" />
              </StackPanel>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Content="Skip setup" Width="116" HorizontalContentAlignment="Center" VerticalAlignment="Center" Click="OnboardingSkipButton_OnClick" />
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button Content="Back" Width="96" HorizontalContentAlignment="Center" IsEnabled="{Binding OnboardingBackEnabled}" Click="OnboardingBackButton_OnClick" />
                <Button Content="{Binding OnboardingNextLabel}" Width="96" HorizontalContentAlignment="Center" Classes="primaryButton" Click="OnboardingNextButton_OnClick" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,22,24,20" Spacing="18">

              <StackPanel Spacing="16" IsVisible="{Binding OnboardingStep, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Replay Buffer}">
                <TextBlock Text="Library and replay buffer" Foreground="#EDF4FB" FontWeight="Bold" FontSize="18" />
                <TextBlock Text="Pick where clips save, your save hotkey, and how long the replay buffer holds." Foreground="#B9C6D4" FontSize="13" TextWrapping="Wrap" />

                <Border Classes="onboardingSettingCard">
                <StackPanel Spacing="16">
                <StackPanel Spacing="6">
                  <TextBlock Text="Library folder" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" />
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Text="{Binding LibraryFolderDisplay}" Foreground="#6B7C8C" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="Use Default" Click="ResetLibraryFolderButton_OnClick" />
                    <Button Grid.Column="2" Content="Change Folder" Click="FolderButton_OnClick" />
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="Save hotkey" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" />
                  <Button Content="{Binding HotkeyDisplay}" Click="HotkeyCaptureButton_OnClick" HorizontalAlignment="Left" MinWidth="200" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="Replay length" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" />
                  <ListBox Classes="pillGroup" ItemsSource="{Binding ReplayDurationPresets}" SelectedItem="{Binding SelectedReplayDurationPreset}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
                </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="16" IsVisible="{Binding OnboardingStep, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Startup}">
                <TextBlock Text="Startup behavior" Foreground="#EDF4FB" FontWeight="Bold" FontSize="18" />
                <TextBlock Text="How ClypDat behaves when it launches." Foreground="#B9C6D4" FontSize="13" TextWrapping="Wrap" />

                <Border Classes="onboardingSettingCard">
                <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Launch ClypDat on Windows boot" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnWindowsStartup}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Start minimized to tray" Foreground="#D2DEEC" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartMinimizedToTray}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                </Grid>
                </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="16" IsVisible="{Binding OnboardingStep, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Audio}">
                <TextBlock Text="Microphone" Foreground="#EDF4FB" FontWeight="Bold" FontSize="18" />
                <TextBlock Text="Choose the microphone recorded alongside your separate audio tracks." Foreground="#B9C6D4" FontSize="13" TextWrapping="Wrap" />

                <Border Classes="onboardingSettingCard">
                <StackPanel Spacing="16">
                <StackPanel Spacing="6" IsVisible="False">
                  <TextBlock Text="Chat Audio App" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <ComboBox Classes="settingsInput" ItemsSource="{Binding OpenProcesses}" SelectedItem="{Binding SelectedChatProcess}" HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" />
                  </Grid>
                  <TextBlock Text="Multiple chat apps? Turn that on later in Settings &gt; Audio." Foreground="#6B7C8C" FontSize="11" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Text="Microphone" Foreground="#B8C7D8" FontWeight="Bold" FontSize="15" />
                  <ComboBox Classes="settingsInput" ItemsSource="{Binding MicrophoneDevices}" SelectedItem="{Binding SelectedMicrophoneDevice}" HorizontalAlignment="Stretch" />
                  <TextBlock Text="Multiple microphones? Turn that on later in Settings &gt; Audio." Foreground="#6B7C8C" FontSize="11" />
                </StackPanel>
                </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel Spacing="16" IsVisible="{Binding OnboardingStep, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Game Audio Exclusions}">
                <TextBlock Text="Game Audio exclusions" Foreground="#EDF4FB" FontWeight="Bold" FontSize="18" />
                <TextBlock Text="Selected app tracks are excluded automatically. Add music players or notification apps you do not want in Game Audio." Foreground="#B9C6D4" FontSize="13" TextWrapping="Wrap" />

                <Border Classes="onboardingSettingCard">
                <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <ComboBox Classes="settingsInput" ItemsSource="{Binding OpenProcesses}" SelectedItem="{Binding SelectedProcessExclusion}" HorizontalAlignment="Stretch" />
                  <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" />
                  <Button Grid.Column="2" Content="Add" Click="AddSelectedProcessButton_OnClick" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Name="OnboardingExcludedProcessTextBox" Classes="settingsInput" PlaceholderText="discord.exe" />
                  <Button Grid.Column="1" Content="Add Manual" Click="AddExcludedProcessOnboardingButton_OnClick" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ExcludedProcesses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="{Binding}" Foreground="#D8E4F2" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Remove" Click="RemoveExcludedProcessButton_OnClick" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
                </Border>
                <Border Background="#102723" BorderBrush="#285A50" BorderThickness="1" CornerRadius="9" Padding="15,13">
              <StackPanel Spacing="4">
                    <TextBlock Text="You're all set" Foreground="#B8F1DC" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="Thanks for using ClypDat. Capture something great." Foreground="#A1CDBE" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- New Clips popup - embedded in the main window rather than its own OS
         Window (which is what this used to be, built entirely in code-behind
         via CreateChromelessDialog). A separate Window has its own title bar
         drag, so it could be dragged off wherever and left behind; as part of
         this Border it can't be moved at all, and the same #AA000000 scrim the
         onboarding overlay above uses darkens the whole app behind it instead
         of leaving it in full view. IsVisible is toggled directly on the named
         element from code-behind (ShowNewClipsDialog) rather than bound to a
         ViewModel property - the title text and card grid are still built in
         code-behind too (into NewClipsTitleText/NewClipsCardsPanel below),
         same as before, just targeting this embedded tree instead of a
         Window's own body. -->
    <Border x:Name="NewClipsOverlay" Grid.RowSpan="2" Background="#DD000000" IsVisible="False"
            PointerPressed="NewClipsOverlay_OnPointerPressed">
      <Border x:Name="NewClipsDialogCard" MaxHeight="860" CornerRadius="12" Background="#111920" BorderBrush="#232F3A" BorderThickness="1"
              ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Height="56" Background="#0C1319">
            <TextBlock x:Name="NewClipsTitleText" Grid.Column="1" Foreground="#D8E4F2" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="dialogClose" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Width="52" Height="56" Click="NewClipsCloseButton_OnClick">
              <TextBlock Text="✕" Margin="0,-3,0,0" />
            </Button>
          </Grid>

          <Border DockPanel.Dock="Bottom" Background="#141B23" BorderBrush="#232F3A" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="24,16,24,16">
              <Button x:Name="NewClipsDeleteButton" Classes="deleteButton" MinWidth="150" Height="40"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="NewClipsDeleteButton_OnClick" />
              <Button x:Name="NewClipsViewAllButton" Grid.Column="2" Classes="primaryButton" Content="View All Clips" MinWidth="180" Height="40"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="NewClipsViewAllButton_OnClick" />
            </Grid>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="620">
            <StackPanel x:Name="NewClipsCardsPanel" Margin="24,20,24,4" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- Video-only fullscreen overlay. Grid.RowSpan="2" + last child of the
         root Grid, same pattern as the onboarding overlay above, so this
         covers the header row too despite its fixed 48px height. -->
    <Border Grid.RowSpan="2" Background="Black" IsVisible="{Binding IsVideoFullscreen}">
      <!--
        Video row (star) and controls row (auto) are non-overlapping on
        purpose. VideoView hosts LibVLC's video output as a real native
        child window on Windows - native surfaces always paint on top of
        Avalonia-rendered siblings regardless of visual-tree/Panel order
        ("airspace"), so any Avalonia control physically overlapping its
        bounds becomes invisible and unclickable. Keeping the playbar in
        its own row below the video (not floating on top of it) sidesteps
        the problem entirely instead of fighting it.

        FullscreenVideoHost starts empty - MainWindow.axaml.cs moves the
        SAME EditorVideoView control into it on entry (and back on exit)
        instead of using a second VideoView. Hot-swapping MediaPlayer
        between two separate native VideoView surfaces never actually
        rendered a frame into the new one; reparenting the one control
        that's already playing sidesteps that entirely.
      -->
      <Grid RowDefinitions="*,Auto">
        <!-- Pan slider lives in its OWN column, not overlapping
             FullscreenVideoHost - VideoView is a native child window that
             always paints over Avalonia-rendered siblings regardless of
             z-order ("airspace", see the comment block above), so an
             Avalonia Slider stacked on top of it would be invisible/
             unclickable whenever the video view is actually present. Same
             reason the playbar below sits in its own row instead of
             floating over the video. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
          <!-- ClipToBounds - scroll-zoom scales EditorVideoView past its own
               cell via RenderTransform; without this the zoomed picture
               would bleed out over the pan-slider column instead of just
               filling this pane. -->
          <Grid x:Name="FullscreenVideoHost" Grid.Column="0" ClipToBounds="True" PointerWheelChanged="VideoHost_OnPointerWheelChanged" />
          <Slider Grid.Column="1"
                  Orientation="Vertical"
                  Minimum="-1" Maximum="1"
                  Value="{Binding VideoPanY, Mode=TwoWay}"
                  Width="36"
                  Margin="4,24"
                  IsVisible="{Binding IsVideoZoomed}" />
        </Grid>
        <StackPanel Grid.Row="1">
          <Border Height="14" Background="Transparent" Cursor="Hand"
                  PointerPressed="FullscreenProgressBar_OnPointerPressed" VerticalAlignment="Center">
            <ProgressBar Minimum="0" Maximum="{Binding Duration.TotalSeconds}" Value="{Binding CurrentTime.TotalSeconds}"
                         Height="3" Padding="0" BorderThickness="0" CornerRadius="0" VerticalAlignment="Center"
                         Background="#33FFFFFF" Foreground="{StaticResource AccentBrush}" IsHitTestVisible="False" />
          </Border>
          <Border Background="#0B0F14" Padding="14,10">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <Button Classes="transportButton" Click="RestartButton_OnClick" ToolTip.Tip="Restart">
                <PathIcon Width="16" Height="16" Foreground="#C8D6E6" Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" />
              </Button>
              <Button Classes="transportButton" Click="StepBackButton_OnClick" ToolTip.Tip="Step back">
                <PathIcon Width="16" Height="16" Foreground="#C8D6E6" Data="M16 5v14L5 12Z" />
              </Button>
              <Button Classes="playButton" Click="PlayPauseButton_OnClick" ToolTip.Tip="Play/Pause">
                <Grid>
                  <PathIcon Width="16" Height="16" Foreground="#DDE8F6" Data="M8 5v14l11-7z" IsVisible="{Binding !IsPlaying}" />
                  <PathIcon Width="16" Height="16" Foreground="#DDE8F6" Data="M6 19h4V5H6v14zm8-14v14h4V5h-4z" IsVisible="{Binding IsPlaying}" />
                </Grid>
              </Button>
              <Button Classes="transportButton" Click="StepForwardButton_OnClick" ToolTip.Tip="Step forward">
                <PathIcon Width="16" Height="16" Foreground="#C8D6E6" Data="M8 5v14l11-7z" />
              </Button>
              <Button Classes="transportButton" Click="EndButton_OnClick" ToolTip.Tip="End">
                <PathIcon Width="16" Height="16" Foreground="#C8D6E6" Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" />
              </Button>
              <Border Width="1" Height="20" Background="#26FFFFFF" Margin="4,0" />
              <Border Classes="muteToggle"
                      Width="26"
                      Height="26"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      PointerPressed="MasterVolumeMuteToggle_OnPointerPressed"
                      Cursor="Hand"
                      ToolTip.Tip="Mute/unmute">
                <PathIcon Width="15"
                          Height="15"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{Binding IsMasterMuted, Converter={x:Static opconv:BoolToMuteBrushConverter.Instance}}"
                          Data="{Binding EffectiveMasterVolumePercent, Converter={x:Static opconv:VolumeLevelToIconConverter.Instance}}" />
              </Border>
              <Slider Classes="volumeSlider" Minimum="0" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True" Width="90" VerticalAlignment="Center"
                      Value="{Binding MasterVolumePercent, Mode=TwoWay}"
                      Opacity="{Binding IsMasterMuted, Converter={x:Static opconv:BoolToOpacityConverter.Instance}}" />
              <TextBlock Text="{Binding MasterVolumePercent, StringFormat={}{0:0}%}"
                         Foreground="#C8D6E6"
                         FontSize="11"
                         Width="30"
                         Margin="0,2,0,0"
                         VerticalAlignment="Center" />
              <!-- IsEnabled, not IsVisible - this sits inside a
                   HorizontalAlignment="Center" StackPanel, so collapsing its
                   layout space on hide would re-center the whole row and
                   shift every button in it (Restart through Exit). Always
                   laid out at the same size; IsEnabled=False just greys it
                   out (the global Button:disabled style) and blocks the
                   click, at 100% where there's nothing to reset. -->
              <Button Classes="linkButton"
                      Content="Reset"
                      FontSize="10"
                      Padding="6,1"
                      VerticalAlignment="Center"
                      IsEnabled="{Binding IsMasterVolumeNonDefault}"
                      Click="MasterVolumeReset_OnClick"
                      ToolTip.Tip="Reset to 100%" />
              <Border Width="1" Height="20" Background="#26FFFFFF" Margin="4,0" />
              <Button Classes="transportButton" Click="ExitVideoFullscreenButton_OnClick" ToolTip.Tip="Exit fullscreen">
                <PathIcon Width="14" Height="14" Foreground="#C8D6E6" Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Held over the whole window while the startup loader is in front of it,
         so what sits behind the loader is the app's own empty surface rather
         than a library assembling itself in public. Lifted, with a short fade,
         the moment the loader closes. -->
    <Border x:Name="StartupCurtain"
            Grid.Row="0" Grid.RowSpan="2"
            Background="#0D1116"
            IsVisible="False"
            IsHitTestVisible="True"
            ZIndex="1000" />
  </Grid>
</Window>
