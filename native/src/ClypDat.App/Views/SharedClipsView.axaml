<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:vm="using:ClypDat.App.ViewModels"
             x:Class="ClypDat.App.Views.SharedClipsView"
             x:DataType="vm:MainWindowViewModel">
  <!-- Clips shared as links, from clypdat.xyz. Same page shell as Help &
       support: a heading row, then cards in a responsive grid. -->
  <UserControl.Styles>
    <Style Selector="Border.sharedCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Margin" Value="6" />
    </Style>
    <Style Selector="TextBlock.sharedDescription">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <StreamGeometry x:Key="SharedLinkMark">M106.85 99.61A5.04 5.04 0 0 0 102.44 97L26.04 97A5.04 5.04 0 0 1 21 91.96L21 26.04A5.04 5.04 0 0 1 26.04 21L84.6 21A5.04 5.04 0 0 1 89.02 23.61L151.05 136.39A5.04 5.04 0 0 0 155.46 139L248.1 139A37.8 37.8 0 0 0 285.9 101.2L285.9 16.8A37.8 37.8 0 0 0 248.1 -21L144.91 -21A5.04 5.04 0 0 0 140.49 -13.53L158.05 18.39A5.04 5.04 0 0 0 162.46 21L238.86 21A5.04 5.04 0 0 1 243.9 26.04L243.9 91.96A5.04 5.04 0 0 1 238.86 97L180.3 97A5.04 5.04 0 0 1 175.88 94.39L113.85 -18.39A5.04 5.04 0 0 0 109.44 -21L16.8 -21A37.8 37.8 0 0 0 -21 16.8L-21 101.2A37.8 37.8 0 0 0 16.8 139L119.99 139A5.04 5.04 0 0 0 124.41 131.53Z</StreamGeometry>
  </UserControl.Resources>

  <ScrollViewer Background="{DynamicResource PanelBgBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Border Padding="32">
      <StackPanel MaxWidth="1400" Spacing="20">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="6">
            <TextBlock Text="Shared clips" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextStrongBrush}" />
            <TextBlock Classes="sharedDescription" FontSize="14"
                       Text="Clips you've shared as links. Anyone with a link can watch it, and deleting a clip stops its link working." />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
            <TextBlock Text="{Binding SharedClipsStorageLabel}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextSubtleBrush}" />
          </Border>
          <Button Grid.Column="2" Content="Refresh" Click="Refresh_OnClick" IsEnabled="{Binding !SharedClipsLoading}" VerticalAlignment="Center" />
        </Grid>

        <Border Classes="settingsNotice" IsVisible="{Binding SharedClipsHasMessage}">
          <TextBlock Classes="settingsNoticeText" Text="{Binding SharedClipsMessage}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,40,0,0"
                    IsVisible="{Binding SharedClipsLoading}">
          <controls:ClypDatLoader Width="22" Height="22" />
          <TextBlock Classes="sharedDescription" Text="Loading your shared clips…" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,48,0,0" MaxWidth="420" IsVisible="{Binding SharedClipsEmpty}">
          <Path Data="{StaticResource SharedLinkMark}" Fill="{DynamicResource TextSubtleBrush}" Width="44" Height="23" Stretch="Uniform" HorizontalAlignment="Center" />
          <TextBlock Text="Nothing shared yet" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" HorizontalAlignment="Center" />
          <TextBlock Classes="sharedDescription" TextAlignment="Center"
                     Text="Press Get link in Share, or the link button on a clip in your library, and it shows up here." />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding SharedClips}" Margin="-6" IsVisible="{Binding !SharedClipsLoading}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:ResponsiveUniformGrid MaximumColumns="5" MinimumItemWidth="260" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SharedClipViewModel">
              <Border Classes="sharedCard">
                <StackPanel>
                  <controls:AspectRatioBox AspectRatio="1.7777777777777777">
                    <Panel Background="{DynamicResource SurfaceRaisedBrush}">
                      <Path Data="{StaticResource SharedLinkMark}" Fill="{DynamicResource EdgeStrongBrush}" Width="40" Height="21" Stretch="Uniform"
                            HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}" />
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                    </Panel>
                  </controls:AspectRatioBox>
                  <StackPanel Margin="14,12,14,14" Spacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextStrongBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource TextSubtleBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Open" Tag="{Binding}" Click="Open_OnClick" Margin="0,0,6,6" ToolTip.Tip="Open the clip's page in your browser." />
                      <Button Content="{Binding CopyLabel}" Tag="{Binding}" Click="Copy_OnClick" Margin="0,0,6,6" />
                      <Button Content="{Binding DeleteLabel}" Tag="{Binding}" Click="Delete_OnClick" Margin="0,0,6,6" IsEnabled="{Binding !IsBusy}"
                              Classes.dangerButton="{Binding ConfirmingDelete}" />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </ScrollViewer>
</UserControl>
