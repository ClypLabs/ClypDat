<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:vm="using:ClypDat.App.ViewModels"
             x:Class="ClypDat.App.Views.SharedClipsView"
             x:DataType="vm:MainWindowViewModel">
  <!-- Clips shared as links, from clypdat.xyz. The cards follow the library's
       clip tiles (same surfaces, radius, duration pill and footer), so a shared
       clip reads as the same object it was in the library. -->
  <UserControl.Styles>
    <Style Selector="Border.sharedCard">
      <Setter Property="Background" Value="{StaticResource Surface_24303A}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Margin" Value="7" />
      <Setter Property="BoxShadow" Value="0 6 18 -6 #66000000" />
    </Style>
    <!-- Smaller than the library's share button: three of them share the footer. -->
    <Style Selector="Button.sharedIconButton">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{StaticResource Surface_2A3844}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sharedIconButton:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface_31485B}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.sharedIconButton PathIcon">
      <Setter Property="Foreground" Value="{StaticResource Text_C8D9E9}" />
    </Style>
    <!-- Delete, armed: one more click deletes the clip and its link. -->
    <Style Selector="Button.sharedIconButton.confirming">
      <Setter Property="Background" Value="#40E5484D" />
    </Style>
    <Style Selector="Button.sharedIconButton.confirming:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#66E5484D" />
    </Style>
    <Style Selector="Button.sharedIconButton.confirming PathIcon">
      <Setter Property="Foreground" Value="#FF8A8F" />
    </Style>
    <Style Selector="Button.sharedIconButton.done PathIcon">
      <Setter Property="Foreground" Value="{StaticResource AccentSelectedIconBrush}" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <StreamGeometry x:Key="SharedLinkMark">M106.85 99.61A5.04 5.04 0 0 0 102.44 97L26.04 97A5.04 5.04 0 0 1 21 91.96L21 26.04A5.04 5.04 0 0 1 26.04 21L84.6 21A5.04 5.04 0 0 1 89.02 23.61L151.05 136.39A5.04 5.04 0 0 0 155.46 139L248.1 139A37.8 37.8 0 0 0 285.9 101.2L285.9 16.8A37.8 37.8 0 0 0 248.1 -21L144.91 -21A5.04 5.04 0 0 0 140.49 -13.53L158.05 18.39A5.04 5.04 0 0 0 162.46 21L238.86 21A5.04 5.04 0 0 1 243.9 26.04L243.9 91.96A5.04 5.04 0 0 1 238.86 97L180.3 97A5.04 5.04 0 0 1 175.88 94.39L113.85 -18.39A5.04 5.04 0 0 0 109.44 -21L16.8 -21A37.8 37.8 0 0 0 -21 16.8L-21 101.2A37.8 37.8 0 0 0 16.8 139L119.99 139A5.04 5.04 0 0 0 124.41 131.53Z</StreamGeometry>
    <StreamGeometry x:Key="OpenGlyph">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</StreamGeometry>
    <StreamGeometry x:Key="DeleteGlyph">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
    <StreamGeometry x:Key="CheckGlyph">M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59Z</StreamGeometry>
    <StreamGeometry x:Key="RefreshGlyph">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
  </UserControl.Resources>

  <ScrollViewer Background="{DynamicResource PanelBgBrush}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,28" Spacing="16">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14">
        <StackPanel Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="Shared clips" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Text_EDF4FB}" />
          <TextBlock Text="Anyone with a link can watch the clip. Deleting it stops the link working."
                     FontSize="12" Foreground="{StaticResource Text_8C98A7}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <!-- The plan's storage, as a bar: the same figure as Settings > Account. -->
        <StackPanel Grid.Column="1" Spacing="6" Width="200" VerticalAlignment="Center">
          <TextBlock Text="{Binding SharedClipsStorageLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Text_B8C7D8}" HorizontalAlignment="Right" />
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ClipStoragePercent}" Height="4" MinWidth="0" CornerRadius="2" />
        </StackPanel>
        <Button Grid.Column="2" Classes="sharedIconButton" Click="Refresh_OnClick" IsEnabled="{Binding !SharedClipsLoading}"
                ToolTip.Tip="Refresh" VerticalAlignment="Center">
          <PathIcon Data="{StaticResource RefreshGlyph}" Width="15" Height="15" />
        </Button>
      </Grid>

      <Border Classes="settingsNotice" IsVisible="{Binding SharedClipsHasMessage}">
        <TextBlock Classes="settingsNoticeText" Text="{Binding SharedClipsMessage}" TextWrapping="Wrap" />
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,60,0,0" IsVisible="{Binding SharedClipsLoading}">
        <controls:ClypDatLoader Width="22" Height="22" />
        <TextBlock Text="Loading your shared clips…" FontSize="13" Foreground="{StaticResource Text_8C98A7}" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,72,0,0" MaxWidth="380" IsVisible="{Binding SharedClipsEmpty}">
        <PathIcon Data="{StaticResource SharedLinkMark}" Foreground="{StaticResource Text_5C6D7E}" Width="40" Height="40" HorizontalAlignment="Center" />
        <TextBlock Text="Nothing shared yet" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text_EDF4FB}" HorizontalAlignment="Center" />
        <TextBlock Text="Press the link button on a clip in your library, or Get link in Share, and it shows up here."
                   FontSize="13" Foreground="{StaticResource Text_8C98A7}" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>

      <ItemsControl ItemsSource="{Binding SharedClips}" Margin="-7" IsVisible="{Binding !SharedClipsLoading}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:ResponsiveUniformGrid MaximumColumns="6" MinimumItemWidth="250" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SharedClipViewModel">
            <Border Classes="sharedCard">
              <Grid RowDefinitions="Auto,Auto">
                <controls:AspectRatioBox AspectRatio="1.7777777777777777">
                  <Panel Background="{StaticResource Surface_16202A}" Cursor="Hand" Tag="{Binding}" PointerPressed="Thumbnail_OnPointerPressed"
                         ToolTip.Tip="Open in your browser">
                    <PathIcon Data="{StaticResource SharedLinkMark}" Foreground="{StaticResource Text_5C6D7E}" Width="34" Height="34"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasThumbnail}" />
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                    <Border Background="{StaticResource Surface_1A2530}" CornerRadius="14" Padding="8,4" Margin="10"
                            HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding HasDuration}" IsHitTestVisible="False">
                      <TextBlock Text="{Binding DurationLabel}" Foreground="{StaticResource Text_D8E2EE}" FontSize="12" FontWeight="Bold" />
                    </Border>
                  </Panel>
                </controls:AspectRatioBox>
                <Border Grid.Row="1" Background="{StaticResource Surface_1E2A35}" Padding="14,10,10,10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Text_EDF4FB}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Details}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text_8C98A7}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Classes="sharedIconButton" Tag="{Binding}" Click="Open_OnClick" ToolTip.Tip="Open in your browser">
                        <PathIcon Data="{StaticResource OpenGlyph}" Width="14" Height="14" />
                      </Button>
                      <Button Classes="sharedIconButton" Classes.done="{Binding Copied}" Tag="{Binding}" Click="Copy_OnClick" ToolTip.Tip="{Binding CopyLabel}">
                        <Panel>
                          <PathIcon Data="{StaticResource SharedLinkMark}" Width="17" Height="17" IsVisible="{Binding !Copied}" />
                          <PathIcon Data="{StaticResource CheckGlyph}" Width="15" Height="15" IsVisible="{Binding Copied}" />
                        </Panel>
                      </Button>
                      <Button Classes="sharedIconButton" Classes.confirming="{Binding ConfirmingDelete}" Tag="{Binding}" Click="Delete_OnClick"
                              IsEnabled="{Binding !IsBusy}" ToolTip.Tip="{Binding DeleteLabel}">
                        <PathIcon Data="{StaticResource DeleteGlyph}" Width="14" Height="14" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
