<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ClypDat.App.ViewModels" xmlns:opconv="using:ClypDat.App.Converters" xmlns:conv="using:Avalonia.Data.Converters" x:Class="ClypDat.App.Views.Settings.XboxSection" x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Connected Accounts">
      <Binding Path="SettingsSearchText" /><Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="18" Tag="Connected Accounts">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="4"><TextBlock Classes="settingsSectionTitle" Text="Connected Accounts" /><TextBlock Classes="settingsSectionDesc" Text="Link gaming accounts that can provide activity for Desktop Capture clips and Discord Rich Presence." /><Border Classes="settingsDivider" Margin="0,14,0,0" /></StackPanel>
    <Border Classes="settingsCard"><StackPanel Spacing="14">
      <TextBlock Classes="settingsCardLabel" Text="CLYPDAT ACCOUNT" />
      <TextBlock Classes="settingsRowDescSm" Text="Sign in to your ClypDat account to connect it to this app." TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="Link ClypDat account" /><TextBlock Classes="settingsRowDescSm" Text="{Binding ClypDatAccountStatus}" TextWrapping="Wrap" /></StackPanel>
        <Button Grid.Column="1" Classes="primaryButton" Content="Link account" Click="LinkClypDatButton_OnClick" IsVisible="{Binding ClypDatAccountIsConnected, Converter={x:Static conv:BoolConverters.Not}}" IsEnabled="{Binding ClypDatAccountCanLink}" />
      </Grid>
      <Button Content="Create or sign in first" Click="CreateClypDatButton_OnClick" IsVisible="{Binding ClypDatAccountIsConnected, Converter={x:Static conv:BoolConverters.Not}}" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding ClypDatAccountIsConnected}">
        <StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="ClypDat account" /><TextBlock Classes="settingsRowDescSm" Text="Signed in to ClypDat" /></StackPanel>
        <Button Grid.Column="1" Content="Sign out" Click="UnlinkClypDatButton_OnClick" />
      </Grid>
    </StackPanel></Border>
    <Border Classes="settingsCard"><StackPanel Spacing="14">
      <TextBlock Classes="settingsCardLabel" Text="XBOX ACCOUNT" />
      <TextBlock Classes="settingsRowDescSm" Text="Link your Xbox account to send game activity to Desktop Capture clips and Discord Rich Presence." TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding ClypDatAccountIsConnected}">
        <StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="Xbox account" /><TextBlock Classes="settingsRowDescSm" Text="{Binding ClypDatXboxStatus}" /></StackPanel>
        <Button Grid.Column="1" Classes="primaryButton" Content="Link Xbox" Click="CreateClypDatButton_OnClick" IsVisible="{Binding ClypDatXboxIsLinked, Converter={x:Static conv:BoolConverters.Not}}" />
        <Button Grid.Column="1" Content="Unlink Xbox" Click="UnlinkClypDatXboxButton_OnClick" IsVisible="{Binding ClypDatXboxIsLinked}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding ClypDatXboxIsLinked}">
        <StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="Status" /><TextBlock Classes="settingsRowDescSm" Text="{Binding ClypDatAccountStatus}" /></StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding ClypDatXboxIsLinked}">
        <StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="Current title" /><TextBlock Classes="settingsRowDescSm" Text="{Binding XboxCurrentTitle}" /></StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding ClypDatXboxIsLinked}"><StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="Use Xbox activity for Desktop Capture" /><TextBlock Classes="settingsRowDescSm" Text="PC Game Capture remains higher priority." /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding XboxActivityForDesktop}" /></Grid>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
