<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:ClypDat.App.ViewModels" xmlns:opconv="using:ClypDat.App.Converters" xmlns:conv="using:Avalonia.Data.Converters" x:Class="ClypDat.App.Views.Settings.XboxSection" x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Connected Accounts">
      <Binding Path="SettingsSearchText" /><Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="18" Tag="Connected Accounts">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="4"><TextBlock Classes="settingsSectionTitle" Text="Connected Accounts" /><TextBlock Classes="settingsSectionDesc" Text="Link gaming accounts that can provide activity for Desktop Capture clips and Discord Rich Presence." /><Border Classes="settingsDivider" Margin="0,14,0,0" /></StackPanel>
    <Border Classes="settingsCard"><StackPanel Spacing="14">
      <TextBlock Classes="settingsCardLabel" Text="XBOX ACCOUNT" />
      <TextBlock Classes="settingsRowDescSm" Text="Sign in through Microsoft’s browser page. ClypDat never receives your password." TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="Status" /><TextBlock Classes="settingsRowDescSm" Text="{Binding XboxConnectionStatus}" /></StackPanel>
        <Button Grid.Column="1" Classes="primaryButton" Content="Link Xbox" Click="LinkButton_OnClick" IsVisible="{Binding XboxIsConnected, Converter={x:Static conv:BoolConverters.Not}}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding XboxIsConnected}">
        <StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="Current title" /><TextBlock Classes="settingsRowDescSm" Text="{Binding XboxCurrentTitle}" /></StackPanel>
        <Button Grid.Column="1" Content="Unlink" Click="UnlinkButton_OnClick" />
      </Grid>
      <Border Classes="settingsDivider" />
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="2"><TextBlock Classes="settingsRowTitle" Text="Use Xbox activity for Desktop Capture" /><TextBlock Classes="settingsRowDescSm" Text="PC Game Capture remains higher priority." /></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding XboxActivityForDesktop}" IsEnabled="{Binding XboxIsConnected}" /></Grid>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
