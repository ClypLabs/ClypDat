<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             xmlns:settings="using:ClypDat.App.Views.Settings"
             x:Class="ClypDat.App.Views.Settings.SettingsPanel"
             x:DataType="vm:MainWindowViewModel">
  <Border Background="{StaticResource PanelBgBrush}">
    <Grid ColumnDefinitions="224,*,Auto" RowDefinitions="Auto,*">
      <Border Grid.Column="0" Grid.RowSpan="2" Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <TextBox Grid.Row="0" x:Name="SettingsSearchBox" Classes="settingsInput appSearchBox" Text="{Binding SettingsSearchText}" PlaceholderText="Search settings" Margin="12,16,12,12" VerticalContentAlignment="Center">
            <TextBox.InnerLeftContent>
              <Canvas Width="16" Height="16" Margin="10,0,2,0" VerticalAlignment="Center">
                <Ellipse Canvas.Left="0" Canvas.Top="0" Width="11" Height="11" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6" />
                <Line StartPoint="9,9" EndPoint="15,15" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
              </Canvas>
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button Classes="searchClear" Click="ClearSettingsSearchButton_OnClick"
                      IsVisible="{Binding SettingsSearchText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                      ToolTip.Tip="Clear search">
                <Canvas Width="12" Height="12">
                  <Line StartPoint="1,1" EndPoint="11,11" Stroke="{StaticResource TextSubtleBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
                  <Line StartPoint="11,1" EndPoint="1,11" Stroke="{StaticResource TextSubtleBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
                </Canvas>
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,0,12,16" Spacing="16">
            <StackPanel Spacing="2" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter='General|Game Detection|Import Clips|Connected Accounts'}">
              <TextBlock Classes="settingsNavSectionLabel" Text="General" Margin="12,0,12,6" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=General}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=General}" Tag="General" Content="General" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Game Detection}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Game Detection}" Tag="Game Detection" Content="Game Detection" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Import Clips}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Import Clips}" Tag="Import Clips" Content="Import Clips" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Connected Accounts}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Connected Accounts}" Tag="Connected Accounts" Content="Connected Accounts" Click="SettingsNavButton_OnClick" />
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter='Replay Buffer|Video Overlays|Custom Game Settings|Auto-Clip|Audio|Game Audio Exclusions'}">
              <TextBlock Classes="settingsNavSectionLabel" Text="Capture" Margin="12,0,12,6" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Replay Buffer}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Replay Buffer}" Tag="Replay Buffer" Content="Replay Buffer" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Video Overlays}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter='Video Overlays|Camera|Keyboard|Input'}" Tag="Video Overlays" Content="Video Overlays" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Custom Game Settings}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Custom Game Settings}" Tag="Custom Game Settings" Content="Custom Game Settings" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Auto-Clip}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Auto-Clip}" Tag="Auto-Clip" Content="Auto-Clipping" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Audio}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Audio}" Tag="Audio" Content="Audio" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Game Audio Exclusions}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Game Audio Exclusions}" Tag="Game Audio Exclusions" Content="Game Audio Exclusions" Click="SettingsNavButton_OnClick" />
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter='Appearance|Overlays and Notifications|Discord Rich Presence'}">
              <TextBlock Classes="settingsNavSectionLabel" Text="Personalization" Margin="12,0,12,6" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Appearance}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Appearance}" Tag="Appearance" Content="Appearance" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Overlays and Notifications}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Overlays and Notifications}" Tag="Overlays and Notifications" Content="Overlays and Notifications" Click="SettingsNavButton_OnClick" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Discord Rich Presence}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=Discord Rich Presence}" Tag="Discord Rich Presence" Content="Discord Rich Presence" Click="SettingsNavButton_OnClick" />
            </StackPanel>
            <StackPanel Spacing="2" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=About}">
              <TextBlock Classes="settingsNavSectionLabel" Text="About" Margin="12,0,12,6" />
              <Button Classes="settingsNavButton" Classes.active="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=About}" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchMatchConverter.Instance}, ConverterParameter=About}" Tag="About" Content="About" Click="SettingsNavButton_OnClick" />
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Reserved outside SettingsScrollViewer: warning remains fixed at
           panel top while Custom Game Settings content scrolls underneath. -->
      <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource PanelBgBrush}"
              IsVisible="{Binding SelectedSettingsSection, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter=Custom Game Settings}">
        <!-- Notice and its underline collapse together. Putting the underline
             on the wrapper instead left a stray hairline across the panel
             whenever this section was open with nothing to warn about. -->
        <!-- FallbackValue: deleting the last custom game leaves the selected
             tab null, and a broken path binding leaves IsVisible at its
             default of true - the notice stayed pinned with no game behind
             it and an empty summary line. -->
        <StackPanel IsVisible="{Binding SelectedCustomGameTab.QualityWarningVisible, FallbackValue=False, TargetNullValue=False}">
        <Border Classes="settingsNotice stickyNotice">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <PathIcon Classes="cautionIcon" VerticalAlignment="Center" Margin="0" />
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
              <TextBlock FontSize="12.5" TextWrapping="Wrap">
                <Run Text="Performance note: " Foreground="{StaticResource CautionBrush}" FontWeight="SemiBold" />
                <Run Text="{Binding SelectedCustomGameTab.QualityWarningSummary}" Foreground="{StaticResource TextStrongBrush}" />
              </TextBlock>
              <TextBlock Classes="settingsRowDescSm" Text="Higher quality can increase encoder load, RAM use, and dropped frames during gameplay." />
            </StackPanel>
            <!-- One recommended action, one dismissal, one opt-out - three
                 identical buttons made the user read all three to find it.
                 The opt-out is the X: it is the rarest choice and the only
                 permanent one, so it earns an icon and a tooltip, not a
                 word-heavy button competing with Fix Now. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Button Classes="primaryButton" Content="Fix Now" Click="FixCustomGameQualityWarningButton_OnClick" />
              <Button Content="Acknowledge" Click="AcknowledgeCustomGameQualityWarningButton_OnClick" />
              <Button Classes="searchClear" Margin="4,0,0,0" ToolTip.Tip="Don't Show Again"
                      Click="HideCustomGameQualityWarningButton_OnClick">
                <Canvas Width="12" Height="12">
                  <Line StartPoint="1,1" EndPoint="11,11" Stroke="{StaticResource TextSubtleBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
                  <Line StartPoint="11,1" EndPoint="1,11" Stroke="{StaticResource TextSubtleBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
                </Canvas>
              </Button>
            </StackPanel>
          </Grid>
        </Border>
        <Border Height="1" Background="{StaticResource EdgeBrush}" />
        </StackPanel>
      </Border>

      <ScrollViewer x:Name="SettingsScrollViewer" Grid.Column="1" Grid.Row="1" Classes="settingsScroll">
        <StackPanel x:Name="SettingsContent" Margin="24" Spacing="20" MaxWidth="960" HorizontalAlignment="Stretch">

          <settings:ReplayBufferSection />
          <settings:VideoOverlaysSection />
          <settings:OverlaysSection />
          <settings:ThemesSection />
          <settings:DiscordRichPresenceSection />
          <settings:GeneralSection />
          <settings:IntegrationsSection />
          <settings:GameDetectionSection />
          <settings:ImportClipsSection />
          <settings:AutoClipSection />
          <settings:AudioSection />
          <settings:CustomGameSection />
          <settings:GameAudioExclusionsSection />
          <settings:AboutSection />

        </StackPanel>
      </ScrollViewer>

      <Panel x:Name="SettingsStatusHost" Grid.Column="2" Grid.RowSpan="2">
        <Border Width="280" Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1,0,0,0" IsVisible="{Binding IsStatusAreaVisible}">
          <ScrollViewer>
            <StackPanel Margin="22,28,22,20">
              <TextBlock Classes="settingsSectionLabel" Text="STATUS" Margin="0,0,0,4" />
              <Border Classes="settingsDivider" Margin="0,10,0,14" />

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Classes="settingsStatusLabel" Text="Replay Buffer" />
                <TextBlock Text="{Binding RecorderStatus}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="16" />
              </StackPanel>

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Classes="settingsStatusLabel" Text="Save hotkey" />
                <TextBlock Text="{Binding HotkeyDisplay}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="16" />
              </StackPanel>

              <Border Classes="settingsDivider" Margin="0,0,0,16" />

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Classes="settingsStatusLabel" Text="Replay length" />
                <TextBlock Text="{Binding SelectedReplayDurationPreset.Label}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="16" />
              </StackPanel>

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Classes="settingsStatusLabel" Text="Resolution / FPS" />
                <TextBlock Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="16">
                  <Run Text="{Binding SelectedReplayResolution.Label}" /><Run Text=" @ " /><Run Text="{Binding SelectedReplayFrameRate}" /><Run Text="fps" />
                </TextBlock>
              </StackPanel>

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Classes="settingsStatusLabel" Text="Bitrate" />
                <TextBlock Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="16">
                  <Run Text="{Binding SelectedReplayBitrateOption}" /><Run Text="bps" />
                </TextBlock>
              </StackPanel>

              <StackPanel Spacing="2" Margin="0,0,0,16">
                <TextBlock Classes="settingsStatusLabel" Text="Codec" />
                <TextBlock Text="{Binding SelectedReplayVideoCodec.Label}" Foreground="{StaticResource TextBrush}" FontWeight="Bold" FontSize="16" />
              </StackPanel>

              <Border Classes="settingsDivider" Margin="0,0,0,16" />

              <StackPanel Spacing="2">
                <TextBlock Classes="settingsStatusLabel" Text="Library folder" />
                <TextBlock Text="{Binding LibraryLocationText}" Foreground="{StaticResource TextSubtleBrush}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Panel>
    </Grid>
  </Border>
</UserControl>
