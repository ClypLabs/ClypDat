<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             xmlns:services="using:ClypDat.App.Services"
             xmlns:controls="using:ClypDat.App.Controls"
             x:Class="ClypDat.App.Views.Settings.ThemesSection"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Appearance">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <UserControl.Resources>
    <!-- One swatch tile for both theme grids. -->
    <DataTemplate x:Key="ThemeSwatchTemplate" x:DataType="services:ThemeOption">
      <Border Width="164" Height="88" CornerRadius="8" Background="{Binding AppBackgroundBrush}" BorderBrush="{Binding SurfaceBrush}" BorderThickness="1" Padding="11">
        <Grid RowDefinitions="*,Auto">
          <Border Background="{Binding SurfaceBrush}" CornerRadius="5" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
            <TextBlock Text="{Binding Label}" Foreground="{Binding LabelTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{Binding AccentBrush}" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="24" Tag="Appearance">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="6">
      <TextBlock Classes="settingsSectionTitle" Text="Appearance" />
      <TextBlock Classes="settingsSectionDesc" Text="Themes, colours and typography." />
    </StackPanel>

    <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Themes|System|ClypDat Blue|Berry|Violet|Emerald|Rose|Amber'}">
      <TextBlock Classes="settingsGroupLabel" Text="PRESET THEMES" />
      <Border Classes="settingsGroupCard">
        <Border Classes="settingsRow static" Padding="17,16,7,6">
          <ListBox Classes="themePresetGrid" SelectionMode="Single" ItemsSource="{Binding ThemeOptions}"
                   SelectedValue="{Binding SelectedThemePreset}" SelectedValueBinding="{Binding Id}"
                   ItemTemplate="{StaticResource ThemeSwatchTemplate}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </Border>
      </Border>
    </StackPanel>

    <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Light|Light mode|Light themes|Light Blue|Light Berry|Light Violet|Light Emerald|Light Rose|Light Amber'}">
      <TextBlock Classes="settingsGroupLabel" Text="LIGHT THEMES" />
      <Border Classes="settingsGroupCard">
        <Border Classes="settingsRow static" Padding="17,16,7,6">
          <ListBox Classes="themePresetGrid" SelectionMode="Single" ItemsSource="{Binding LightThemeOptions}"
                   SelectedValue="{Binding SelectedThemePreset}" SelectedValueBinding="{Binding Id}"
                   ItemTemplate="{StaticResource ThemeSwatchTemplate}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
        </Border>
      </Border>
    </StackPanel>

    <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Accent|Accent colour|Windows accent|System accent'}">
      <TextBlock Classes="settingsGroupLabel" Text="ACCENT COLOUR" />
      <Border Classes="settingsGroupCard">
        <!-- Dimmed and disabled under a custom theme: the theme's own accent is
             what gets painted either way, so leaving the toggle live would be
             offering a choice that changes nothing. -->
        <Border Classes="settingsRow" Opacity="{Binding IsCustomThemeSelected, Converter={x:Static opconv:BoolToOpacityConverter.Instance}}">
          <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto,Auto">
            <StackPanel Classes="settingsRowText">
              <TextBlock Classes="settingsRowTitle" Text="Use Windows accent colour" />
              <TextBlock Classes="settingsRowDesc" Text="Follows Settings &gt; Personalization &gt; Colors in Windows. Turn this off to use the selected theme's own accent instead."
                         IsVisible="{Binding !IsCustomThemeSelected}" />
              <TextBlock Classes="settingsRowDesc" Text="A custom theme always uses its own accent colour. Pick a preset theme to follow Windows again."
                         IsVisible="{Binding IsCustomThemeSelected}" />
            </StackPanel>
            <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Center" Background="{StaticResource AccentBrush}" />
            <ToggleSwitch Grid.Column="2" IsChecked="{Binding UseSystemAccentColor}" IsEnabled="{Binding !IsCustomThemeSelected}" OnContent="{x:Null}" OffContent="{x:Null}" />
          </Grid>
        </Border>
      </Border>
    </StackPanel>

    <StackPanel Classes="settingsGroup">
      <TextBlock Classes="settingsGroupLabel" Text="CUSTOM THEMES" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Your themes" />
                <TextBlock Classes="settingsRowDesc" Text="Save base and accent pairs. Click one to switch to it. They stay local to ClypDat." />
              </StackPanel>
              <Button Grid.Column="1" Classes="primaryButton" Content="New theme" Click="NewCustomThemeButton_OnClick" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="settingsRowDivider" />
          <Border Classes="settingsRow static" IsVisible="{Binding IsCustomThemesEmpty}">
            <Grid ColumnDefinitions="40,*" ColumnSpacing="14">
              <Grid Width="40" Height="40">
                <Border Background="{StaticResource AccentSelectedBrush}" CornerRadius="20" />
                <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Grid.Column="1" Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="No custom themes yet" />
                <TextBlock Classes="settingsRowDesc" Text="Start with your current colours, then tune the base and accent live." />
              </StackPanel>
            </Grid>
          </Border>
          <Border Classes="settingsRow static" Padding="18,14,18,6" IsVisible="{Binding !IsCustomThemesEmpty}">
            <ListBox Classes="customThemeList" SelectionMode="Single" ItemsSource="{Binding CustomThemes}" SelectedItem="{Binding SelectedCustomTheme, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                      <Grid Width="44" Height="36">
                        <Border Background="{Binding BaseColor}" CornerRadius="6" />
                        <Border Width="16" Height="16" CornerRadius="8" Background="{Binding AccentColor}" BorderBrush="{StaticResource SurfaceRaisedBrush}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrongBrush}" FontSize="13.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BaseColor}" Foreground="{StaticResource TextSubtleBrush}" FontSize="12" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Classes="linkButton" Tag="{Binding}" Content="Edit" Click="EditCustomThemeButton_OnClick" />
                        <Button Classes="linkButton" Tag="{Binding}" Content="Duplicate" Click="DuplicateCustomThemeButton_OnClick" />
                        <Button Classes="linkButton" Tag="{Binding}" Content="Delete" Click="DeleteCustomThemeButton_OnClick" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Two independent pickers rather than one behind a Base/Accent toggle.
         The toggle meant a single set of picker state stood for whichever colour
         was selected, and a separate "Use colour" button copied it across - so
         the spectrum previewed one colour live while Apply saved another. There
         is no shared state left to disagree, and the settings column had the
         width for both all along. -->
    <!-- Full width like every other card, so its edges line up with the ones
         above and below; the pickers are fixed width (each field is
         square), so they sit centred in it rather than hugging the left edge. -->
    <!-- The field and hue strip are ColorField's, not ColorSpectrum and
         ColorSlider: they compute the colour straight from the pointer, and
         the field only shows colours the theme paints exactly, so the swatch
         is the pixel under the thumb. -->
    <StackPanel Classes="settingsGroup" IsVisible="{Binding IsThemeEditorOpen}">
      <TextBlock Classes="settingsGroupLabel" Text="CUSTOM THEME EDITOR" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow static">
            <StackPanel Spacing="5">
              <TextBlock Classes="settingsFieldLabel" Text="Theme name" />
              <TextBox Classes="settingsInput" Width="280" HorizontalAlignment="Left" Text="{Binding ThemeEditorName, Mode=TwoWay}" PlaceholderText="Theme name" />
            </StackPanel>
          </Border>
          <Border Classes="settingsRowDivider" />
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Light mode" />
                <TextBlock Classes="settingsRowDesc" Text="Paint this theme on a light background. Off keeps it dark, however pale the base colour." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding ThemeEditorLightMode, Mode=TwoWay}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
          <Border Classes="settingsRowDivider" />
          <Border Classes="settingsRow static">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="16" HorizontalAlignment="Center">
              <Border Grid.Column="0" Classes="providerSetting" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Classes="settingsCardLabel" Text="BASE COLOUR" />
                  <Grid ColumnDefinitions="232,20" ColumnSpacing="12">
                    <!-- The field is the band a base is painted in for the current
                         mode (BasePicker.Model), so every point in it is a ground
                         the theme can be, exactly as shown. -->
                    <controls:ColorField Model="{Binding BasePicker.Model}" Hue="{Binding BasePicker.Hue}"
                                         Position="{Binding BasePicker.Position, Mode=TwoWay}" Width="232" Height="232" />
                    <controls:HueStrip Grid.Column="1" Hue="{Binding BasePicker.Hue, Mode=TwoWay}" Height="232" />
                  </Grid>
                  <!-- New over current: current is the colour the editor opened
                       on and a click on it goes back there. Pick screen colour samples any pixel
                       on any monitor (ScreenColorPicker). -->
                  <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="settingsPickerLabel" Text="NEW" HorizontalAlignment="Center" />
                      <Border Height="24" CornerRadius="6,6,0,0" BorderThickness="1,1,1,0" BorderBrush="{StaticResource EdgeStrongBrush}">
                        <Border.Background><SolidColorBrush Color="{Binding BasePicker.ShownColor}" /></Border.Background>
                      </Border>
                      <Button Classes="themeSwatch" Width="64" Height="24" Margin="0,-4,0,0" Tag="{Binding BasePicker}" Click="RestoreCurrentColorButton_OnClick"
                              ToolTip.Tip="Click to go back to this colour">
                        <Border CornerRadius="0,0,6,6"><Border.Background><SolidColorBrush Color="{Binding BasePicker.CurrentColor}" /></Border.Background></Border>
                      </Button>
                      <TextBlock Classes="settingsPickerLabel" Text="CURRENT" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="settingsPickerLabel" Text="HEX" />
                        <TextBox Classes="settingsInput" Text="{Binding BasePicker.HexText, Mode=TwoWay}" PlaceholderText="#RRGGBB" />
                      </StackPanel>
                      <Button Content="Pick screen colour" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Tag="{Binding BasePicker}"
                              IsVisible="{x:Static services:ScreenColorPicker.IsSupported}" Click="PickScreenColorButton_OnClick" />
                    </StackPanel>
                  </Grid>
                  <!-- Labelled, because a placeholder disappears the moment the box
                       has a value in it and three bare numbers say nothing about
                       which channel is which. -->
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="settingsPickerLabel" Text="R" />
                      <TextBox Classes="settingsInput" Text="{Binding BasePicker.RedText, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="settingsPickerLabel" Text="G" />
                      <TextBox Classes="settingsInput" Text="{Binding BasePicker.GreenText, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="settingsPickerLabel" Text="B" />
                      <TextBox Classes="settingsInput" Text="{Binding BasePicker.BlueText, Mode=TwoWay}" />
                    </StackPanel>
                  </Grid>
                  <!-- What the base turns into: it is the window, and the panels and
                       cards on it are each a step away. The base swatch sits on a
                       card, so without these it reads as the wrong colour. -->
                  <StackPanel Spacing="4">
                    <TextBlock Classes="settingsPickerLabel" Text="SHADES" />
                    <ItemsControl ItemsSource="{Binding ThemeEditorShades}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeShade">
                          <StackPanel Spacing="4">
                            <Border Height="24" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource EdgeStrongBrush}">
                              <Border.Background><SolidColorBrush Color="{Binding Color}" /></Border.Background>
                            </Border>
                            <TextBlock Classes="settingsPickerLabel" Text="{Binding Name}" HorizontalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock Classes="settingsRowError" Text="{Binding BasePicker.Error}" MaxWidth="264"
                             IsVisible="{Binding BasePicker.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Spacing="6" IsVisible="{Binding HasRecentThemeColors}">
                    <TextBlock Classes="settingsPickerLabel" Text="RECENT" />
                    <ItemsControl ItemsSource="{Binding RecentThemeColors}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="30" ItemHeight="30" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><Button Classes="themeSwatch" Tag="{Binding}" ToolTip.Tip="{Binding}" Click="BaseRecentThemeColorButton_OnClick"><Border Background="{Binding}" /></Button></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="providerSetting" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Classes="settingsCardLabel" Text="ACCENT COLOUR" />
                  <Grid ColumnDefinitions="232,20" ColumnSpacing="12">
                    <!-- The same, for the accent: only accents that read on the
                         current ground, so it follows the base. -->
                    <controls:ColorField Model="{Binding AccentPicker.Model}" Hue="{Binding AccentPicker.Hue}"
                                         Position="{Binding AccentPicker.Position, Mode=TwoWay}" Width="232" Height="232" />
                    <controls:HueStrip Grid.Column="1" Hue="{Binding AccentPicker.Hue, Mode=TwoWay}" Height="232" />
                  </Grid>
                  <Grid ColumnDefinitions="64,*" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="settingsPickerLabel" Text="NEW" HorizontalAlignment="Center" />
                      <Border Height="24" CornerRadius="6,6,0,0" BorderThickness="1,1,1,0" BorderBrush="{StaticResource EdgeStrongBrush}">
                        <Border.Background><SolidColorBrush Color="{Binding AccentPicker.ShownColor}" /></Border.Background>
                      </Border>
                      <Button Classes="themeSwatch" Width="64" Height="24" Margin="0,-4,0,0" Tag="{Binding AccentPicker}" Click="RestoreCurrentColorButton_OnClick"
                              ToolTip.Tip="Click to go back to this colour">
                        <Border CornerRadius="0,0,6,6"><Border.Background><SolidColorBrush Color="{Binding AccentPicker.CurrentColor}" /></Border.Background></Border>
                      </Button>
                      <TextBlock Classes="settingsPickerLabel" Text="CURRENT" HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="settingsPickerLabel" Text="HEX" />
                        <TextBox Classes="settingsInput" Text="{Binding AccentPicker.HexText, Mode=TwoWay}" PlaceholderText="#RRGGBB" />
                      </StackPanel>
                      <Button Content="Pick screen colour" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Tag="{Binding AccentPicker}"
                              IsVisible="{x:Static services:ScreenColorPicker.IsSupported}" Click="PickScreenColorButton_OnClick" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="settingsPickerLabel" Text="R" />
                      <TextBox Classes="settingsInput" Text="{Binding AccentPicker.RedText, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="settingsPickerLabel" Text="G" />
                      <TextBox Classes="settingsInput" Text="{Binding AccentPicker.GreenText, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="settingsPickerLabel" Text="B" />
                      <TextBox Classes="settingsInput" Text="{Binding AccentPicker.BlueText, Mode=TwoWay}" />
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="settingsRowError" Text="{Binding AccentPicker.Error}" MaxWidth="264"
                             IsVisible="{Binding AccentPicker.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <StackPanel Spacing="6" IsVisible="{Binding HasRecentThemeColors}">
                    <TextBlock Classes="settingsPickerLabel" Text="RECENT" />
                    <ItemsControl ItemsSource="{Binding RecentThemeColors}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="30" ItemHeight="30" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><Button Classes="themeSwatch" Tag="{Binding}" ToolTip.Tip="{Binding}" Click="AccentRecentThemeColorButton_OnClick"><Border Background="{Binding}" /></Button></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Border Classes="settingsRowDivider" />
          <Border Classes="settingsRow static">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
              <StackPanel Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Classes="settingsRowDesc" Text="Apply saves and selects this theme. Close drops anything you haven't applied." />
                <TextBlock Classes="settingsRowError" Text="{Binding ThemeEditorError}" IsVisible="{Binding ThemeEditorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Close" Click="CancelCustomThemeButton_OnClick" />
                <Button Classes="primaryButton" Content="Apply" Click="ApplyCustomThemeButton_OnClick" />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Classes="settingsGroup">
      <TextBlock Classes="settingsGroupLabel" Text="TYPOGRAPHY" />
      <Border Classes="settingsGroupCard">
        <Border Classes="settingsRow">
          <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
            <StackPanel Classes="settingsRowText">
              <TextBlock Classes="settingsRowTitle" Text="App font" />
              <TextBlock Classes="settingsRowDesc" Text="Type a family name or a font filename from C:\Windows\Fonts. Inter restores ClypDat's default." />
            </StackPanel>
            <!-- Bound per keystroke, because the font should appear as soon as its
                 name is typed. What makes that safe is the setter, not the trigger:
                 every prefix of a name arrives here ("C", "Co", "Con"...), and only
                 the ones naming a font that exists are applied or saved. Binding
                 straight through used to repaint the whole window eight times on
                 the way to "Consolas", through seven families that do not exist. -->
            <TextBox Grid.Column="1" Classes="settingsInput" Width="220" VerticalAlignment="Center" Text="{Binding AppFontFamilyName, Mode=TwoWay}" PlaceholderText="Inter" LostFocus="AppFontFamilyBox_OnLostFocus" />
          </Grid>
        </Border>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
