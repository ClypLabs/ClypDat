<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             xmlns:cp="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls.ColorPicker"
             x:Class="ClypDat.App.Views.Settings.ThemesSection"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Appearance">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="18" Tag="Appearance">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="4">
      <TextBlock Classes="settingsSectionTitle" Text="Appearance" />
      <TextBlock Classes="settingsSectionDesc" Text="Themes, colours, and typography." />
      <Border Classes="settingsDivider" Margin="0,14,0,0" />
    </StackPanel>

    <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Themes|System|ClypDat Blue|Berry|Violet|Emerald|Rose|Amber'}">
      <StackPanel Spacing="14">
        <TextBlock Classes="settingsCardLabel" Text="PRESET THEMES" />
        <ListBox Classes="themePresetGrid" SelectionMode="Single" ItemsSource="{Binding ThemeOptions}"
                 SelectedValue="{Binding SelectedThemePreset}" SelectedValueBinding="{Binding Id}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="164" Height="88" CornerRadius="8" Background="{Binding AppBackgroundBrush}" BorderBrush="{Binding SurfaceBrush}" BorderThickness="1" Padding="11">
                <Grid RowDefinitions="*,Auto">
                  <Border Background="{Binding SurfaceBrush}" CornerRadius="5" />
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
                    <TextBlock Text="{Binding Label}" Foreground="{Binding LabelTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{Binding AccentBrush}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Light|Light mode|Light themes|Light Blue|Light Berry|Light Violet|Light Emerald|Light Rose|Light Amber'}">
      <StackPanel Spacing="14">
        <TextBlock Classes="settingsCardLabel" Text="LIGHT THEMES" />
        <ListBox Classes="themePresetGrid" SelectionMode="Single" ItemsSource="{Binding LightThemeOptions}"
                 SelectedValue="{Binding SelectedThemePreset}" SelectedValueBinding="{Binding Id}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="164" Height="88" CornerRadius="8" Background="{Binding AppBackgroundBrush}" BorderBrush="{Binding SurfaceBrush}" BorderThickness="1" Padding="11">
                <Grid RowDefinitions="*,Auto">
                  <Border Background="{Binding SurfaceBrush}" CornerRadius="5" />
                  <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,9,0,0">
                    <TextBlock Text="{Binding Label}" Foreground="{Binding LabelTextBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Background="{Binding AccentBrush}" />
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter='Accent|Accent colour|Windows accent|System accent'}">
      <StackPanel Spacing="14">
        <TextBlock Classes="settingsCardLabel" Text="ACCENT COLOUR" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Spacing="3">
            <TextBlock Classes="settingsRowTitle" Text="Use Windows accent colour" />
            <TextBlock Classes="settingsRowDesc" Text="Follows Settings &gt; Personalization &gt; Colors. Turn this off to use the selected theme's own accent instead." />
          </StackPanel>
          <Border Grid.Column="1" Width="18" Height="18" CornerRadius="9" Margin="16,0,14,0" VerticalAlignment="Center" Background="{StaticResource AccentBrush}" />
          <ToggleSwitch Grid.Column="2" IsChecked="{Binding UseSystemAccentColor}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="settingsCard">
      <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Classes="settingsCardLabel" Text="CUSTOM THEMES" />
            <TextBlock Classes="settingsRowDesc" Text="Save base and accent pairs. They stay local to ClypDat." />
          </StackPanel>
          <Button Grid.Column="1" Classes="primaryButton" Padding="16,9" Content="New theme" Click="NewCustomThemeButton_OnClick" VerticalAlignment="Center" />
        </Grid>
        <Border Height="1" Background="{StaticResource DividerBrush}" />
        <Border IsVisible="{Binding IsCustomThemesEmpty}" Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
          <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="13">
            <Grid Width="46" Height="46"><Border Background="{StaticResource AccentSelectedBrush}" CornerRadius="23" /><Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center"><TextBlock Classes="settingsRowTitle" Text="No custom themes yet" /><TextBlock Classes="settingsRowDesc" Text="Start with your current colours, then tune them live." /></StackPanel>
            <TextBlock Grid.Column="2" Text="Base + accent" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding CustomThemes}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12"><Grid Width="48" Height="40"><Border Background="{Binding BaseColor}" CornerRadius="6" /><Border Width="17" Height="17" CornerRadius="9" Background="{Binding AccentColor}" BorderBrush="{StaticResource AppBgBrush}" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4" /></Grid><StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrongBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding BaseColor}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Tag="{Binding}" Content="Edit" Click="EditCustomThemeButton_OnClick" /><Button Tag="{Binding}" Content="Duplicate" Click="DuplicateCustomThemeButton_OnClick" /><Button Tag="{Binding}" Content="Delete" Click="DeleteCustomThemeButton_OnClick" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </Border>

    <!-- Two independent pickers rather than one behind a Base/Accent toggle.
         The toggle meant a single set of picker state stood for whichever colour
         was selected, and a separate "Use colour" button copied it across - so
         the spectrum previewed one colour live while Apply saved another. There
         is no shared state left to disagree, and the settings column had the
         width for both all along. -->
    <Border Classes="settingsCard" IsVisible="{Binding IsThemeEditorOpen}">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Classes="settingsCardLabel" Text="CUSTOM THEME EDITOR" VerticalAlignment="Center" />
          <TextBox Classes="settingsInput" Width="240" Text="{Binding ThemeEditorName, Mode=TwoWay}" PlaceholderText="Theme name" />
        </StackPanel>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="28">
          <StackPanel Grid.Column="0" Spacing="8">
            <TextBlock Classes="settingsCardLabel" Text="BASE COLOUR" />
            <Grid ColumnDefinitions="*,20" ColumnSpacing="10">
              <!-- Bound on HsvColor, not Color. Dragging into pure black or pure
                   white throws the hue away in RGB, so the hue slider would jump
                   back to red the moment the spectrum reached an edge. -->
              <cp:ColorSpectrum HsvColor="{Binding BasePicker.HsvColor, Mode=TwoWay}" Components="SaturationValue" Shape="Box" MinWidth="200" Height="200" CornerRadius="6" />
              <cp:ColorSlider Grid.Column="1" HsvColor="{Binding BasePicker.HsvColor, Mode=TwoWay}" ColorModel="Hsva" ColorComponent="Component1" Orientation="Vertical" Height="200" IsAlphaVisible="False" />
            </Grid>
            <TextBox Classes="settingsInput" Text="{Binding BasePicker.HexText, Mode=TwoWay}" PlaceholderText="#RRGGBB" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <TextBox Classes="settingsInput" Text="{Binding BasePicker.RedText, Mode=TwoWay}" PlaceholderText="R" />
              <TextBox Grid.Column="1" Classes="settingsInput" Text="{Binding BasePicker.GreenText, Mode=TwoWay}" PlaceholderText="G" />
              <TextBox Grid.Column="2" Classes="settingsInput" Text="{Binding BasePicker.BlueText, Mode=TwoWay}" PlaceholderText="B" />
            </Grid>
            <TextBlock Foreground="{StaticResource DangerBrush}" Text="{Binding BasePicker.Error}" IsVisible="{Binding BasePicker.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding RecentThemeColors}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="28" ItemHeight="28" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate><Button Classes="themeSwatch" Tag="{Binding}" ToolTip.Tip="{Binding}" Click="BaseRecentThemeColorButton_OnClick"><Border Background="{Binding}" /></Button></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Classes="settingsCardLabel" Text="ACCENT COLOUR" />
            <Grid ColumnDefinitions="*,20" ColumnSpacing="10">
              <cp:ColorSpectrum HsvColor="{Binding AccentPicker.HsvColor, Mode=TwoWay}" Components="SaturationValue" Shape="Box" MinWidth="200" Height="200" CornerRadius="6" />
              <cp:ColorSlider Grid.Column="1" HsvColor="{Binding AccentPicker.HsvColor, Mode=TwoWay}" ColorModel="Hsva" ColorComponent="Component1" Orientation="Vertical" Height="200" IsAlphaVisible="False" />
            </Grid>
            <TextBox Classes="settingsInput" Text="{Binding AccentPicker.HexText, Mode=TwoWay}" PlaceholderText="#RRGGBB" />
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
              <TextBox Classes="settingsInput" Text="{Binding AccentPicker.RedText, Mode=TwoWay}" PlaceholderText="R" />
              <TextBox Grid.Column="1" Classes="settingsInput" Text="{Binding AccentPicker.GreenText, Mode=TwoWay}" PlaceholderText="G" />
              <TextBox Grid.Column="2" Classes="settingsInput" Text="{Binding AccentPicker.BlueText, Mode=TwoWay}" PlaceholderText="B" />
            </Grid>
            <TextBlock Foreground="{StaticResource DangerBrush}" Text="{Binding AccentPicker.Error}" IsVisible="{Binding AccentPicker.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ItemsControl ItemsSource="{Binding RecentThemeColors}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="28" ItemHeight="28" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate><Button Classes="themeSwatch" Tag="{Binding}" ToolTip.Tip="{Binding}" Click="AccentRecentThemeColorButton_OnClick"><Border Background="{Binding}" /></Button></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
        <Border Classes="settingsDivider" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
          <StackPanel Spacing="6" VerticalAlignment="Center">
            <TextBlock Classes="settingsRowDescSm" Text="Apply saves this theme and selects it, leaving the editor open so you can keep tuning. Close repaints from what is saved, so anything not applied is dropped." />
            <TextBlock Foreground="{StaticResource DangerBrush}" Text="{Binding ThemeEditorError}" IsVisible="{Binding ThemeEditorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="primaryButton" Content="Apply" Click="ApplyCustomThemeButton_OnClick" />
            <Button Content="Close" Click="CancelCustomThemeButton_OnClick" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="settingsCard"><StackPanel Spacing="10"><TextBlock Classes="settingsCardLabel" Text="TYPOGRAPHY" /><TextBlock Classes="settingsRowDesc" Text="Type a family name or font filename from C:\Windows\Fonts. Inter restores ClypDat's default." /><TextBox Classes="settingsInput" Text="{Binding AppFontFamilyName, Mode=TwoWay}" PlaceholderText="Inter" /></StackPanel></Border>
  </StackPanel>
</UserControl>
