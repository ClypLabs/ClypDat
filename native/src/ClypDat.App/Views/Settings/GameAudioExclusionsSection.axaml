<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             x:Class="ClypDat.App.Views.Settings.GameAudioExclusionsSection"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Game Audio Exclusions">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="24" Tag="Game Audio Exclusions">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="6">
      <TextBlock Classes="settingsSectionTitle" Text="Game audio exclusions" />
      <TextBlock Classes="settingsSectionDesc" Text="Apps listed here are left out of the Game Audio track." />
    </StackPanel>

    <StackPanel Classes="settingsGroup">
      <TextBlock Classes="settingsGroupLabel" Text="EXCLUDED APPS" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow static">
            <StackPanel Spacing="10">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Add a running app" />
                <TextBlock Classes="settingsRowDesc" Text="Pick an app that's open right now." />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <ComboBox Classes="settingsInput" ItemsSource="{Binding OpenProcesses}" SelectedItem="{Binding SelectedProcessExclusion}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" />
                <Button Grid.Column="2" Classes="primaryButton" Content="Add" Click="AddSelectedProcessButton_OnClick" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="settingsRowDivider" />
          <Border Classes="settingsRow static">
            <StackPanel Spacing="10">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Add by name" />
                <TextBlock Classes="settingsRowDesc" Text="Type the app's process name, including .exe." />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Name="ExcludedProcessTextBox" Classes="settingsInput" PlaceholderText="discord.exe" />
                <Button Grid.Column="1" Content="Add" Click="AddExcludedProcessButton_OnClick" />
              </Grid>
            </StackPanel>
          </Border>
          <ScrollViewer Classes="listScrollCompact">
            <ItemsControl ItemsSource="{Binding ExcludedProcesses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="settingsListItem">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <TextBlock Classes="settingsListItemText" Text="{Binding}" />
                      <Button Grid.Column="1" Classes="linkButton" Content="Remove" VerticalAlignment="Center" Click="RemoveExcludedProcessButton_OnClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
