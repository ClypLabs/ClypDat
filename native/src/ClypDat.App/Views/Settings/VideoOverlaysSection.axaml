<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             x:Class="ClypDat.App.Views.Settings.VideoOverlaysSection"
             x:DataType="vm:VideoOverlayViewModel"
             IsVisible="False" Focusable="True" KeyDown="Section_OnKeyDown">
  <UserControl.Resources>
    <!-- What a corner will actually burn in, drawn once and shared by the four
         corner cards. Every corner used to draw the same generic key grid with
         the source name printed across it, so an empty corner looked like a
         keyboard and the name was unreadable over the keycaps. -->
    <DataTemplate x:Key="VideoOverlayEmptyMock">
      <Grid Margin="11,9">
        <Rectangle Classes="videoOverlayEmptyMock" />
        <TextBlock Classes="videoOverlayEmptyLabel" Text="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="VideoOverlayCameraMock">
      <Border Classes="videoOverlayCameraMock">
        <Ellipse Classes="videoOverlayLensMock" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="VideoOverlayKeyboardMock">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="11,9">
        <UniformGrid Rows="3" Columns="8">
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
          <Border Classes="videoOverlayKeyMock" />
        </UniformGrid>
        <Border Grid.Column="1" Classes="videoOverlayMouseMock">
          <Border Classes="videoOverlayMouseWheelMock" />
        </Border>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="OverlaySourceOptionTemplate" DataType="vm:OverlaySourceOption">
      <Grid>
        <TextBlock Text="{Binding Name}" IsVisible="{Binding IsSelectable}" />
        <TextBlock Text="{Binding Name}" IsVisible="{Binding IsHeading}" Classes="overlaySourceHeading" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel Spacing="18" Tag="Video Overlays">
    <StackPanel Spacing="4">
      <TextBlock Classes="settingsSectionTitle" Text="Video Overlays" />
      <TextBlock Classes="settingsSectionDesc" Text="Add camera and input layers to recordings. Changes apply without restarting replay capture." />
      <Border Classes="settingsDivider" Margin="0,14,0,0" />
    </StackPanel>
    <Border Classes="settingsCard">
      <StackPanel Spacing="14">
        <TextBlock Classes="settingsCardLabel" Text="VIDEO OVERLAYS" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Classes="settingsRowTitle" Text="Burn camera and input into recordings" /><TextBlock Classes="settingsRowDescSm" Text="Camera audio is never recorded." /></StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
        </Grid>
        <Border Classes="settingsDivider" />
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Classes="settingsRowTitle" Text="Include virtual cameras" /><TextBlock Classes="settingsRowDescSm" Text="Refresh after connecting or changing a camera." /></StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IncludeVirtualCameras}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          <Button Grid.Column="2" Content="Refresh" Click="Refresh_OnClick" VerticalAlignment="Center" />
        </Grid>
        <Border Classes="settingsDivider" />
        <TextBlock Classes="settingsRowDescSm" Text="{Binding SourceStatus}" TextWrapping="Wrap" />
        <TextBlock Classes="settingsCardLabel" Margin="0,6,0,0" Text="VIDEO OVERLAY PREVIEW" />
        <!-- The canvas is scaled art; the corner cards are chrome. They used to
             share one Viewbox, so a 13px label and a 38px dropdown were blown up
             with the canvas, and the canvas itself grew to whatever width the
             settings page had - 880px of empty preview on a wide window. The
             canvas is capped and centred, and the cards are laid over it at
             their own pixel size. -->
        <Grid HorizontalAlignment="Center" MaxWidth="1200">
          <Viewbox Stretch="Uniform">
            <Border Classes="videoOverlayCanvas" Width="960" Height="540">
            <Grid ClipToBounds="True">
              <Border Background="#FF101923" />
              <Canvas Name="PreviewCanvas" Background="Transparent" PointerPressed="PreviewCanvas_OnPointerPressed" PointerMoved="PreviewCanvas_OnPointerMoved" PointerReleased="PreviewCanvas_OnPointerReleased" PointerCaptureLost="PreviewCanvas_OnPointerCaptureLost">
                <Border Classes="videoOverlayLayer" Canvas.Left="{Binding CameraLeft}" Canvas.Top="{Binding CameraTop}" Width="{Binding CameraWidth}" Height="{Binding CameraHeight}" IsVisible="{Binding CameraSelected}" PointerPressed="Layer_OnPointerPressed" Tag="Camera">
                  <Grid><Border Background="#FF233746" /><Border Background="{DynamicResource AccentBrush}" Opacity=".12" /><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"><TextBlock Text="CAMERA" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="Live source" Opacity=".72" HorizontalAlignment="Center" /></StackPanel><Border Classes="videoOverlaySelection" IsVisible="{Binding CameraSelected}" /><Border Classes="videoOverlayHandle topLeft" IsVisible="{Binding CameraSelected}" /><Border Classes="videoOverlayHandle topRight" IsVisible="{Binding CameraSelected}" /><Border Classes="videoOverlayHandle bottomLeft" IsVisible="{Binding CameraSelected}" /><Border Classes="videoOverlayHandle bottomRight" IsVisible="{Binding CameraSelected}" /></Grid>
                </Border>
                <Border Classes="videoOverlayLayer" Canvas.Left="{Binding KeyboardLeft}" Canvas.Top="{Binding KeyboardTop}" Width="{Binding KeyboardWidth}" Height="{Binding KeyboardHeight}" IsVisible="{Binding KeyboardSelected}" PointerPressed="Layer_OnPointerPressed" Tag="Keyboard">
                  <Grid><Border Background="#FF18212B" /><UniformGrid Rows="2" Columns="9" Margin="14" IsHitTestVisible="False"><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /><Border Background="#FF354454" Margin="3" /></UniformGrid><Border Classes="videoOverlaySelection" IsVisible="{Binding KeyboardSelected}" /><Border Classes="videoOverlayHandle topLeft" IsVisible="{Binding KeyboardSelected}" /><Border Classes="videoOverlayHandle topRight" IsVisible="{Binding KeyboardSelected}" /><Border Classes="videoOverlayHandle bottomLeft" IsVisible="{Binding KeyboardSelected}" /><Border Classes="videoOverlayHandle bottomRight" IsVisible="{Binding KeyboardSelected}" /></Grid>
                </Border>
              </Canvas>
            </Grid>
            </Border>
          </Viewbox>
          <Grid x:Name="WidePickers" Margin="18" IsVisible="{Binding ShowPickers}" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">
            <Border Classes="videoOverlayPicker" VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Classes="videoOverlayPickerLabel" Text="TOP LEFT" />
                <Border Classes="videoOverlayPickerPreview" Tag="Top Left" PointerPressed="PickerPreview_OnPointerPressed">
                  <Panel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayEmptyMock}" IsVisible="{Binding TopLeftIsEmpty}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayCameraMock}" IsVisible="{Binding TopLeftIsCamera}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayKeyboardMock}" IsVisible="{Binding TopLeftIsKeyboard}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                  </Panel>
                </Border>
                <ComboBox Classes="settingsInput compact overlaySourcePicker" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource OverlaySourceOptionTemplate}" SelectedItem="{Binding TopLeftSource}" ToolTip.Tip="{Binding TopLeftSource}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="videoOverlayPicker" VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Classes="videoOverlayPickerLabel" Text="TOP RIGHT" />
                <Border Classes="videoOverlayPickerPreview" Tag="Top Right" PointerPressed="PickerPreview_OnPointerPressed">
                  <Panel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayEmptyMock}" IsVisible="{Binding TopRightIsEmpty}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayCameraMock}" IsVisible="{Binding TopRightIsCamera}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayKeyboardMock}" IsVisible="{Binding TopRightIsKeyboard}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                  </Panel>
                </Border>
                <ComboBox Classes="settingsInput compact overlaySourcePicker" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource OverlaySourceOptionTemplate}" SelectedItem="{Binding TopRightSource}" ToolTip.Tip="{Binding TopRightSource}" />
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Classes="videoOverlayPicker" VerticalAlignment="Bottom">
              <StackPanel Spacing="8">
                <TextBlock Classes="videoOverlayPickerLabel" Text="BOTTOM LEFT" />
                <Border Classes="videoOverlayPickerPreview" Tag="Bottom Left" PointerPressed="PickerPreview_OnPointerPressed">
                  <Panel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayEmptyMock}" IsVisible="{Binding BottomLeftIsEmpty}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayCameraMock}" IsVisible="{Binding BottomLeftIsCamera}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayKeyboardMock}" IsVisible="{Binding BottomLeftIsKeyboard}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                  </Panel>
                </Border>
                <ComboBox Classes="settingsInput compact overlaySourcePicker" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource OverlaySourceOptionTemplate}" SelectedItem="{Binding BottomLeftSource}" ToolTip.Tip="{Binding BottomLeftSource}" />
              </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="2" Classes="videoOverlayPicker" VerticalAlignment="Bottom">
              <StackPanel Spacing="8">
                <TextBlock Classes="videoOverlayPickerLabel" Text="BOTTOM RIGHT" />
                <Border Classes="videoOverlayPickerPreview" Tag="Bottom Right" PointerPressed="PickerPreview_OnPointerPressed">
                  <Panel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayEmptyMock}" IsVisible="{Binding BottomRightIsEmpty}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayCameraMock}" IsVisible="{Binding BottomRightIsCamera}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VideoOverlayKeyboardMock}" IsVisible="{Binding BottomRightIsKeyboard}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                  </Panel>
                </Border>
                <ComboBox Classes="settingsInput compact overlaySourcePicker" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource OverlaySourceOptionTemplate}" SelectedItem="{Binding BottomRightSource}" ToolTip.Tip="{Binding BottomRightSource}" />
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
        <Grid x:Name="NarrowPickers" IsVisible="False" IsEnabled="{Binding ShowPickers}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
          <StackPanel Spacing="4"><TextBlock Classes="settingsRowTitleSm" Text="Top left" /><ComboBox Classes="settingsInput overlaySourcePicker" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource OverlaySourceOptionTemplate}" SelectedItem="{Binding TopLeftSource}" /></StackPanel><StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="settingsRowTitleSm" Text="Top right" /><ComboBox Classes="settingsInput overlaySourcePicker" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource OverlaySourceOptionTemplate}" SelectedItem="{Binding TopRightSource}" /></StackPanel><StackPanel Grid.Row="1" Spacing="4"><TextBlock Classes="settingsRowTitleSm" Text="Bottom left" /><ComboBox Classes="settingsInput overlaySourcePicker" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource OverlaySourceOptionTemplate}" SelectedItem="{Binding BottomLeftSource}" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Classes="settingsRowTitleSm" Text="Bottom right" /><ComboBox Classes="settingsInput overlaySourcePicker" ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource OverlaySourceOptionTemplate}" SelectedItem="{Binding BottomRightSource}" /></StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><TextBlock Classes="settingsRowDescSm" Text="Drag layers. White corners resize. Pickers stay at assigned corners." TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Reset camera" IsVisible="{Binding CameraCustomPosition}" Click="ResetCamera_OnClick" /><Button Grid.Column="2" Content="Reset input" IsVisible="{Binding KeyboardCustomPosition}" Click="ResetKeyboard_OnClick" /></Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
