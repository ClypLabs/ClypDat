<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             x:Class="ClypDat.App.Views.Settings.VideoOverlaysSection"
             x:DataType="vm:VideoOverlayViewModel"
             IsVisible="False">
  <StackPanel Spacing="18" Tag="Video Overlays">
    <StackPanel Spacing="4">
      <TextBlock Classes="settingsSectionTitle" Text="Video Overlays" />
      <TextBlock Classes="settingsSectionDesc" Text="Add camera and input layers to new recordings. Source settings apply live without restarting replay capture." />
      <Border Classes="settingsDivider" Margin="0,14,0,0" />
    </StackPanel>
    <Border Classes="settingsCard">
      <StackPanel Spacing="14">
        <TextBlock Classes="settingsCardLabel" Text="VIDEO OVERLAYS" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="settingsRowTitle" Text="Burn camera and input into recordings" />
            <TextBlock Classes="settingsRowDescSm" Text="Configure sources, position, and size. Camera audio is not recorded." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
        </Grid>
        <Border Classes="settingsDivider" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Classes="settingsRowDescSm" Text="{Binding SourceStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Classes="primaryButton" Content="Configure" Click="Configure_OnClick" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
