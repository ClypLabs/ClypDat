<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             x:Class="ClypDat.App.Views.Settings.AutoClipSection"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Auto-Clip">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="18" Tag="Auto-Clip">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="4">
      <TextBlock Classes="settingsSectionTitle" Text="Auto-Clipping" />
      <TextBlock Classes="settingsSectionDesc" Text="Have ClypDat save the important moments from supported games using their local event feeds." />
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,4,0,0">
        <PathIcon Classes="cautionIcon" />
        <TextBlock Grid.Column="1" Text="Experimental - still being worked on and can miss events, mislabel clips, or misbehave."
                   Foreground="{StaticResource CautionBrush}" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" />
      </Grid>
      <Border Classes="settingsDivider" Margin="0,14,0,0" />
    </StackPanel>

    <Border Classes="settingsCard" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Auto Capture Events}">
      <StackPanel Spacing="14">
        <TextBlock Classes="settingsCardLabel" Text="AUTO CAPTURE" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Classes="settingsRowTitle" Text="Auto Capture Events" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
            <TextBlock Classes="settingsRowDescSm" Text="Turn this off to pause every game without losing your event choices." opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoClippingEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </Border>

    <TextBox Classes="settingsInput" Text="{Binding AutoClipSearchText}" PlaceholderText="Search auto-clipping games or events" />
    <ItemsControl ItemsSource="{Binding AutoClipGames}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <!-- One card per game, so two games no longer run together under a
               single hairline. -->
          <Border Classes="settingsCard" Margin="0,0,0,14" IsVisible="{Binding IsSearchMatch}">
            <StackPanel Spacing="0">
              <!-- The game's own switch belongs beside the game's name. It used
                   to sit in a third column of the outer grid, vertically
                   centred against the whole event list, so it floated in space
                   level with an arbitrary checkbox and looked like it belonged
                   to that instead. -->
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                <Border Classes="autoClipCover">
                  <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextStrongBrush}" FontWeight="Bold" FontSize="15"
                             opconv:SettingsHighlight.Query="{Binding SearchQuery}" />
                  <TextBlock Classes="settingsRowDescSm" Text="{Binding StatusText}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="2" IsChecked="{Binding IsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
              </Grid>

              <!-- Outside the disabled block below: setup is what you do
                   BEFORE the game can be switched on. -->
              <Button Content="Set Up Dota 2" Click="SetupDotaAutoClipButton_OnClick" IsVisible="{Binding IsSetupRequired}"
                      HorizontalAlignment="Left" Margin="66,14,0,0" />

              <!-- Greys out with the switch above it, so what that switch
                   actually governs is not left to guesswork. -->
              <StackPanel Spacing="0" IsEnabled="{Binding IsEnabled}">
                <StackPanel Spacing="16" IsVisible="{Binding IsCs2}">
                  <Border Classes="settingsDivider" Margin="0,18,0,0" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="settingsRowTitle" Text="Deathmatch Clipping" />
                      <TextBlock Classes="settingsRowDescSm" Text="CS2 auto-clips save in Competitive matches. Enable this to also save Deathmatch clips." />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding DeathmatchClipping}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <Border Classes="settingsDivider" Margin="0,18,0,16" />

                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="10" Margin="0,0,0,14">
                        <!-- Kept as the tri-state button it was: it is the one
                             control that can turn a whole group on or off, and
                             the dash/tick already says which state it is in. -->
                        <Button Classes="autoClipGroupToggle" Click="AutoClipGroupToggleButton_OnClick">
                          <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                            <Grid Width="20" Height="20">
                              <Border BorderBrush="{StaticResource TextMutedBrush}" BorderThickness="1" CornerRadius="4" Background="Transparent" />
                              <Border IsVisible="{Binding IsAllEnabled}" BorderBrush="{DynamicResource CheckBoxCheckBackgroundFillChecked}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
                              <Border IsVisible="{Binding IsIndeterminate}" BorderBrush="{DynamicResource CheckBoxCheckBackgroundFillChecked}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource CheckBoxCheckBackgroundFillChecked}" />
                              <TextBlock Text="&#x2713;" IsVisible="{Binding IsAllEnabled}" Foreground="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <TextBlock Text="-" IsVisible="{Binding IsIndeterminate}" Foreground="{DynamicResource CheckBoxCheckGlyphForegroundChecked}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextStrongBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Events}" Margin="0,0,-6,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <controls:ResponsiveUniformGrid MinimumItemWidth="128" MaximumColumns="5" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <CheckBox Classes="autoClipEvent" Content="{Binding Name}" IsChecked="{Binding IsEnabled}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding UngroupedEvents}" Margin="0,0,-6,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <controls:ResponsiveUniformGrid MinimumItemWidth="128" MaximumColumns="5" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Classes="autoClipEvent" Content="{Binding Name}" IsChecked="{Binding IsEnabled}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
      <StackPanel Spacing="8"><TextBlock Classes="settingsSectionLabel" Text="COMING SOON" /><TextBlock Classes="settingsRowDescSm" Text="More game integrations are planned. These are not enabled until ClypDat can reliably detect their events." opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" /><ItemsControl ItemsSource="{Binding ComingSoonAutoClipGames}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="5" Padding="8,4" Margin="0,0,6,6"><TextBlock Text="{Binding}" Foreground="{StaticResource TextSubtleBrush}" FontSize="11" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
    </Border>
  </StackPanel>
</UserControl>
