<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             x:Class="ClypDat.App.Views.Settings.GameDetectionSection"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Game Detection">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="24" Tag="Game Detection">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="6">
      <TextBlock Classes="settingsSectionTitle" Text="Game detection" />
      <TextBlock Classes="settingsSectionDesc" Text="Add a game ClypDat doesn't recognise yet, and manage the games it already knows." />
    </StackPanel>

    <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Add a running game|Or browse for an executable|Add Games}">
      <TextBlock Classes="settingsGroupLabel" Text="ADD GAMES" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow static" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Add a running game}">
            <StackPanel Spacing="10">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Add a running game" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="Start the game, then pick it from the apps that are open right now." />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <ComboBox Classes="settingsInput" ItemsSource="{Binding GameCandidateProcesses}" SelectedItem="{Binding SelectedGameProcess}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="Refresh" Click="RefreshProcessesButton_OnClick" />
                <Button Grid.Column="2" Classes="primaryButton" Content="Add" Click="AddGameFromProcessButton_OnClick" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="settingsRowDivider" IsVisible="{Binding !IsSettingsSearchActive}" />
          <Border Classes="settingsRow" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Or browse for an executable}">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Or browse for an executable" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="Choose the game's .exe file directly." />
              </StackPanel>
              <Button Grid.Column="1" Content="Browse…" Click="BrowseCustomGameButton_OnClick" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Classes="settingsRow static" Padding="24,0,24,18" MinHeight="0" IsVisible="{Binding GameAdditionError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Classes="settingsRowError" Text="{Binding GameAdditionError}" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Classes="settingsGroup">
      <TextBlock Classes="settingsGroupLabel" Text="GAME FOLDERS" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow static">
            <StackPanel Spacing="12">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Scan folders for games" />
                <TextBlock Classes="settingsRowDesc" Text="Scans the folders you choose. Known standalone games are added automatically; uncertain engine apps are listed for you to review." />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                <Button Content="Add folder" Click="AddGameFolderButton_OnClick" />
                <Button Grid.Column="1" Content="Scan now" Click="ScanGameFoldersButton_OnClick" IsEnabled="{Binding !IsScanningGameFolders}" />
                <Button Grid.Column="2" Content="Cancel" Click="CancelGameFolderScanButton_OnClick" IsEnabled="{Binding IsScanningGameFolders}" />
                <TextBlock Grid.Column="3" Classes="settingsRowDesc" Text="{Binding GameDiscoveryStatus}" VerticalAlignment="Center" Margin="6,0,0,0" />
              </Grid>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding GameDiscoveryFolders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="settingsListItem">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Classes="settingsListItemText" Text="{Binding}" />
                    <Button Grid.Column="1" Classes="linkButton" Content="Remove" VerticalAlignment="Center" Click="RemoveGameFolderButton_OnClick" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel IsVisible="{Binding HasDiscoveredGameReviews}">
            <Border Classes="settingsListItem">
              <TextBlock Classes="settingsRowTitle" Text="Review discovered games" VerticalAlignment="Center" />
            </Border>
            <ItemsControl ItemsSource="{Binding DiscoveredGameReviews}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="settingsListItem">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="4" MaxWidth="440" HorizontalAlignment="Left">
                        <TextBox Classes="settingsInput compact" Text="{Binding DisplayName}" />
                        <TextBlock Classes="settingsRowDescSm" Text="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="settingsRowDescSm" Text="{Binding Reason}" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="primaryButton" Content="Add" VerticalAlignment="Center" Click="AddDiscoveredGameButton_OnClick" />
                      <Button Grid.Column="2" Content="Ignore" VerticalAlignment="Center" Click="IgnoreDiscoveredGameButton_OnClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Game icons|Game Icons}">
      <TextBlock Classes="settingsGroupLabel" Text="GAME ICONS" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
      <Border Classes="settingsGroupCard">
        <Border Classes="settingsRow">
          <StackPanel Spacing="8">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Refresh game icons" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="Sidebar artwork is found automatically and then kept, so a wrong or missing icon stays that way. Refreshing throws the cached images away and looks every game up again." opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
              </StackPanel>
              <Button Grid.Column="1" Content="Refresh" Click="RefreshGameIconsButton_OnClick" IsEnabled="{Binding !IsRefreshingGameIcons}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Classes="settingsRowDesc" Text="{Binding GameIconRefreshStatus}"
                       IsVisible="{Binding GameIconRefreshStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </Border>
    </StackPanel>

    <!-- The search box belongs to the list it filters, not to the Add Games
         card above it, where it read as "search for a game to add" and was off
         screen by the time the list it actually filters was in view. -->
    <StackPanel Classes="settingsGroup">
      <TextBlock Classes="settingsGroupLabel" Text="DETECTED GAMES" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow static" Padding="24,16">
            <TextBox Classes="settingsInput" PlaceholderText="Search games" Text="{Binding GameSearchText}" />
          </Border>
          <ScrollViewer Classes="listScroll">
            <ItemsControl ItemsSource="{Binding GameCaptureRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="settingsListItem" IsVisible="{Binding IsVisible}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="1" Margin="{Binding TitleMargin}" VerticalAlignment="Center">
                        <TextBlock Classes="settingsListItemText" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <!-- ExecutableName is the detection key (e.g.
                             "steam-381210" for a Catalog-origin row), not a real
                             filename - ProcessName is the actual exe. Rows saved
                             before ProcessName existed have it empty until next
                             detected - collapsed rather than shown blank so a
                             name-only row's title centres vertically. -->
                        <TextBlock Classes="settingsRowDescSm" Text="{Binding ProcessName}" IsVisible="{Binding ProcessName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="linkButton" Content="Remove" VerticalAlignment="Center" Click="RemoveGameButton_OnClick"
                              ToolTip.Tip="Removes it from this list and stops ClypDat detecting it as a game again" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Excluded from detection}">
      <StackPanel Classes="settingsGroup" IsVisible="{Binding HasIgnoredGameExecutables}">
        <TextBlock Classes="settingsGroupLabel" Text="EXCLUDED FROM DETECTION" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
        <TextBlock Classes="settingsGroupDesc" Text="Apps you told ClypDat not to treat as games. Click the detected game in the header, or remove a detected game above, to add one." opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
        <Border Classes="settingsGroupCard">
          <ScrollViewer Classes="listScroll">
            <ItemsControl ItemsSource="{Binding IgnoredGameExecutableRows}">
              <ItemsControl.Styles>
                <!-- The card's own edge is the top rule for the first entry. -->
                <Style Selector="ContentPresenter:nth-child(1) > Border.settingsListItem">
                  <Setter Property="BorderThickness" Value="0" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="settingsListItem">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="1" Margin="{Binding TitleMargin}" VerticalAlignment="Center">
                        <TextBlock Classes="settingsListItemText" Text="{Binding DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Classes="settingsRowDescSm" Text="{Binding ProcessName}" IsVisible="{Binding ProcessName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="linkButton" Content="Remove" VerticalAlignment="Center" Click="RemoveIgnoredGameButton_OnClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
