<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             x:Class="ClypDat.App.Views.Settings.GameStatsSection"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Game Stats">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="24" Tag="Game Stats">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="6">
      <TextBlock Classes="settingsSectionTitle" Text="Game stats" />
      <TextBlock Classes="settingsSectionDesc" Text="Match scoreboards and stats shown beside your clips in the editor." />
    </StackPanel>
    <!-- CS2 match stats. The authentication code reads a player's whole match
         history, so it is masked while typed, never shown again once saved
         (last four characters at most), and only ever stored encrypted. -->
    <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=CS2 Match Stats History Steam Saved Demo Import}">
      <TextBlock Classes="settingsGroupLabel" Text="CS2 MATCH STATS" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Keep match stats" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="Record a scoreboard for each CS2 match, even with auto-clipping off. Clips from that match show it in the editor's Stats section." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Cs2MatchStatsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
          <Border Classes="settingsRow">
            <StackPanel Spacing="12">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Link match history" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <controls:LinkTextBlock Classes="settingsRowDesc">
                  <Run Text="Adds every player's stats, ADR and the radar by reading each match's demo after the game closes. Needs your ClypDat sign-in. New to this? Follow the " /><Run Text="setup guide" controls:LinkTextBlock.Url="https://www.clypdat.xyz/docs/cs2-match-stats" /><Run Text="." />
                </controls:LinkTextBlock>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding IsCs2MatchHistorySummaryVisible}">
                <TextBlock Classes="settingsRowDescSm" Text="{Binding Cs2MatchHistorySummary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Change codes" Click="Cs2MatchHistoryEdit_OnClick" />
                  <Button Classes="dangerButton" Content="Unlink" Click="Cs2MatchHistoryUnlink_OnClick" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="10" IsVisible="{Binding IsCs2MatchHistoryFormVisible}" MaxWidth="520" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                  <TextBlock Classes="settingsRowDescSm" Text="Steam ID (17 digits)" />
                  <TextBox Classes="settingsInput" Text="{Binding Cs2SteamIdInput}" PlaceholderText="7656119xxxxxxxxxx" MaxLength="120" />
                  <TextBlock Classes="settingsRowError" Text="{Binding Cs2SteamIdError}" IsVisible="{Binding HasCs2SteamIdError}" />
                  <controls:LinkTextBlock Classes="settingsRowDescSm">
                    <Run Text="Filled in for you after you play CS2 with ClypDat open. Otherwise paste your Steam profile link or the ID from your " /><Run Text="Steam account page" controls:LinkTextBlock.Url="https://store.steampowered.com/account/" /><Run Text="." />
                  </controls:LinkTextBlock>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="settingsRowDescSm" Text="Game authentication code" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Classes="settingsInput" Text="{Binding Cs2AuthCodeInput}" PlaceholderText="AAAA-AAAAA-AAAA" MaxLength="15"
                             PasswordChar="•" RevealPassword="{Binding IsCs2AuthCodeRevealed}" />
                    <ToggleButton Grid.Column="1" Content="{Binding Cs2AuthCodeRevealLabel}" IsChecked="{Binding IsCs2AuthCodeRevealed}" />
                  </Grid>
                  <TextBlock Classes="settingsRowError" Text="{Binding Cs2AuthCodeError}" IsVisible="{Binding HasCs2AuthCodeError}" />
                  <controls:LinkTextBlock Classes="settingsRowDescSm">
                    <Run Text="Create one on " /><Run Text="Steam's CS2 match history page" controls:LinkTextBlock.Url="https://help.steampowered.com/en/wizard/HelpWithGameIssue/?appid=730&amp;issueid=128" /><Run Text="." />
                  </controls:LinkTextBlock>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="settingsRowDescSm" Text="Recent match code to start from" />
                  <TextBox Classes="settingsInput" Text="{Binding Cs2ShareCodeInput}" PlaceholderText="CSGO-xxxxx-xxxxx-xxxxx-xxxxx-xxxxx" MaxLength="300" />
                  <TextBlock Classes="settingsRowError" Text="{Binding Cs2ShareCodeError}" IsVisible="{Binding HasCs2ShareCodeError}" />
                  <TextBlock Classes="settingsRowDescSm" Text="Use your most recent match code from this Steam account. ClypDat checks later matches automatically. In CS2, open Watch › Your Matches, select your newest match and copy its sharing code or link. The Steam page above also shows your most recently completed match token after you finish a match with your authentication code enabled. For older demos you already downloaded, use Import saved demo below." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primaryButton" Content="Link" Click="Cs2MatchHistoryLink_OnClick" />
                  <Button Content="Cancel" Click="Cs2MatchHistoryCancel_OnClick" IsVisible="{Binding IsCs2MatchHistoryLinked}" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding HasCs2MatchHistoryStatus}">
                <TextBlock Classes="settingsRowWarning" Text="{Binding Cs2MatchHistoryStatus}" />
                <Button Content="Try again" HorizontalAlignment="Left" IsVisible="{Binding CanRetryCs2MatchHistory}" Click="Cs2MatchHistoryRetry_OnClick" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="settingsRow">
            <StackPanel Spacing="10">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Saved demos" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="Import a CS2 .dem or .dem.bz2 file you already downloaded, including older matches. A Steam match history link is not required. Keep its .dem.info file beside it when available so ClypDat can match older clips." />
              </StackPanel>
              <Button Content="Import saved demo" HorizontalAlignment="Left" IsEnabled="{Binding !IsImportingCs2Demo}" Click="Cs2DemoImport_OnClick" />
              <TextBlock Classes="settingsRowDescSm" Text="{Binding Cs2DemoImportStatus}" IsVisible="{Binding HasCs2DemoImportStatus}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
    <!-- Fortnite match stats come from Fortnite's own replays, read on this PC
         and never changed. Fortnite only writes them with Record Replays on. -->
    <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Fortnite Match Stats Replays}">
      <TextBlock Classes="settingsGroupLabel" Text="FORTNITE MATCH STATS" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Keep match stats" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="Add replay stats to clips you save and full-session recordings you choose to record. Stats appear after the match ends. Everything stays on this PC." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding FortniteMatchStatsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Replays" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="{Binding FortniteReplayStatus}" />
              </StackPanel>
              <Button Grid.Column="1" Content="Open replay folder" IsEnabled="{Binding FortniteReplayFolderExists}" Click="FortniteReplayFolder_OnClick" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
