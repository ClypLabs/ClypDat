<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             x:Class="ClypDat.App.Views.Settings.GameStatsSection"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Game Stats">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="24" Tag="Game Stats">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="6">
      <TextBlock Classes="settingsSectionTitle" Text="Game stats" />
      <TextBlock Classes="settingsSectionDesc" Text="Match scoreboards and stats shown beside your clips in the editor." />
    </StackPanel>
    <!-- CS2 match stats. The authentication code reads a player's whole match
         history, so it is masked while typed, never shown again once saved
         (last four characters at most), and only ever stored encrypted. -->
    <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=CS2 Match Stats History Steam}">
      <TextBlock Classes="settingsGroupLabel" Text="CS2 MATCH STATS" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Keep match stats" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="Record a scoreboard for each CS2 match, even with auto-clipping off. Clips from that match show it in the editor's Stats section." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding Cs2MatchStatsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
          <Border Classes="settingsRow">
            <StackPanel Spacing="12">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Link match history" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc">
                  <Run Text="Adds every player's stats, ADR and the radar by reading each match's demo after the game closes. Needs your ClypDat sign-in. New to this? Follow the " /><InlineUIContainer BaselineAlignment="TextBottom"><Button Classes="linkButton webLink inlineLink" Content="setup guide" Click="Cs2MatchHistoryGuide_OnClick" /></InlineUIContainer><Run Text="." />
                </TextBlock>
              </StackPanel>

              <StackPanel Spacing="8" IsVisible="{Binding IsCs2MatchHistorySummaryVisible}">
                <TextBlock Classes="settingsRowDescSm" Text="{Binding Cs2MatchHistorySummary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Change codes" Click="Cs2MatchHistoryEdit_OnClick" />
                  <Button Classes="dangerButton" Content="Unlink" Click="Cs2MatchHistoryUnlink_OnClick" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="10" IsVisible="{Binding IsCs2MatchHistoryFormVisible}" MaxWidth="520" HorizontalAlignment="Left">
                <StackPanel Spacing="4">
                  <TextBlock Classes="settingsRowDescSm" Text="Steam ID (17 digits)" />
                  <TextBox Classes="settingsInput" Text="{Binding Cs2SteamIdInput}" PlaceholderText="7656119xxxxxxxxxx" MaxLength="120" />
                  <TextBlock Classes="settingsRowError" Text="{Binding Cs2SteamIdError}" IsVisible="{Binding HasCs2SteamIdError}" />
                  <TextBlock Classes="settingsRowDescSm">
                    <Run Text="Filled in for you after you play CS2 with ClypDat open. Otherwise paste your Steam profile link or the ID from your " /><InlineUIContainer BaselineAlignment="TextBottom"><Button Classes="linkButton webLink inlineLink" Content="Steam account page" Click="SteamAccountPage_OnClick" /></InlineUIContainer><Run Text="." />
                  </TextBlock>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="settingsRowDescSm" Text="Game authentication code" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Classes="settingsInput" Text="{Binding Cs2AuthCodeInput}" PlaceholderText="AAAA-AAAAA-AAAA" MaxLength="15"
                             PasswordChar="•" RevealPassword="{Binding IsCs2AuthCodeRevealed}" />
                    <ToggleButton Grid.Column="1" Content="{Binding Cs2AuthCodeRevealLabel}" IsChecked="{Binding IsCs2AuthCodeRevealed}" />
                  </Grid>
                  <TextBlock Classes="settingsRowError" Text="{Binding Cs2AuthCodeError}" IsVisible="{Binding HasCs2AuthCodeError}" />
                  <TextBlock Classes="settingsRowDescSm">
                    <Run Text="Create one on " /><InlineUIContainer BaselineAlignment="TextBottom"><Button Classes="linkButton webLink inlineLink" Content="Steam's CS2 match history page" Click="Cs2AuthCodeHelp_OnClick" /></InlineUIContainer><Run Text="." />
                  </TextBlock>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="settingsRowDescSm" Text="Match code to start from" />
                  <TextBox Classes="settingsInput" Text="{Binding Cs2ShareCodeInput}" PlaceholderText="CSGO-xxxxx-xxxxx-xxxxx-xxxxx-xxxxx" MaxLength="300" />
                  <TextBlock Classes="settingsRowError" Text="{Binding Cs2ShareCodeError}" IsVisible="{Binding HasCs2ShareCodeError}" />
                  <TextBlock Classes="settingsRowDescSm" Text="The Steam page that creates your authentication code also shows your most recent match code; that starts from now. To fill in stats for clips you've already saved, paste an older code from CS2 › Watch › Your Matches instead (Valve keeps demos for a few weeks)." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="primaryButton" Content="Link" Click="Cs2MatchHistoryLink_OnClick" />
                  <Button Content="Cancel" Click="Cs2MatchHistoryCancel_OnClick" IsVisible="{Binding IsCs2MatchHistoryLinked}" />
                </StackPanel>
              </StackPanel>

              <TextBlock Classes="settingsRowWarning" Text="{Binding Cs2MatchHistoryStatus}" IsVisible="{Binding HasCs2MatchHistoryStatus}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
