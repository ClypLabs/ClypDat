<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             x:Class="ClypDat.App.Views.Settings.ImportClipsSection"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <Binding Path="SelectedSettingsSection" Converter="{x:Static conv:ObjectConverters.Equal}" ConverterParameter="Import Clips" />
  </UserControl.IsVisible>
  <StackPanel>
    <StackPanel Spacing="24" Tag="Import Clips" IsVisible="{Binding IsImportSourcePickerVisible}">
      <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
      <StackPanel Spacing="6">
        <TextBlock Classes="settingsSectionTitle" Text="Import clips" />
        <TextBlock Classes="settingsSectionDesc" Text="Bring clips you recorded with another app into your ClypDat library." />
      </StackPanel>
      <StackPanel Classes="settingsGroup">
        <TextBlock Classes="settingsGroupLabel" Text="SOURCES" />
        <Border Classes="settingsGroupCard">
          <StackPanel>
            <Border Classes="settingsRow">
              <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="Medal" />
                  <TextBlock Classes="settingsRowDesc" Text="Import clips recorded by Medal, including its titles and game metadata." />
                </StackPanel>
                <Button Grid.Column="1" Classes="primaryButton" Content="Open importer" Tag="Medal" Click="ChooseImportSourceButton_OnClick" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingsRowDivider" />
            <Border Classes="settingsRow">
              <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="SteelSeries Moments" />
                  <TextBlock Classes="settingsRowDesc" Text="Import Moments clips with their dates, titles, games and auto-clip reasons." />
                </StackPanel>
                <Button Grid.Column="1" Classes="primaryButton" Content="Open importer" Tag="SteelSeries" Click="ChooseImportSourceButton_OnClick" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="24" Tag="Import Clips" IsVisible="{Binding IsMedalImportPageVisible}">
      <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
      <StackPanel Spacing="6">
        <Button Content="← Import sources" Classes="linkButton" Click="BackToImportSourcesButton_OnClick" HorizontalAlignment="Left" Padding="0" Margin="0,0,0,6" />
        <TextBlock Classes="settingsSectionTitle" Text="Import from Medal" />
        <TextBlock Classes="settingsSectionDesc" Text="Finds clips Medal has recorded locally and copies or moves them into your ClypDat library, keeping Medal's own clip titles." />
      </StackPanel>
      <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Strip emoji from titles|Copy instead of move|Import Options}">
        <TextBlock Classes="settingsGroupLabel" Text="IMPORT OPTIONS" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
        <Border Classes="settingsGroupCard">
          <StackPanel>
            <Border Classes="settingsRow" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Strip emoji from titles}">
              <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="Strip emoji from titles" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <TextBlock Classes="settingsRowDesc" Text="Removes emoji from Medal clip titles as they're imported." />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MedalImportStripEmoji}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Grid>
            </Border>
            <Border Classes="settingsRowDivider" IsVisible="{Binding !IsSettingsSearchActive}" />
            <Border Classes="settingsRow" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Copy instead of move}">
              <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="Copy instead of move" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                  <TextBlock Classes="settingsRowDesc" Text="On: Medal keeps its own copy. Off: clips are removed from Medal once imported." opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MedalImportCopyNotMove}" OnContent="{x:Null}" OffContent="{x:Null}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Scan for Medal clips|Scan}">
        <TextBlock Classes="settingsGroupLabel" Text="SCAN" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
        <Border Classes="settingsGroupCard">
          <StackPanel>
            <Border Classes="settingsRow static">
              <StackPanel Spacing="12">
                <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
                  <StackPanel Classes="settingsRowText">
                    <TextBlock Classes="settingsRowTitle" Text="Scan for Medal clips" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <TextBlock Classes="settingsRowDesc" Text="{Binding MedalScanStatusText}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Scan" Classes="primaryButton" Click="ScanMedalButton_OnClick" IsEnabled="{Binding !MedalImportInProgress}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel IsVisible="{Binding MedalImportInProgress}" Spacing="6">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding MedalImportProgressPercent}" Height="8" />
                  <TextBlock Classes="settingsRowDesc" Text="{Binding MedalImportStatusText}" />
                </StackPanel>
                <TextBlock Classes="settingsRowDesc" Text="{Binding MedalImportStatusText}" IsVisible="{Binding ShowMedalImportStatusText}" />
              </StackPanel>
            </Border>

            <StackPanel IsVisible="{Binding MedalScanned}">
              <Border Classes="settingsListItem">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <CheckBox IsThreeState="True" IsChecked="{Binding MedalImportSelectionState, Mode=OneWay}"
                            IsEnabled="{Binding CanToggleMedalImportSelection}" Click="ToggleMedalImportSelection_OnClick"
                            ToolTip.Tip="Select or deselect all importable Medal clips" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="settingsRowDesc" Text="Select all" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="Import selected" Click="ImportMedalButton_OnClick" Classes="primaryButton"
                          IsEnabled="{Binding !MedalImportInProgress}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding MedalImportRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="settingsListItem">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanImport}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="settingsListItemText" Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontFamily="Segoe UI,Segoe UI Emoji" />
                          <TextBlock Classes="settingsRowDescSm">
                            <Run Text="{Binding GameFolderName}" /><Run Text=" • " /><Run Text="{Binding CreatedAtLocal}" />
                          </TextBlock>
                          <TextBlock Classes="settingsRowError" Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="24" Tag="Import Clips" IsVisible="{Binding IsSteelSeriesImportPageVisible}">
      <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
      <StackPanel Spacing="6">
        <Button Content="← Import sources" Classes="linkButton" Click="BackToImportSourcesButton_OnClick" HorizontalAlignment="Left" Padding="0" Margin="0,0,0,6" />
        <TextBlock Classes="settingsSectionTitle" Text="Import from SteelSeries Moments" />
        <TextBlock Classes="settingsSectionDesc" Text="Finds SteelSeries Moments clips locally and copies or moves them into your ClypDat library, keeping meaningful Moments titles and capture dates." />
      </StackPanel>
      <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Copy instead of move}">
        <TextBlock Classes="settingsGroupLabel" Text="IMPORT OPTIONS" />
        <Border Classes="settingsGroupCard">
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Copy instead of move" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="On: SteelSeries keeps its own copy. Off: clips are removed from Moments once imported." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding SteelSeriesImportCopyNotMove}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
        </Border>
      </StackPanel>
      <StackPanel Classes="settingsGroup" IsVisible="{Binding SettingsSearchText, Converter={x:Static opconv:SettingsSearchHighlightConverter.Instance}, ConverterParameter=Scan for SteelSeries clips|Scan}">
        <TextBlock Classes="settingsGroupLabel" Text="SCAN" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
        <Border Classes="settingsGroupCard">
          <StackPanel>
            <Border Classes="settingsRow static">
              <StackPanel Spacing="12">
                <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
                  <StackPanel Classes="settingsRowText">
                    <TextBlock Classes="settingsRowTitle" Text="Scan for SteelSeries clips" opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                    <TextBlock Classes="settingsRowDesc" Text="{Binding SteelSeriesScanStatusText}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Scan" Classes="primaryButton" Click="ScanSteelSeriesButton_OnClick" IsEnabled="{Binding !SteelSeriesImportInProgress}" VerticalAlignment="Center" />
                </Grid>
                <StackPanel IsVisible="{Binding SteelSeriesImportInProgress}" Spacing="6">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding SteelSeriesImportProgressPercent}" Height="8" />
                  <TextBlock Classes="settingsRowDesc" Text="{Binding SteelSeriesImportStatusText}" />
                </StackPanel>
                <TextBlock Classes="settingsRowDesc" Text="{Binding SteelSeriesImportStatusText}" IsVisible="{Binding ShowSteelSeriesImportStatusText}" />
              </StackPanel>
            </Border>
            <StackPanel IsVisible="{Binding SteelSeriesScanned}">
              <Border Classes="settingsListItem">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                  <CheckBox IsThreeState="True" IsChecked="{Binding SteelSeriesImportSelectionState, Mode=OneWay}" IsEnabled="{Binding CanToggleSteelSeriesImportSelection}" Click="ToggleSteelSeriesImportSelection_OnClick" ToolTip.Tip="Select or deselect all SteelSeries clips" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Classes="settingsRowDesc" Text="Select all" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="Import selected" Click="ImportSteelSeriesButton_OnClick" Classes="primaryButton" IsEnabled="{Binding !SteelSeriesImportInProgress}" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding SteelSeriesImportRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="settingsListItem">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanImport}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <TextBlock Classes="settingsListItemText" Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontFamily="Segoe UI,Segoe UI Emoji" />
                          <TextBlock Classes="settingsRowDescSm"><Run Text="{Binding GameName}" /><Run Text=" • " /><Run Text="{Binding CreatedAtLocal}" /></TextBlock>
                          <TextBlock Classes="settingsRowError" Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
