<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:sections="using:ClypDat.App.Views.Settings"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             x:Class="ClypDat.App.Views.Settings.CustomGameSection"
             x:Name="CustomGameRoot"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Custom Game Settings">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <!-- Custom Game Settings. Sits under CAPTURE directly beneath
       Replay Buffer, because everything it overrides lives in the
       sections around it. Layout is Add Game -> tab strip of added
       games -> the selected game's enabled groups -> Add Setting ->
       Delete. A game starts with NO groups enabled: adding a game
       means "I want to customise this one", not "change how it
       records right now". -->
  <StackPanel Spacing="24" Tag="Custom Game Settings">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="6">
      <TextBlock Classes="settingsSectionTitle" Text="Custom game settings" />
      <TextBlock Classes="settingsSectionDesc" Text="Record specific games differently: quality, replay length, audio or full-session recording. Anything you don't override here keeps using your normal settings." />
    </StackPanel>

    <!-- Add Game. One row, no group label: it is a single control and every
         pixel it takes is a pixel of the game's actual settings pushed off
         screen. -->
    <Border Classes="settingsGroupCard">
      <StackPanel>
        <Border Classes="settingsRow">
          <StackPanel Spacing="8">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Add a game"
                           opconv:SettingsHighlight.Query="{Binding SettingsSearchText}" />
                <TextBlock Classes="settingsRowDesc" Text="Pick from the games ClypDat has already detected." />
              </StackPanel>
              <!-- Auto column, so the box claims its MinWidth before the label gets
                   any: at 280 it crushed "Add Game" to a clipped word and its
                   description to one word per line on a narrow window. -->
              <ComboBox Grid.Column="1" Classes="settingsInput" MinWidth="220" MaxWidth="280" VerticalAlignment="Center"
                        PlaceholderText="Search for a game to add…"
                        ItemsSource="{Binding CustomGameCandidates}"
                        SelectionChanged="AddCustomGameComboBox_OnSelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding DisplayName}" />
                      <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" IsVisible="{Binding ProcessName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <TextBlock Classes="settingsRowError" Text="{Binding GameAdditionError}" IsVisible="{Binding GameAdditionError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="settingsRowDescSm" Text="Every detected game already has custom settings."
                       IsVisible="{Binding !CustomGameCandidates.Count}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Tab strip. Scrolls sideways once there are more games than fit, so the
         edges are faded from code-behind rather than slicing a tab in half at
         the viewport edge - see UpdateTabStripFade. -->
    <StackPanel Spacing="0" IsVisible="{Binding HasCustomGameTabs}">
      <ScrollViewer x:Name="GameTabScroll"
                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    ScrollChanged="GameTabScroll_OnScrollChanged"
                    SizeChanged="GameTabScroll_OnSizeChanged">
        <ItemsControl ItemsSource="{Binding CustomGameTabs}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="customGameTab" Classes.active="{Binding IsSelected}" Click="CustomGameTab_OnClick"
                      ToolTip.Tip="{Binding DisplayName}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <!-- ClipToBounds so a square icon takes the rounded corner
                       instead of overhanging the badge it sits in. -->
                  <Border Width="20" Height="20" CornerRadius="5" ClipToBounds="True"
                          Background="{StaticResource EdgeBrush}" VerticalAlignment="Center">
                    <Grid>
                      <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LinkBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsVisible="{Binding !HasIcon}" />
                      <Image Source="{Binding Icon}" Stretch="Uniform" IsVisible="{Binding HasIcon}" />
                    </Grid>
                  </Border>
                  <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <ScrollBar Classes="gameTabStrip" Orientation="Horizontal" Margin="0,12,0,0"
                 AllowAutoHide="False" Visibility="Auto"
                 Maximum="{Binding #GameTabScroll.ScrollBarMaximum.X}"
                 ViewportSize="{Binding #GameTabScroll.Viewport.Width}"
                 Value="{Binding #GameTabScroll.Offset.X, Mode=OneWay}"
                 Scroll="GameTabScrollBar_OnScroll">
        <ScrollBar.Theme>
          <ControlTheme TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Setter Property="Template">
              <ControlTemplate>
                <Track Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                       Value="{TemplateBinding Value, Mode=TwoWay}"
                       ViewportSize="{TemplateBinding ViewportSize}">
                  <Track.Thumb>
                    <Thumb Name="thumb" Classes="scrollThumb" />
                  </Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter>
          </ControlTheme>
        </ScrollBar.Theme>
      </ScrollBar>
      <Border Classes="settingsDivider" Margin="0,14,0,0" />
    </StackPanel>

    <!-- Selected game. DataContext is the tab, so everything below
         binds straight to its own values; the handlers reach the
         window's view model for anything that is not per-tab. -->
    <!-- IsVisible and DataContext are on SEPARATE elements: with
         compiled bindings, both resolve against the DataContext set
         on their own element, so putting them together made
         HasSelectedCustomGame resolve against the tab rather than
         against the window's view model. -->
    <ContentControl IsVisible="{Binding HasSelectedCustomGame}" HorizontalAlignment="Stretch">
    <StackPanel Spacing="24" DataContext="{Binding SelectedCustomGameTab}">
      <!-- Recording Mode. The one group a newly added game starts
           with, and the only three-way choice here - it is not a
           toggle because "record clips by hotkey", "record the whole
           session" and "do not record this at all" are three
           positions on one dial, not three switches. -->
      <StackPanel Classes="settingsGroup" IsVisible="{Binding HasRecordingMode}">
        <Grid Classes="settingsGroupHeader" ColumnDefinitions="*,Auto">
          <TextBlock Classes="settingsGroupLabel" Text="RECORDING MODE" />
          <Button Grid.Column="1" Classes="linkButton" Content="Remove" Tag="RecordingMode" Click="RemoveCustomGameGroupButton_OnClick" />
        </Grid>
        <Border Classes="settingsGroupCard">
          <Border Classes="settingsRow static">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
              <!-- Cover art earns its place by making the card belong
                   to a game at a glance; it is skipped entirely when
                   none could be found rather than showing a grey box. -->
              <Border Grid.Column="0" Width="112" Height="150" CornerRadius="8" ClipToBounds="True"
                      VerticalAlignment="Top" IsVisible="{Binding HasPortrait}">
                <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                <RadioButton GroupName="CustomGameRecordingMode" IsChecked="{Binding IsManualCapture}">
                  <StackPanel Classes="settingsRowText" Margin="4,0,0,0">
                    <TextBlock Classes="settingsRowTitle" Text="Manual capture" />
                    <TextBlock Classes="settingsRowDesc" Text="Keep the replay buffer running and save clips with your hotkey." />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="CustomGameRecordingMode" IsChecked="{Binding IsFullSessionCapture}">
                  <StackPanel Classes="settingsRowText" Margin="4,0,0,0">
                    <TextBlock Classes="settingsRowTitle" Text="Record the whole session" />
                    <TextBlock Classes="settingsRowDesc" Text="Starts recording as soon as this game opens. Your hotkey still saves clips." />
                  </StackPanel>
                </RadioButton>
                <RadioButton GroupName="CustomGameRecordingMode" IsChecked="{Binding IsRecordingOff}">
                  <StackPanel Classes="settingsRowText" Margin="4,0,0,0">
                    <TextBlock Classes="settingsRowTitle" Text="Recording off" />
                    <TextBlock Classes="settingsRowDesc" Text="This game is never recorded, even while the buffer is armed for everything else." />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Grid>
          </Border>
        </Border>
      </StackPanel>

      <!-- Same preset cards and dropdowns as the global Recording
           Quality card, deliberately: a per-game override that looked
           nothing like the setting it overrides is harder to read,
           and the row of sliders this replaced took four times the
           height to say less. -->
      <StackPanel Classes="settingsGroup" IsVisible="{Binding HasQuality}">
        <Grid Classes="settingsGroupHeader" ColumnDefinitions="*,Auto">
          <TextBlock Classes="settingsGroupLabel" Text="RECORDING QUALITY" />
          <Button Grid.Column="1" Classes="linkButton" Content="Remove" Tag="Quality" Click="RemoveCustomGameGroupButton_OnClick" />
        </Grid>
        <Border Classes="settingsGroupCard">
          <StackPanel>
            <Border Classes="settingsRow static">
              <StackPanel Spacing="14">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="Quality" />
                  <TextBlock Classes="settingsRowDesc" Text="Higher settings look better but use more of your GPU and more storage." />
                </StackPanel>

                <ListBox Classes="qualityPresetCards"
                         ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ReplayQualityPresets}"
                         SelectedItem="{Binding SelectedQualityPreset}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Spacing="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextBrush}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSubtleBrush}" FontSize="11.5" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel HorizontalAlignment="Left" ItemSpacing="12" LineSpacing="10" IsVisible="{Binding IsCustomQuality}">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="settingsFieldLabel" Text="Resolution" />
                    <ComboBox Classes="settingsInput" Width="170"
                              ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ReplayResolutions}"
                              SelectedValueBinding="{Binding Height}"
                              SelectedValue="{Binding ReplayMaxHeight}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=Resolution}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="settingsFieldLabel" Text="Frame rate" />
                    <ComboBox Classes="settingsInput" Width="110"
                              ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ReplayFrameRates}"
                              SelectedItem="{Binding ReplayFrameRate}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat={}{0}}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=FrameRate}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="settingsFieldLabel" Text="Bitrate" />
                    <ComboBox Classes="settingsInput" Width="110"
                              ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ReplayBitrateOptions}"
                              SelectedItem="{Binding SelectedBitrateOption}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Converter={x:Static opconv:ReplayQualityOptionBrushConverter.Instance}, ConverterParameter=Bitrate}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Classes="settingsRowDivider" />
            <Border Classes="settingsRow static">
              <StackPanel Spacing="12">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="Encoder" />
                  <TextBlock Classes="settingsRowDesc" Text="Codec, encoder and frame timing for this game only." />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Left" ItemSpacing="12" LineSpacing="10">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="settingsFieldLabel" Text="Codec" />
                    <ComboBox Classes="settingsInput" Width="170"
                              ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ReplayVideoCodecs}"
                              DisplayMemberBinding="{Binding Label}"
                              SelectedValueBinding="{Binding Value}"
                              SelectedValue="{Binding ReplayVideoCodec}" />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="settingsFieldLabel" Text="Video encoder" />
                    <ComboBox Classes="settingsInput" Width="192"
                              ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ReplayEncoderModes}"
                              DisplayMemberBinding="{Binding Label}"
                              SelectedValueBinding="{Binding Value}"
                              SelectedValue="{Binding ReplayEncoderMode}" />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Classes="settingsFieldLabel" Text="Frame timing" />
                    <!-- Same split as the global Frame Timing control: the list carries
                         the full label, the closed box only the value, so "CFR
                         (Recommended)" is not clipped by the box's width. -->
                    <ComboBox Classes="settingsInput" Width="192"
                              ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ReplayFrameTimingModes}"
                              SelectedValueBinding="{Binding Value}"
                              SelectedValue="{Binding ReplayFrameRateMode}">
                      <ComboBox.ItemTemplate><DataTemplate><TextBlock MinWidth="150" Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                      <ComboBox.SelectionBoxItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" /></DataTemplate></ComboBox.SelectionBoxItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel Classes="settingsGroup" IsVisible="{Binding HasReplay}">
        <Grid Classes="settingsGroupHeader" ColumnDefinitions="*,Auto">
          <TextBlock Classes="settingsGroupLabel" Text="REPLAY LENGTH AND HOTKEYS" />
          <Button Grid.Column="1" Classes="linkButton" Content="Remove" Tag="Replay" Click="RemoveCustomGameGroupButton_OnClick" />
        </Grid>
        <Border Classes="settingsGroupCard">
          <StackPanel>
            <Border Classes="settingsRow static">
              <StackPanel Spacing="12">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="Replay length" />
                  <TextBlock Classes="settingsRowDesc" Text="How much of this game the replay buffer keeps." />
                </StackPanel>
                <!-- Same control the global Replay Buffer page uses, so the two
                     read as the same setting. -->
                <ListBox Classes="settingsSegmented"
                         ItemsSource="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).ReplayDurationPresets}"
                         SelectedItem="{Binding SelectedDurationPreset}" />
              </StackPanel>
            </Border>
            <Border Classes="settingsRowDivider" />
            <Border Classes="settingsRow">
              <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="Save hotkey" />
                  <TextBlock Classes="settingsRowDesc" Text="Saves this game's replay buffer as a clip." />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding SaveReplayHotkey}" Tag="SaveReplay" Click="HotkeyCaptureButton_OnClick" MinWidth="180" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingsRowDivider" />
            <Border Classes="settingsRow">
              <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
                <StackPanel Classes="settingsRowText">
                  <TextBlock Classes="settingsRowTitle" Text="Full Session hotkey" />
                  <TextBlock Classes="settingsRowDesc" Text="Starts or stops a Full Session recording for this game." />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding FullSessionHotkey}" Tag="FullSession" Click="HotkeyCaptureButton_OnClick" MinWidth="180" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Same shape as the global Recording Audio card: one row per
           track, toggle + icon + name + gain. Built from that card's
           own process list (SyncAudioProcesses) so both always offer
           the same apps, and so this does not run a second process
           enumeration of its own. -->
      <StackPanel Classes="settingsGroup" IsVisible="{Binding HasAudio}">
        <Grid Classes="settingsGroupHeader" ColumnDefinitions="*,Auto">
          <TextBlock Classes="settingsGroupLabel" Text="RECORDING AUDIO" />
          <Button Grid.Column="1" Classes="linkButton" Content="Remove" Tag="Audio" Click="RemoveCustomGameGroupButton_OnClick" />
        </Grid>
        <Border Classes="settingsGroupCard">
          <StackPanel>
            <Border Classes="settingsRow static">
              <StackPanel Spacing="8">
                <TextBlock Classes="settingsPickerLabel" Text="DEDICATED TRACKS" />
                <Border Classes="audioProcessList">
                  <StackPanel Spacing="0">
                    <Border Classes="audioProcessRow enabledRow">
                      <Grid ColumnDefinitions="3,44,34,*,320,52,26" ColumnSpacing="12" MinHeight="46">
                        <Border Classes="audioRowRail" />
                        <PathIcon Grid.Column="1" Classes="audioRowLock" Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" ToolTip.Tip="Always captured" />
                        <Border Grid.Column="2" Classes="audioIconTile">
                          <PathIcon Data="M4,19H20V21H4V19M6,3H18V17H6V3M8,5V15H16V5H8Z" Width="17" Height="17" Foreground="{StaticResource LinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Classes="audioTrackName" Text="Game Audio" />
                          <TextBlock Classes="settingsRowDescSm" Text="Always on" />
                        </StackPanel>
                        <Slider Grid.Column="4" Classes="volumeSlider appVolumeSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Foreground="{Binding GameAudioVolumePercent, Converter={x:Static opconv:AudioVolumeBrushConverter.Instance}}" Value="{Binding GameAudioVolumePercent}" />
                        <TextBlock Grid.Column="5" Classes="audioPercent" Text="{Binding GameAudioVolumePercent, StringFormat={}{0:0}%}" />
                        <Button Grid.Column="6" Classes="volumeReset" Click="ResetGameAudioVolumeButton_OnClick" IsVisible="{Binding !IsGameAudioVolumeDefault}" ToolTip.Tip="Reset to 100%"><PathIcon Data="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z" /></Button>
                      </Grid>
                    </Border>
                    <Border Classes="audioProcessRow enabledRow">
                      <Grid ColumnDefinitions="3,44,34,*,320,52,26" ColumnSpacing="12" MinHeight="46">
                        <Border Classes="audioRowRail" />
                        <PathIcon Grid.Column="1" Classes="audioRowLock" Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z" ToolTip.Tip="Always captured" />
                        <Border Grid.Column="2" Classes="audioIconTile">
                          <PathIcon Data="M12,14C13.66,14 15,12.66 15,11V5C15,3.34 13.66,2 12,2C10.34,2 9,3.34 9,5V11C9,12.66 10.34,14 12,14M17.3,11C17.3,14 14.76,16.1 12,16.1C9.24,16.1 6.7,14 6.7,11H5C5,14.41 7.72,17.23 11,17.72V21H13V17.72C16.28,17.23 19,14.41 19,11H17.3Z" Width="17" Height="17" Foreground="{StaticResource LinkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
                          <TextBlock Classes="audioTrackName" Text="Microphone" />
                          <TextBlock Classes="settingsRowDescSm" Text="Always on" />
                        </StackPanel>
                        <Slider Grid.Column="4" Classes="volumeSlider appVolumeSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Foreground="{Binding MicrophoneVolumePercent, Converter={x:Static opconv:AudioVolumeBrushConverter.Instance}}" Value="{Binding MicrophoneVolumePercent}" />
                        <TextBlock Grid.Column="5" Classes="audioPercent" Text="{Binding MicrophoneVolumePercent, StringFormat={}{0:0}%}" />
                        <Button Grid.Column="6" Classes="volumeReset" Click="ResetMicrophoneVolumeButton_OnClick" IsVisible="{Binding !IsMicrophoneVolumeDefault}" ToolTip.Tip="Reset to 100%"><PathIcon Data="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z" /></Button>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="settingsRow static" Padding="20,0,20,18">
              <StackPanel Spacing="8">
                <TextBlock Classes="settingsPickerLabel" Text="APP TRACKS" />
                <Border Classes="audioProcessList">
                  <ItemsControl ItemsSource="{Binding AudioProcesses}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Classes="audioProcessRow" Classes.enabledRow="{Binding IsEnabled}">
                          <Grid ColumnDefinitions="3,44,34,*,320,52,26" ColumnSpacing="12" MinHeight="46">
                            <Border Classes="audioRowRail" IsVisible="{Binding IsEnabled}" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="audioIconTile">
                              <Grid>
                                <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource LinkBrush}" FontWeight="Bold" />
                                <Image Source="{Binding Icon}" Stretch="Uniform" Margin="5" />
                              </Grid>
                            </Border>
                            <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Classes="audioTrackName" Text="{Binding Name}" />
                              <TextBlock Classes="settingsRowDescSm" Text="Separate app track" />
                            </StackPanel>
                            <Slider Grid.Column="4" Classes="volumeSlider appVolumeSlider" Minimum="0" Maximum="150" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" IsEnabled="{Binding IsEnabled}" Foreground="{Binding VolumePercent, Converter={x:Static opconv:AudioVolumeBrushConverter.Instance}}" Value="{Binding VolumePercent}" />
                            <TextBlock Grid.Column="5" Classes="audioPercent" IsEnabled="{Binding IsEnabled}" Text="{Binding VolumePercent, StringFormat={}{0:0}%}" />
                            <Button Grid.Column="6" Classes="volumeReset" Click="ResetAppVolumeButton_OnClick" IsVisible="{Binding !IsVolumeDefault}" IsEnabled="{Binding IsEnabled}" ToolTip.Tip="Reset to 100%"><PathIcon Data="M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z" /></Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>

      <sections:VideoOverlaysSection IsGameScoped="True"
          GameTab="{ReflectionBinding #CustomGameRoot.DataContext.SelectedCustomGameTab}" />

      <!-- Add Setting. Sits BELOW whatever is already enabled, so the
           card list grows downward toward it. Hidden once all four
           groups are on, because there is then nothing to add. -->
      <Button Classes="addSettingCard" Click="AddCustomGameSettingButton_OnClick" HorizontalAlignment="Stretch" Height="72"
              IsVisible="{Binding CanAddGroup}">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
          <!-- One filled geometry, not a stroked ring with two rectangles laid
               over it: a single path is symmetric by construction and scales
               as one piece, which is why every other icon in the app is drawn
               this way. -->
          <PathIcon Width="18" Height="18" Foreground="{StaticResource TextSubtleBrush}" VerticalAlignment="Center"
                    Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M17,13H13V17H11V13H7V11H11V7H13V11H17V13Z" />
          <TextBlock Text="Add setting" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button.Flyout>
          <MenuFlyout Placement="Top">
            <MenuItem Header="Recording mode" Tag="RecordingMode" Click="AddCustomGameGroupMenuItem_OnClick" IsVisible="{Binding !HasRecordingMode}" />
            <MenuItem Header="Recording quality" Tag="Quality" Click="AddCustomGameGroupMenuItem_OnClick" IsVisible="{Binding !HasQuality}" />
            <MenuItem Header="Replay length and hotkeys" Tag="Replay" Click="AddCustomGameGroupMenuItem_OnClick" IsVisible="{Binding !HasReplay}" />
            <MenuItem Header="Audio" Tag="Audio" Click="AddCustomGameGroupMenuItem_OnClick" IsVisible="{Binding !HasAudio}" />
            <MenuItem Header="Video overlays" Tag="Overlays" Click="AddCustomGameGroupMenuItem_OnClick" IsVisible="{Binding !HasOverlays}" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>

      <Border Classes="settingsGroupCard">
        <Border Classes="settingsRow">
          <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
            <StackPanel Classes="settingsRowText">
              <TextBlock Classes="settingsRowTitle" Text="{Binding DisplayName, StringFormat='Delete custom settings for {0}'}" TextWrapping="Wrap" />
              <TextBlock Classes="settingsRowDesc" Text="Reverts this game to your normal recording settings." />
            </StackPanel>
            <Button Grid.Column="1" Classes="dangerButton" Content="Delete settings" VerticalAlignment="Center" Click="DeleteCustomGameButton_OnClick" />
          </Grid>
        </Border>
      </Border>
    </StackPanel>
    </ContentControl>
  </StackPanel>
</UserControl>
