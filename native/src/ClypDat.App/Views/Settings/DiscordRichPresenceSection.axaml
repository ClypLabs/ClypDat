<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ClypDat.App.ViewModels"
             xmlns:controls="using:ClypDat.App.Controls"
             xmlns:opconv="using:ClypDat.App.Converters"
             x:Class="ClypDat.App.Views.Settings.DiscordRichPresenceSection"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.IsVisible>
    <MultiBinding Converter="{x:Static opconv:SettingsSectionVisibleConverter.Instance}" ConverterParameter="Discord Rich Presence">
      <Binding Path="SettingsSearchText" />
      <Binding Path="SelectedSettingsSection" />
    </MultiBinding>
  </UserControl.IsVisible>
  <StackPanel Spacing="24" Tag="Discord Rich Presence">
    <Border Classes="settingsDivider" Margin="0,0,0,4" IsVisible="{Binding IsSettingsSearchActive}" />
    <StackPanel Spacing="6">
      <TextBlock Classes="settingsSectionTitle" Text="Discord Rich Presence" />
      <TextBlock Classes="settingsSectionDesc" Text="Control what ClypDat shares on your Discord profile." />
    </StackPanel>
    <!-- DataContext switches to the PolicyPause, so visibility lives on the wrapper. -->
    <Panel IsVisible="{Binding DiscordPolicyBlocked}">
      <controls:PolicyPauseBanner DataContext="{Binding DiscordPolicyPause}" />
    </Panel>
    <StackPanel Classes="settingsGroup">
      <TextBlock Classes="settingsGroupLabel" Text="DISCORD" />
      <Border Classes="settingsGroupCard">
        <StackPanel>
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Discord Rich Presence" />
                <TextBlock Classes="settingsRowDesc" Text="Shows what you are recording, editing or browsing. Anyone who can see your profile can see the game name." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordRichPresenceEnabled}" IsEnabled="{Binding !DiscordPolicyBlocked}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
          <Border Classes="settingsRowDivider" />
          <Border Classes="settingsRow" IsEnabled="{Binding DiscordRichPresenceEnabled}">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Only show while playing a game" />
                <TextBlock Classes="settingsRowDesc" Text="Hide browsing, editing and settings activity unless ClypDat detects a game." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordRichPresenceOnlyWhenGameActive}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
          <Border Classes="settingsRowDivider" />
          <Border Classes="settingsRow" IsEnabled="{Binding DiscordRichPresenceEnabled}">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Show match details" />
                <TextBlock Classes="settingsRowDesc" Text="League of Legends, Counter-Strike 2 and Dota 2: your champion or hero, map, score and K/D/A. Dota 2 also needs -gamestateintegration in its Steam launch options." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordRichPresenceShowMatchDetails}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
          <Border Classes="settingsRowDivider" />
          <Border Classes="settingsRow">
            <Grid Classes="settingsRowGrid" ColumnDefinitions="*,Auto">
              <StackPanel Classes="settingsRowText">
                <TextBlock Classes="settingsRowTitle" Text="Show “Get ClypDat” link" />
                <TextBlock Classes="settingsRowDesc" Text="Adds a clypdat.xyz button for people viewing your Rich Presence." />
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsChecked="{Binding DiscordRichPresenceShowGetClypDatButton}" IsEnabled="{Binding DiscordRichPresenceEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
