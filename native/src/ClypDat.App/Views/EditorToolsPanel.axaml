<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:opconv="using:ClypDat.App.Converters"
             xmlns:vm="using:ClypDat.App.ViewModels"
             x:Class="ClypDat.App.Views.EditorToolsPanel"
             x:DataType="vm:MainWindowViewModel"
             KeyDown="Panel_OnKeyDown">
  <Border Background="#111920" BorderBrush="#30404D" BorderThickness="0,0,1,0" BoxShadow="6 0 20 0 #44000000">
    <Grid RowDefinitions="Auto,*">
      <Border Background="#101820" BorderBrush="#263743" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" Height="52" Margin="16,0">
          <TextBlock Text="{Binding ActiveEditorSidebarSection, Converter={x:Static opconv:EditorSidebarSectionTitleConverter.Instance}}"
                     Foreground="#EDF4FB" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="editorToolsClose" Click="CloseButton_OnClick" ToolTip.Tip="Close panel">
            <PathIcon Width="13" Height="13" Data="M6.3,5L12,10.7L17.7,5L19,6.3L13.3,12L19,17.7L17.7,19L12,13.3L6.3,19L5,17.7L10.7,12L5,6.3Z" />
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid>
        <StackPanel Margin="16" Spacing="12" IsVisible="{Binding IsEditorInfoSidebarActive}">
          <Border Background="#151F28" BorderBrush="#293A47" BorderThickness="1" CornerRadius="9" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="DETAILS" Foreground="#9EC6F0" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Title" Foreground="#8EA1B6" FontSize="12" />
              <TextBox Text="{Binding EditorTitle, Mode=TwoWay}" Foreground="#EDF4FB" FontSize="14" FontWeight="SemiBold"
                       Background="#0D151C" BorderBrush="#263743" KeyDown="TitleBox_OnKeyDown" />
              <TextBlock Text="Description" Foreground="#8EA1B6" FontSize="12" Margin="0,2,0,0" />
              <TextBox Text="{Binding EditorDescription, Mode=TwoWay}" MinHeight="78" AcceptsReturn="True" TextWrapping="Wrap"
                       Watermark="Add a description" Background="#0D151C" BorderBrush="#263743" Foreground="#D6E2F0" />
            </StackPanel>
          </Border>
          <Border Background="#151F28" BorderBrush="#293A47" BorderThickness="1" CornerRadius="9" Padding="12">
            <StackPanel Spacing="7">
              <TextBlock Text="MEDIA INFORMATION" Foreground="#9EC6F0" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="{Binding SelectedCreated}" Foreground="#B8C7D8" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedQuality}" Foreground="#B8C7D8" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedSize}" Foreground="#B8C7D8" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Foreground="#B8C7D8" FontSize="12"><Run Text="Duration  " /><Run Text="{Binding DurationLabel}" /></TextBlock>
              <TextBlock Text="{Binding SelectedCaptureBackend}" Foreground="#8EA1B6" FontSize="12" TextWrapping="Wrap"
                         IsVisible="{Binding SelectedCaptureBackend, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Margin="16" IsVisible="{Binding IsEditorEffectsSidebarActive}">
          <Border Background="#14222C" BorderBrush="#31546A" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,14">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
              <PathIcon Data="M12,2L14.7,9.3L22,12L14.7,14.7L12,22L9.3,14.7L2,12L9.3,9.3L12,2Z"
                        Width="28" Height="28" Foreground="#72B9EA" HorizontalAlignment="Center" />
              <TextBlock Text="Effects coming soon" Foreground="#EDF4FB" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
              <TextBlock Text="Crop, blur, text, speed, and freeze-frame tools will live here."
                         Foreground="#9AB0C2" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Margin="16" Spacing="12" IsVisible="{Binding IsEditorExportSidebarActive}">
          <Border Background="#151F28" BorderBrush="#293A47" BorderThickness="1" CornerRadius="9" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="FORMAT" Foreground="#9EC6F0" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Video codec" Foreground="#8EA1B6" FontSize="12" />
              <ComboBox Classes="settingsInput" ItemsSource="{Binding ExportCodecs}" SelectedItem="{Binding SelectedExportCodec}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
          </Border>
          <Border Background="#151F28" BorderBrush="#293A47" BorderThickness="1" CornerRadius="9" Padding="12">
            <StackPanel Spacing="9">
              <TextBlock Text="OUTPUT" Foreground="#9EC6F0" FontSize="11" FontWeight="Bold" />
              <TextBlock Text="Save a trimmed replacement or export a new clip." Foreground="#8EA1B6" FontSize="12" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8" HorizontalAlignment="Stretch">
                <Button Content="Save Trim" Height="38" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsExporting}"
                        ToolTip.Tip="Replace the original clip with just the trimmed range" Click="SaveTrimButton_OnClick" />
                <Button Grid.Column="1" Name="ExportButton" Content="{Binding ExportButtonText}" Classes="primaryButton" Height="38" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding !IsExporting}" Click="ExportButton_OnClick" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
