<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClypDat.App.Views.ShareDialog"
        Title="Share clip"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        KeyDown="ShareDialog_OnKeyDown">
  <!-- A genuinely separate top-level Window, not an Avalonia overlay embedded
       in MainWindow - the Editor's video is a native VLC child window that
       always paints over Avalonia-rendered siblings regardless of z-order
       ("airspace", see MainWindow.axaml.cs's EditorHoverControls comments),
       so an in-window overlay Border rendered behind it while a clip is
       open. A separate top-level window sized/positioned to exactly cover
       the owner (set in code-behind before Show) sits above that airspace
       the same way the floating hover bar already does, while
       TransparencyLevelHint lets this Grid's semi-transparent scrim still
       blend with - and dim - everything behind it, video included. -->
  <Grid Background="#DD000000" PointerPressed="Scrim_OnPointerPressed">
    <Border x:Name="ShareDialogCard" Width="480" CornerRadius="12" Background="#111920" BorderBrush="#232F3A" BorderThickness="1"
            ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel LastChildFill="True">
        <!-- Rounded on its own top corners rather than relying on the card's
             ClipToBounds: Avalonia clips a Border's children to its bounds
             RECTANGLE, not to its corner radius, so this bar's square
             corners painted straight over the card's rounded ones and left
             two black notches against the backdrop. -->
        <Border DockPanel.Dock="Top" Background="#0C1319" CornerRadius="11,11,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
            <!-- Spans all 3 columns and centers over the FULL header width,
                 rather than sitting in column 1 alone - with nothing in
                 column 0 to balance the close button's column 2, centering
                 within just column 1 read as shifted left of true center. -->
            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="SHARE CLIP" Foreground="#D8E4F2" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,0,0,0" IsHitTestVisible="False" />
            <Button Grid.Column="2" Classes="dialogClose" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Width="52" Height="56" CornerRadius="0,11,0,0" Click="CloseButton_OnClick">
              <TextBlock Text="✕" Margin="0,-3,0,0" />
            </Button>
          </Grid>
        </Border>

        <StackPanel Margin="28,24,28,28" Spacing="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Choose a file size" Foreground="#93A6B8" FontSize="13" FontWeight="Bold" />
            <!-- 10 MB is Discord's free-tier cap, 50 MB Nitro Basic, 100 MB
                 covers Nitro and most other upload targets. -->
            <StackPanel Orientation="Horizontal" Spacing="1">
              <RadioButton x:Name="ShareSizeOriginal" Classes="sizePill" GroupName="ShareSize" Content="Original" Tag="0" CornerRadius="7,0,0,7" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSize10" Classes="sizePill" GroupName="ShareSize" Content="10 MB" Tag="10" CornerRadius="0" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSize50" Classes="sizePill" GroupName="ShareSize" Content="50 MB" Tag="50" CornerRadius="0" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSize100" Classes="sizePill" GroupName="ShareSize" Content="100 MB" Tag="100" CornerRadius="0" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSizeCustom" Classes="sizePill" GroupName="ShareSize" Content="Custom" CornerRadius="0,7,7,0" Click="SizePreset_OnClick" />
            </StackPanel>
            <TextBox x:Name="ShareCustomSizeBox" Watermark="Size in MB" IsVisible="False" Width="140"
                     HorizontalAlignment="Left" KeyDown="CustomSizeBox_OnKeyDown" />
          </StackPanel>

          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="Drag &amp; Drop" Foreground="#EDF4FB" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
            <TextBlock x:Name="ShareStatusText" Text="Pick a size to prepare the clip"
                       Foreground="#8EA1B6" FontSize="12" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>

          <Grid Height="238">
            <Rectangle RadiusX="10" RadiusY="10" Stroke="#4C6FFF" StrokeThickness="2" StrokeDashArray="6,4" Fill="Transparent" />
            <!-- Uniform, not UniformToFill - a clip's real 16:9 frame shown
                 whole, not cropped square/round to fill the box. -->
            <Image x:Name="ShareThumbnail" Stretch="Uniform" Margin="3" IsVisible="False" Cursor="Hand"
                   PointerPressed="Thumbnail_OnPointerPressed"
                   PointerMoved="Thumbnail_OnPointerMoved"
                   PointerReleased="Thumbnail_OnPointerReleased" />
            <Border x:Name="ShareDurationBadge" Background="#CC0C1319" CornerRadius="12" Padding="9,4"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" IsVisible="False" IsHitTestVisible="False">
              <TextBlock x:Name="ShareDurationText" Foreground="White" FontSize="11" FontWeight="Bold" />
            </Border>
            <StackPanel x:Name="ShareProgressPanel" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
              <TextBlock x:Name="ShareProgressPercentText" Foreground="#D8E4F2" FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center" />
              <ProgressBar x:Name="ShareProgressBar" Minimum="0" Maximum="100" Width="160" Height="6"
                           CornerRadius="3" IsIndeterminate="True" />
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ShareResultSizeText" Foreground="#8EA1B6" FontSize="12" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Show in folder" IsEnabled="False" x:Name="ShareShowInFolderButton" Click="ShowInFolderButton_OnClick" />
          </Grid>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Sibling of the card, not a child of it, so it covers the ENTIRE app
         window while a drag is in flight rather than just the popup. Shown
         for exactly the duration of the OS drag gesture (DoDragDrop blocks
         until drop/cancel) and additionally hidden whenever the cursor
         leaves the app - the point is to get ClypDat out of the way while
         the user aims at another window, so it must not keep covering the
         app once the pointer is over that other window. The card underneath
         is untouched, so a cancelled drag lands back on it unchanged. -->
    <Border x:Name="ShareDragActiveOverlay" Background="#0B1016" IsVisible="False" IsHitTestVisible="False">
      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
        <Border Width="72" Height="56" CornerRadius="10" BorderBrush="#4C6FFF" BorderThickness="2"
                HorizontalAlignment="Center" Margin="0,0,0,8" />
        <TextBlock Text="Drag &amp; drop magic, activated!" FontWeight="Bold" FontSize="18"
                   Foreground="#EDF4FB" HorizontalAlignment="Center" />
        <TextBlock Text="Drop the clip onto a chat channel, DM, or upload box"
                   FontSize="13" Foreground="#8EA1B6" HorizontalAlignment="Center"
                   TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
