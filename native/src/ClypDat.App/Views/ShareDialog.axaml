<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClypDat.App.Views.ShareDialog"
        Title="Share clip"
        WindowDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        KeyDown="ShareDialog_OnKeyDown">
  <Border x:Name="ShareDialogCard" CornerRadius="12" Background="{StaticResource Surface_111920}" BorderBrush="{StaticResource Surface_232F3A}" BorderThickness="1"
          ClipToBounds="True">
      <DockPanel LastChildFill="True">
        <!-- Rounded on its own top corners rather than relying on the card's
             ClipToBounds: Avalonia clips a Border's children to its bounds
             RECTANGLE, not to its corner radius, so this bar's square
             corners painted straight over the card's rounded ones and left
             two black notches against the backdrop. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface_0C1319}" CornerRadius="11,11,0,0">
          <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
            <!-- Spans all 3 columns and centers over the FULL header width,
                 rather than sitting in column 1 alone - with nothing in
                 column 0 to balance the close button's column 2, centering
                 within just column 1 read as shifted left of true center. -->
            <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="SHARE CLIP" Foreground="#D8E4F2" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-2,0,0,0" IsHitTestVisible="False" />
            <Button Grid.Column="2" Classes="dialogClose" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Width="52" Height="56" CornerRadius="0,11,0,0" Click="CloseButton_OnClick">
              <TextBlock Text="✕" Margin="0,-3,0,0" />
            </Button>
          </Grid>
        </Border>

        <StackPanel Margin="28,24,28,28" Spacing="18">
          <StackPanel Spacing="10">
            <TextBlock Text="Choose a file size" Foreground="#93A6B8" FontSize="13" FontWeight="Bold" />
            <!-- 10 MB is Discord's free-tier cap, 20 MB suits smaller chat
                 uploads, 50 MB Nitro Basic, and 100 MB covers most others. -->
            <StackPanel Orientation="Horizontal" Spacing="1">
              <RadioButton x:Name="ShareSizeOriginal" Classes="sizePill" GroupName="ShareSize" Content="Original" Tag="0" Padding="9,10" CornerRadius="7,0,0,7" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSize10" Classes="sizePill" GroupName="ShareSize" Content="10 MB" Tag="10" Padding="9,10" CornerRadius="0" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSize20" Classes="sizePill" GroupName="ShareSize" Content="20 MB" Tag="20" Padding="9,10" CornerRadius="0" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSize50" Classes="sizePill" GroupName="ShareSize" Content="50 MB" Tag="50" Padding="9,10" CornerRadius="0" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSize100" Classes="sizePill" GroupName="ShareSize" Content="100 MB" Tag="100" Padding="9,10" CornerRadius="0" Click="SizePreset_OnClick" />
              <RadioButton x:Name="ShareSizeCustom" Classes="sizePill" GroupName="ShareSize" Content="Custom" Padding="9,10" CornerRadius="0,7,7,0" Click="SizePreset_OnClick" />
            </StackPanel>
            <TextBox x:Name="ShareCustomSizeBox" PlaceholderText="Size in MB" IsVisible="False" Width="140"
                     HorizontalAlignment="Left" KeyDown="CustomSizeBox_OnKeyDown" />
            <CheckBox x:Name="ShareAv1Toggle" Content="Smaller file (AV1)" Foreground="#93A6B8" FontSize="12" IsChecked="True"
                      IsCheckedChanged="Av1Toggle_OnChanged"
                      ToolTip.Tip="Fits roughly 45% more detail in the same size. Falls back to H.264 automatically if your GPU can't encode AV1. Some chat apps may show it as a download instead of playing it inline, so turn this off if that matters here." />
          </StackPanel>

          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <TextBlock Text="Drag &amp; Drop" Foreground="#EDF4FB" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" />
            <TextBlock x:Name="ShareStatusText" Text="Pick a size to prepare the clip"
                       Foreground="#8EA1B6" FontSize="12" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>

          <Grid Height="238">
            <!-- Sized in code-behind to the aspect of what is actually being
                 sent (SizeSharePreviewBox), so a 9:16 crop gets a 9:16 dashed
                 box rather than the picture floating in a 16:9 one. Everything
                 the box frames lives INSIDE it, progress included - the bar's
                 width is set from the box for the same reason. -->
            <Grid x:Name="SharePreviewBox" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
              <Rectangle RadiusX="10" RadiusY="10" Stroke="#4C6FFF" StrokeThickness="2" StrokeDashArray="6,4" Fill="Transparent" />
              <!-- Uniform, not UniformToFill - the box already carries the
                   picture's aspect, so nothing is cropped to fill it. -->
              <Image x:Name="ShareThumbnail" Stretch="Uniform" Margin="3" IsVisible="False" Cursor="Hand"
                     PointerPressed="Thumbnail_OnPointerPressed"
                     PointerMoved="Thumbnail_OnPointerMoved"
                     PointerReleased="Thumbnail_OnPointerReleased" />
              <Border x:Name="ShareDurationBadge" Background="{StaticResource Surface_CC0C1319}" CornerRadius="12" Padding="9,4"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,12,10,10" IsVisible="False" IsHitTestVisible="False">
                <TextBlock x:Name="ShareDurationText" Foreground="White" FontSize="11" FontWeight="Bold" />
              </Border>
              <StackPanel x:Name="ShareProgressPanel" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <TextBlock x:Name="ShareProgressPercentText" Foreground="#D8E4F2" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar x:Name="ShareProgressBar" Minimum="0" Maximum="100" Width="160" MinWidth="0" Height="6"
                             CornerRadius="3" IsIndeterminate="True" />
                <TextBlock x:Name="ShareProgressEtaText" Foreground="#8EA1B6" FontSize="12"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
            </Grid>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ShareResultSizeText" Foreground="#8EA1B6" FontSize="12" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Show in folder" IsEnabled="False" x:Name="ShareShowInFolderButton" Click="ShowInFolderButton_OnClick" />
          </Grid>
        </StackPanel>
      </DockPanel>
  </Border>
</Window>
