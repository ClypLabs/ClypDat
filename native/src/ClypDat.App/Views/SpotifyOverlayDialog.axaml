<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ClypDat.App.ViewModels"
        xmlns:opconv="using:ClypDat.App.Converters"
        x:Class="ClypDat.App.Views.SpotifyOverlayDialog"
        x:DataType="vm:MainWindowViewModel"
        Title="Spotify overlay"
        WindowDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        KeyDown="SpotifyOverlayDialog_OnKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="SpotifyDialogBrush" Color="#1ED760" />
    <SolidColorBrush x:Key="OverlayPreviewCardBrush" Color="#B3000000" />
  </Window.Resources>

  <Border CornerRadius="12" Background="{StaticResource Surface_111920}" BorderBrush="{StaticResource Surface_232F3A}" BorderThickness="1" ClipToBounds="True">
    <DockPanel LastChildFill="True">
      <Border DockPanel.Dock="Top" Background="{StaticResource Surface_0C1319}" CornerRadius="11,11,0,0" PointerPressed="TitleBar_OnPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="18,0,0,0" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="{StaticResource SpotifyDialogBrush}" VerticalAlignment="Center" />
            <TextBlock Text="SPOTIFY OVERLAY" Foreground="{StaticResource Text_D8E4F2}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
          <!-- Fills the corner, hover and all. Width and height are the
               header's, so the fill meets both edges instead of leaving a strip
               of header showing around it. -->
          <Button Grid.Column="2" Classes="dialogClose" Content="✕" Click="CloseButton_OnClick"
                  Width="52" Height="56" FontSize="14"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>
      </Border>

      <StackPanel Margin="20,18,20,20" Spacing="16">
        <!-- One line of description, not two: at this width the second line
             wrapped to three words and left the title floating over a ragged
             block with the switch stranded off to the right. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="settingsRowTitle" Text="Show the track on clips" />
            <TextBlock Classes="settingsRowDescSm" Text="Previewed here; included in exports and optional saved clips." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding SpotifyOverlayEnabled}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Spacing="10" IsEnabled="{Binding SpotifyOverlayEnabled}">
          <!-- Show the same animated card used by the editor and exports. -->
          <!-- 16:9, because that is what it is standing in for. The dialog's
               width is fixed, so the frame's own is 560 less the 20 margins and
               the 1px borders - 518 - and the height is that in the shape of a
               clip. A frame of some other shape puts the card somewhere the
               export will not. -->
          <Border CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource EdgeStrongBrush}" BorderThickness="1"
                  Width="518" Height="291" HorizontalAlignment="Left">
            <Panel>
              <!-- Stands in for footage. Two bands rather than a flat fill, so
                   the card's translucency reads as translucency.

                   Both carry the frame's own radius: Avalonia clips a Border's
                   children to its bounds RECTANGLE and not to its corner
                   radius, so a square fill inside a rounded frame paints
                   straight over the rounded corners. -->
              <Border Background="{StaticResource Surface_18232D}" CornerRadius="7" />
              <Border Background="{StaticResource Surface_0C1319}" Height="98" VerticalAlignment="Bottom" Opacity="0.55" CornerRadius="0,0,7,7" />
              <Border Background="{StaticResource SpotifyDialogBrush}" Opacity="0.10" Width="150" Height="150" CornerRadius="75"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />

              <Canvas Name="SpotifyPreviewCanvas" IsHitTestVisible="False" />
            </Panel>
          </Border>

          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,4,0,4">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="settingsRowTitle" Text="Dynamic background" />
              <TextBlock Classes="settingsRowDescSm" TextWrapping="Wrap" MaxWidth="400"
                         Text="Gently animate colours from the song cover. Turn off for a still gradient in the same colours." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SpotifyOverlayDynamicBackground}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
          </Grid>

          <TextBlock Classes="settingsPickerLabel" Text="PLACEMENT" />
          <ListBox Classes="pillGroup" ItemsSource="{Binding ClipOverlayPositions}" SelectedItem="{Binding SelectedSpotifyOverlayPosition}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- Three even columns. Left to its own devices the list gave
                     each tile its text's width, so the two columns stepped in
                     and out row by row. -->
                <UniformGrid Columns="3" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Border Width="34" Height="22" Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource EdgeStrongBrush}" BorderThickness="1" CornerRadius="3">
                    <Border Width="14" Height="5" Margin="3" CornerRadius="2" Background="{StaticResource SpotifyDialogBrush}"
                            HorizontalAlignment="{Binding Converter={x:Static opconv:OverlayPositionToHorizontalAlignmentConverter.Instance}}"
                            VerticalAlignment="{Binding Converter={x:Static opconv:OverlayPositionToVerticalAlignmentConverter.Instance}}" />
                  </Border>
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <Border Classes="settingsDivider" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsEnabled="{Binding SpotifyOverlayEnabled}">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="settingsRowTitle" Text="Write it into saved clips" />
            <TextBlock Classes="settingsRowDescSm" TextWrapping="Wrap" MaxWidth="400"
                       Text="Re-encodes each clip once after saving, so its thumbnail and the file itself carry the card. Costs a few seconds of encoder time per clip, and cannot be undone." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding SpotifyOverlayBurnIn}" OnContent="{x:Null}" OffContent="{x:Null}" VerticalAlignment="Center" />
        </Grid>

        <Border Classes="settingsDivider" />

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="settingsRowDescSm" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"
                     Text="A clip follows recorded Spotify playback. Placement and background changes apply to future exports. Cards already written into clips stay unchanged." />
          <Button Grid.Column="1" Classes="primaryButton" Content="Done" Click="CloseButton_OnClick" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
