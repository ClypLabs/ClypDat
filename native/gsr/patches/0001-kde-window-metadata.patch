+};
+static void global(void *data, struct wl_registry *registry, uint32_t name, const char *interface, uint32_t version) {
+    struct watcher *self = data;
+    if (strcmp(interface, "org_kde_plasma_window_management") == 0 && version >= 17 && !self->manager) {
+        self->global_name = name;
+        self->manager = wl_registry_bind(registry, name, &org_kde_plasma_window_management_interface, 17);
+        org_kde_plasma_window_management_add_listener(self->manager, &manager_listener, self);
+    }
+}
+static void global_remove(void *data, struct wl_registry *registry, uint32_t name) {
+    (void)registry;
+    struct watcher *self = data;
+    if (name == self->global_name) self->failed = true;
+}
+int clypdat_watch_windows(void) {
+    struct watcher self = {0};
+    struct wl_display *display = wl_display_connect(NULL);
+    if (!display) { fprintf(stderr, "ClypDat watcher: native Wayland unavailable.\n"); return 2; }
+    struct wl_registry *registry = wl_display_get_registry(display);
+    const struct wl_registry_listener listener = { global, global_remove };
+    wl_registry_add_listener(registry, &listener, &self);
+    if (wl_display_roundtrip(display) < 0 || !self.manager) {
+        fprintf(stderr, "ClypDat watcher: KDE window-management v17 unavailable; check desktop registration.\n");
+        self.failed = true;
+    }
+    while (!self.failed && wl_display_dispatch(display) >= 0) {}
+    while (self.windows) release_window(self.windows);
+    if (self.manager) org_kde_plasma_window_management_destroy(self.manager);
+    wl_registry_destroy(registry);
+    wl_display_disconnect(display);
+    return 2; /* Disconnection is source loss, never a successful empty list. */
+}
