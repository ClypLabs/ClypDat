diff --git a/src/clypdat_watcher.c b/src/clypdat_watcher.c
new file mode 100644
index 0000000..87643f0
--- /dev/null
+++ b/src/clypdat_watcher.c
@@ -0,0 +1,273 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * ClypDat metadata-only KDE watcher. Never acquires video or audio streams. */
+#include <wayland-client.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+#include "plasma-window-management-client-protocol.h"
+
+struct watcher;
+struct window {
+    struct watcher *owner;
+    struct window *next;
+    struct org_kde_plasma_window *proxy;
+    char *uuid, *title, *app_id;
+    uint32_t pid, flags, width, height;
+    int32_t x, y;
+    bool ready;
+};
+struct watcher {
+    struct org_kde_plasma_window_management *manager;
+    struct window *windows;
+    uint32_t global_name;
+    unsigned count;
+    bool failed;
+};
+static void json_string(const char *value) {
+    putchar('"');
+    for (const unsigned char *p = (const unsigned char *)(value ? value : ""); *p; ++p) {
+        if (*p == '"' || *p == '\\') { putchar('\\'); putchar(*p); }
+        else if (*p < 32) printf("\\u%04x", *p);
+        else putchar(*p);
+    }
+    putchar('"');
+}
+static bool watcher_silent;
+static void publish(struct window *w, const char *event) {
+    if (watcher_silent) return;
+    if (!w->ready) return;
+    printf("{\"version\":1,\"event\":"); json_string(event);
+    printf(",\"uuid\":"); json_string(w->uuid);
+    printf(",\"appId\":"); json_string(w->app_id);
+    printf(",\"title\":"); json_string(w->title);
+    printf(",\"pid\":%u,\"focused\":%s,\"minimized\":%s,\"x\":%d,\"y\":%d,\"width\":%u,\"height\":%u}\n",
+        w->pid, (w->flags & 1) ? "true" : "false", (w->flags & 2) ? "true" : "false",
+        w->x, w->y, w->width, w->height);
+    fflush(stdout);
+}
+static void release_window(struct window *w) {
+    struct window **link = &w->owner->windows;
+    while (*link && *link != w) link = &(*link)->next;
+    if (*link) *link = w->next;
+    w->owner->count--;
+    org_kde_plasma_window_destroy(w->proxy);
+    free(w->uuid); free(w->title); free(w->app_id); free(w);
+}
+static void replace_string(struct window *w, char **target, const char *value) {
+    char *copy = strdup(value);
+    if (!copy) { w->owner->failed = true; return; }
+    free(*target); *target = copy; publish(w, "changed");
+}
+static void window_title_changed(void *data, struct org_kde_plasma_window *proxy ,const char * title) {
+    (void)proxy;
+    struct window *w = data;
+    replace_string(w, &w->title, title);
