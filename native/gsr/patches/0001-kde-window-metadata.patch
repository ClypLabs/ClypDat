+static void manager_window_with_uuid(void *data, struct org_kde_plasma_window_management *proxy ,uint32_t id, const char * uuid) {
+    (void)proxy;
+    (void)id;
+    struct watcher *self = data;
+    for (struct window *w = self->windows; w; w = w->next)
+        if (strcmp(w->uuid, uuid) == 0) return;
+    if (self->count >= 4096) { self->failed = true; return; }
+    struct window *w = calloc(1, sizeof(*w));
+    if (!w) { self->failed = true; return; }
+    w->owner = self;
+    w->uuid = strdup(uuid);
+    if (!w->uuid) { free(w); self->failed = true; return; }
+    w->proxy = org_kde_plasma_window_management_get_window_by_uuid(self->manager, uuid);
+    if (!w->proxy) { free(w->uuid); free(w); self->failed = true; return; }
+    w->next = self->windows; self->windows = w; self->count++;
+    org_kde_plasma_window_add_listener(w->proxy, &window_listener, w);
+}
