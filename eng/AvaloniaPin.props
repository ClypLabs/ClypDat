<Project>
  <!-- Stable builds use the forked package set produced from this commit. Dev
       CI overrides only ClypDatAvaloniaPackageVersion on the command line. -->
  <PropertyGroup>
    <ClypDatAvaloniaStableCommit>b9120489b7cc36cbef9ad2a4971da7ace17b73db</ClypDatAvaloniaStableCommit>
    <ClypDatAvaloniaStablePackageVersion>12.2.1004</ClypDatAvaloniaStablePackageVersion>
    <ClypDatAvaloniaPackageVersion Condition="'$(ClypDatAvaloniaPackageVersion)' == ''">$(ClypDatAvaloniaStablePackageVersion)</ClypDatAvaloniaPackageVersion>
  </PropertyGroup>
</Project>
